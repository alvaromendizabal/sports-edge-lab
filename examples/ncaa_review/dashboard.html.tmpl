  <script type="application/json" id="progress-evidence">__PROGRESS_DEMO__</script>
  <script>
  'use strict';
  const data=JSON.parse(document.getElementById('evidence').textContent), $=id=>document.getElementById(id);
  const fmt=(v,n=4)=>v==null?'Unavailable':Number(v).toLocaleString('en-US',{minimumFractionDigits:n,maximumFractionDigits:n});
  const pct=v=>v==null?'Unavailable':fmt(v*100,2)+'%';
  const safe=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const objectiveMap={probability:{target:'win',metric:'LogLoss'},accuracy:{target:'win',metric:'Accuracy'},margin:{target:'margin',metric:'MAE'},total:{target:'total',metric:'MAE'}};
  const metricName={LogLoss:'Natural log loss',Brier:'Brier score',Accuracy:'Winner accuracy',MAE:'Mean absolute error',RMSE:'Root mean squared error',Bias:'Signed bias',DirectionAccuracy:'Margin direction',ECE10:'10-bin calibration error',ROC_AUC:'ROC AUC',N:'Games'};
  function drawReliability(model,metrics){
    const bins=metrics.calibration_bins, x=v=>48+v*300,y=v=>302-v*250;
    let svg='<svg class="chart" viewBox="0 0 390 350" role="img" aria-label="Observed home-win frequency versus mean predicted probability, by ten fixed probability bins"><title>Reliability diagram</title><desc>Dots are ten-bin aggregates. A diagonal indicates equality of predicted and observed probability. Dot size increases with support.</desc>';
    for(const v of [0,.25,.5,.75,1])svg+=`<line class="grid" x1="48" y1="${y(v)}" x2="348" y2="${y(v)}"/><text x="35" y="${y(v)+4}" text-anchor="end">${fmt(v,2)}</text>`;
    for(const v of [0,.5,1])svg+=`<text x="${x(v)}" y="323" text-anchor="middle">${fmt(v,1)}</text>`;
    svg+=`<path class="diagonal" d="M ${x(0)} ${y(0)} L ${x(1)} ${y(1)}"/><polyline class="observed" points="${bins.map(b=>x(b.mean_probability)+','+y(b.observed_rate)).join(' ')}"/>`;
    const maximum=Math.max(...bins.map(b=>b.N));
    for(const b of bins)svg+=`<circle cx="${x(b.mean_probability)}" cy="${y(b.observed_rate)}" r="${3+5*Math.sqrt(b.N/maximum)}"><title>${b.N} games; mean probability ${fmt(b.mean_probability,4)}; observed rate ${fmt(b.observed_rate,4)}</title></circle>`;
    svg+='<text x="198" y="345" text-anchor="middle">Mean predicted home-win probability</text><text x="48" y="30">Observed home-win frequency</text></svg>';
    $('chart').innerHTML=svg;$('chart-title').textContent='Reliability, in ten bins.';
    $('chart-subtitle').textContent=model.id+' · '+model.label;
    $('chart-legend').innerHTML='<span><i class="dot"></i>Observed bins · size reflects support</span><span><i class="dash"></i>Perfect agreement</span>';
    $('chart-note').textContent='ECE: '+fmt(metrics.ECE10,4)+' · calibration bias: '+fmt(metrics.CalibrationBias,4)+'. Binning can hide within-bin error; this is a diagnostic, not a significance test.';
  }
  function drawErrors(models,season){
    const maximum=Math.max(...models.flatMap(m=>[m.panels[season].MAE,m.panels[season].RMSE]))*1.15;
    const width=v=>v/maximum*260;let svg='<svg class="chart" viewBox="0 0 390 255" role="img" aria-label="Mean absolute error and root mean squared error in points for selected models"><title>Point-error comparison</title>';
    models.forEach((m,i)=>{const d=m.panels[season],base=50+i*87;svg+=`<text x="20" y="${base-12}" style="font-weight:700">${safe(m.id)}</text><rect x="20" y="${base}" width="${width(d.MAE)}" height="17" rx="3" fill="#136a55"/><text x="${30+width(d.MAE)}" y="${base+13}">${fmt(d.MAE,3)}</text><rect x="20" y="${base+25}" width="${width(d.RMSE)}" height="17" rx="3" fill="#8ca5b7"/><text x="${30+width(d.RMSE)}" y="${base+38}">${fmt(d.RMSE,3)}</text>`;});
    svg+='<text x="20" y="240">Absolute and squared-error penalties, in points</text></svg>';
    $('chart').innerHTML=svg;$('chart-title').textContent='Error in basketball points.';$('chart-subtitle').textContent='Identical game cohort; lower error is better.';
    $('chart-legend').innerHTML='<span><i class="dot"></i>MAE</span><span><i class="dot" style="background:#8ca5b7"></i>RMSE</span>';
    $('chart-note').textContent='MAE measures typical absolute miss; RMSE gives large misses more weight. Point forecasts do not supply a spread-cover or over/under probability.';
  }
  function render(){
    const objective=$('objective').value,season=$('season').value,config=objectiveMap[objective],models=data.models.filter(m=>m.target===config.target),selected=models.find(m=>m.selected_for.includes(config.metric)),m=selected.panels[season];
    $('selection-note').textContent=selected.id+' stays fixed across windows. Selection considered '+selected.same_cohort_candidates+' exact-cohort historical candidates.';
    const cards=config.target==='win'?[[config.metric,config.metric==='Accuracy'?pct(m.Accuracy):fmt(m.LogLoss),selected.label],[config.metric==='Accuracy'?'LogLoss':'Accuracy',config.metric==='Accuracy'?fmt(m.LogLoss):pct(m.Accuracy),'Same selection, same games'],['Brier',fmt(m.Brier),'Squared probability error'],['N',fmt(m.N,0),'Exact shared evaluation cohort']]:[['MAE',fmt(m.MAE,3),'Points · lower is better'],['RMSE',fmt(m.RMSE,3),'Points · large misses weigh more'],['Bias',fmt(m.Bias,3),'Predicted minus actual points'],['N',fmt(m.N,0),'Exact shared evaluation cohort']];
    $('metrics').innerHTML=cards.map(([key,value,note],i)=>`<article class="metric ${i===0?'primary':''}"><div class="metric-label">${metricName[key]}</div><div class="metric-value">${value}</div><div class="metric-note">${safe(note)}</div></article>`).join('');
    const columns=config.target==='win'?['LogLoss','Brier','Accuracy','ECE10','ROC_AUC']:['MAE','RMSE','Bias',...(config.target==='margin'?['DirectionAccuracy']:[])];
    $('model-table').querySelector('thead').innerHTML='<tr><th scope="col">Public selection</th>'+columns.map(k=>'<th scope="col">'+(k==='DirectionAccuracy'?'Direction accuracy':k==='ECE10'?'ECE':k==='ROC_AUC'?'ROC AUC':k)+'</th>').join('')+'</tr>';
    $('model-table').querySelector('tbody').innerHTML=models.map(model=>'<tr class="'+(model.id===selected.id?'active':'')+'"><td><span class="table-id">'+model.id+'</span><span class="model-label">'+safe(model.selected_for.join(' + '))+'</span></td>'+columns.map(k=>'<td>'+(k.includes('Accuracy')?pct(model.panels[season][k]):fmt(model.panels[season][k],config.target==='win'?4:3))+'</td>').join('')+'</tr>').join('');
    $('table-caption').textContent=(season==='pooled'?'2024–25 and 2025–26':data.historical_seasons[season])+' · '+fmt(m.N,0)+' games for every row in this table';
    $('table-note').textContent=config.target==='win'?'Accuracy awards half credit to probability ties; tied predictions make no directional pick. The higher-accuracy selection need not assign better probabilities.':config.target==='total'?'Over/under accuracy is unavailable without comparable lines. No spread or total betting return is inferred from these point forecasts.':'Direction accuracy uses the sign of the predicted home-minus-away margin; a zero prediction receives half credit.';
    if(config.target==='win')drawReliability(selected,m);else drawErrors(models,season);
    const t=data.objective_tradeoff,loss=t.metrics.LogLoss,acc=t.metrics.Accuracy;
    $('tradeoff-values').innerHTML=`<div><span class="subtle">${t.left} minus ${t.right} · both historical seasons</span><div class="delta">${fmt(loss.difference,4)} <span class="subtle">log loss</span></div><div class="interval">95% descriptive interval [${fmt(loss.lower,4)}, ${fmt(loss.upper,4)}]</div></div><p style="margin:14px 0 0">Accuracy difference: ${fmt(acc.difference*100,2)} percentage points · interval [${fmt(acc.lower*100,2)}, ${fmt(acc.upper*100,2)}]. This interval crosses zero. Ranking by accuracy alone does not establish a stable advantage.</p>`;
  }
  function scenario(name){const labels={valid:['15:00','15:55','Full game + overtime',true,'Eligible synthetic comparison','Identity, information clocks and settlement are compatible. Economic decisions still need their own price and fee evidence.'],late_quote:['15:00','16:01','Full game + overtime',false,'Excluded: quote after cutoff','A newly observed quote cannot be moved backward to improve an earlier comparison.'],boundary_label:['16:00','15:55','Full game + overtime',false,'Excluded: label at the boundary','Training labels must be released strictly before the decision cutoff. An equal timestamp is not earlier.'],settlement:['15:00','15:55','Regulation only',false,'Excluded: incompatible settlement','A regulation-only reference cannot be compared with a full-game model that includes overtime.']};return labels[name];}
  function renderScenario(name){const [label,quote,settlement,pass,title,note]=scenario(name);$('demo-label').textContent=label+' UTC';$('demo-quote').textContent=quote+' UTC';$('demo-settlement').textContent=settlement;$('demo-output').className='demo-output'+(pass?'':' blocked');$('demo-output').innerHTML='<strong>'+title+'</strong>'+note;document.querySelectorAll('[data-scenario]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.scenario===name)));}
  document.querySelectorAll('[data-scenario]').forEach(b=>b.addEventListener('click',()=>renderScenario(b.dataset.scenario)));
  $('objective').addEventListener('change',render);$('season').addEventListener('change',render);
  $('provider-table').innerHTML=data.providers.map(p=>`<tr><td><strong>${safe(p.name)}</strong></td><td class="provider-product" style="white-space:normal">${p.name==='Polymarket'?'International; US unacquired':'Winner · spread · total observations'}</td><td style="white-space:normal">${safe(p.display_coverage)}</td><td style="white-space:normal">${safe(p.eligible_comparison_coverage.replaceAll('_',' '))}</td></tr>`).join('');
  const reconstructed=data.current_reconstructed_comparison;
  if(reconstructed.status==='RETROSPECTIVE_PAIRED_ORIGINAL_VERSUS_POLYMARKET'){
    $('current-paired-note').textContent=reconstructed.paired_games+' identical supplied games · T−60 reference · '+reconstructed.evidence_mode;
    $('current-paired-table').innerHTML='<table><caption>Same games and definitions; model selected before this current-season comparison.</caption><thead><tr><th>Metric</th><th>Frozen original</th><th>Polymarket international</th></tr></thead><tbody>'+[['accuracy','Winner accuracy'],['log_loss','Log loss'],['brier','Brier'],['auc','AUC'],['calibration_bias','Calibration bias']].map(([key,label])=>'<tr><td>'+label+'</td><td>'+(key==='accuracy'?pct(reconstructed.model_metrics[key]):fmt(reconstructed.model_metrics[key]))+'</td><td>'+(key==='accuracy'?pct(reconstructed.provider_metrics[key]):fmt(reconstructed.provider_metrics[key]))+'</td></tr>').join('')+'</tbody></table>';
    $('current-paired-disagreements').textContent=reconstructed.model_right_provider_wrong+' model-right / provider-wrong disagreements; '+reconstructed.provider_right_model_wrong+' in the reverse direction. The model picked more winners; the provider had lower log loss and Brier. '+reconstructed.uncertainty_note+' Qualified settled bets: 0. Profit remains unverified.';
  }else{
    $('current-paired-note').textContent='No exact paired current provider cohort was supplied for this league. Missing comparisons remain unavailable.';
    $('current-paired-disagreements').textContent='Reconstructed model outputs remain in the private report. No earlier issue, market advantage or profit is inferred.';
  }
  const duration=seconds=>seconds===null?'Not started':seconds<60?fmt(seconds,1)+' s':seconds<3600?fmt(seconds/60,1)+' min':fmt(seconds/3600,2)+' h';
  const pacific=stamp=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Los_Angeles',year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'}).format(new Date(stamp));
  const attempt=data.current_owner_attempt,inventory=data.observed_inventory,prior=data.owner_attempt_history.find(a=>a.release==='B033');
  $('attempt-summary').textContent=attempt.synthetic_tests_passed+' passed · 0 errors · 1 skipped · '+attempt.completed_scientific_stages+' of '+attempt.planned_scientific_stages+' workflow stages completed. '+attempt.new_real_target_fits+' new target fits; '+attempt.reused_target_fits+' historical targets reused.';
  $('execution-intro').textContent=attempt.release+' returned '+pacific(attempt.completed_at)+'. It completed model work and all five weekly CSV exports, then failed while publishing the dense dashboard HTML. Saved models and source observations remain intact. Scientific coverage remains incomplete.';
  $('run-metrics').innerHTML=[['Fixture cases',attempt.synthetic_tests_passed+' / '+attempt.synthetic_tests_total,'Passed / inventoried; 0 errors and 1 skipped'],['Admission',duration(attempt.phase_seconds.admission),attempt.admission.workers_planned+' workers planned from measured capacity'],['Workflow stages',attempt.completed_scientific_stages+' / '+attempt.planned_scientific_stages,'Reporting failed; archive stage not reached'],['New target fits',String(attempt.league_new_real_target_fits),'This track; '+attempt.new_real_target_fits+' across both, plus '+attempt.new_calibration_fits+' scalar / '+attempt.new_empirical_residual_fits+' empirical fits']].map(([name,value,note],i)=>`<article class="run-stat ${i===0?'primary':''}"><span>${name}</span><strong>${value}</strong><small>${note}</small></article>`).join('');
  const phaseColors={admission:'#b78345',fixtures:'#8ca5b7',science:'#136a55'},phaseLabels={admission:'Admission',fixtures:'Fixtures',science:'Science'};
  const measuredPhases=Object.entries(attempt.phase_seconds).filter(([,seconds])=>seconds!==null);
  $('time-bar').innerHTML=measuredPhases.map(([key,seconds])=>`<span style="width:${seconds/attempt.total_wall_seconds*100}%;background:${phaseColors[key]}"></span>`).join('');
  $('time-bar').setAttribute('aria-label',measuredPhases.map(([key,seconds])=>phaseLabels[key]+' '+duration(seconds)).join('; '));
  $('time-legend').innerHTML=measuredPhases.map(([key,seconds])=>`<span><i style="background:${phaseColors[key]}"></i>${phaseLabels[key]} ${duration(seconds)}</span>`).join('');
  $('resource-note').textContent='Owner wall before return construction: '+duration(attempt.total_wall_seconds)+'. Owner CPU: '+duration(attempt.cpu_seconds)+'. Owner peak RSS: '+fmt(attempt.owner_peak_rss_bytes/2**30,2)+' GiB; simultaneous process-tree peak was not measured. Admission observed '+attempt.admission.workers_planned+' fit workers and '+attempt.admission.acquisition_workers_planned+' acquisition lanes; later capacity is remeasured. Finalization through full return readback added '+duration(attempt.return_finalization_seconds)+'. No current billing rate was verified.';
  $('stage-caption').textContent=attempt.completed_scientific_stages+' / '+attempt.planned_scientific_stages+' stages completed. The reporting failure and pending archive stage remain explicit.';
  const phaseRows=stages=>stages.map(s=>`<tr><td>${safe(s.label)}</td><td><span class="phase-status ${s.status==='COMPLETED'?'done':s.status==='FAILED'?'failed':''}">${s.status==='COMPLETED'?'Completed':s.status==='FAILED'?'Failed':'Not started'}</span></td><td>${duration(s.seconds)}</td></tr>`).join('');
  $('phase-table').innerHTML=phaseRows(attempt.stages);
  $('history-phase-table').innerHTML=phaseRows(prior.stages);
  $('preserved-study-copy').textContent=prior.new_real_target_fits+' committed target fits across both leagues; '+prior.league_new_real_target_fits+' in this track. Three prior scientific stages completed before a source-selection failure. These valid historical results remain preserved. B036 verified and reused all 108 without claiming new fit credit. Historical scorecards below retain their existing accepted selections.';
  $('inventory-age').textContent='Current source inventory observed '+pacific(inventory.snapshot_at);
  $('coverage-counts').innerHTML=[['Candidate game records',fmt(inventory.candidate_games,0)],['Observed finals',fmt(inventory.observed_finals,0)],['Official season coverage','Unverified']].map(([name,value])=>`<div><span>${name}</span><strong>${value}</strong></div>`).join('');
  $('week-counts').textContent='Reporting weeks use '+inventory.reporting_week_timezone+'; tipoffs display Pacific. Last week (Oct 26–Nov 1): '+inventory.last_week.candidate_games+' candidates, '+inventory.last_week.observed_finals+' finals. This week (Nov 2–8): '+inventory.this_week.candidate_games+' candidates, '+inventory.this_week.observed_finals+' finals. Next week (Nov 9–15): '+inventory.next_week.candidate_games+' candidates. '+inventory.unmatched_official_candidates+' unmatched official candidates remain visible. Zero authenticated current issues.';
  const progressExamples=JSON.parse($('progress-evidence').textContent);
  $('progress-buttons').innerHTML=progressExamples.map(s=>`<button type="button" data-progress="${s.id}" aria-pressed="false">${safe(s.label)}</button>`).join('');
  const etaLabels={WARMUP:'Collecting pace evidence',UNKNOWN_TOTAL:'Unknown — total not established',WORKER_CHANGE_WARMUP:'Unknown — workers changed',STALE_PACE:'Unknown — recent pace stalled',STOPPED_WITH_UNFINISHED_WORK:'Stopped — unfinished work retained',AWAITING_PHASE_FINALIZATION:'Awaiting phase finalization',COMPLETED:'Complete'};
  function renderProgress(id){
    const s=progressExamples.find(x=>x.id===id),p=s.progress;
    $('progress-count').textContent=p.completed+' / '+(p.total===null?'unknown':p.total);
    $('progress-components').textContent=p.newly_committed+' newly committed · '+p.reused+' reused · '+p.failed_attempts+' failed attempts';
    $('progress-track').classList.toggle('unknown',p.fraction===null);$('progress-fill').style.width=p.fraction===null?'0':(p.fraction*100)+'%';
    if(p.fraction===null){$('progress-track').removeAttribute('aria-valuenow');$('progress-track').removeAttribute('aria-valuemax');$('progress-track').removeAttribute('aria-valuemin');$('progress-track').setAttribute('aria-valuetext',p.completed+' completed; total unknown');}
    else{$('progress-track').setAttribute('aria-valuemin','0');$('progress-track').setAttribute('aria-valuemax',String(p.total));$('progress-track').setAttribute('aria-valuenow',String(p.completed));$('progress-track').setAttribute('aria-valuetext',p.completed+' of '+p.total+' completed');}
    $('progress-eta').textContent=p.eta_status==='EMPIRICAL_PHASE_ESTIMATE'?duration(p.eta_seconds):etaLabels[p.eta_status];
    $('progress-range').textContent=p.eta_status==='EMPIRICAL_PHASE_ESTIMATE'?'Observed pace range '+duration(p.observed_pace_low_seconds)+'–'+duration(p.observed_pace_high_seconds)+'; '+p.sample_intervals+' measured intervals.':'No inferred finish time.';
    if(p.eta_status==='COMPLETED')$('progress-range').textContent='All declared units and phase finalization are complete.';
    $('progress-clocks').textContent='Phase elapsed '+duration(p.phase_elapsed_seconds)+' · total elapsed '+duration(p.wall_elapsed_seconds)+' · '+p.workers+' workers';
    $('progress-explanation').textContent=s.explanation;
    document.querySelectorAll('[data-progress]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.progress===id)));
  }
  document.querySelectorAll('[data-progress]').forEach(b=>b.addEventListener('click',()=>renderProgress(b.dataset.progress)));
  renderProgress('measured');
  const preflightExamples=JSON.parse($('preflight-evidence').textContent);
  $('preflight-buttons').innerHTML=preflightExamples.map(s=>`<button type="button" data-preflight="${s.id}" aria-pressed="false">${safe(s.label)}</button>`).join('');
  function renderPreflight(id){const s=preflightExamples.find(x=>x.id===id),r=s.result;
    $('preflight-output').className='demo-output'+(r.gate_passed?'':' blocked');
    $('preflight-output').innerHTML='<strong>'+ (r.gate_passed?'Ready: required validation passed':'Blocked: validation requirements not met')+'</strong>'+r.completed+' / '+r.total+' cases accounted for; '+r.executed+' executed. Terminal state: '+r.status+'.';
    $('preflight-counts').innerHTML=Object.entries(r.counts).map(([key,value])=>`<div><span>${safe(key.toLowerCase())}</span><strong>${value}</strong></div>`).join('');
    $('preflight-explanation').textContent=s.explanation;
    document.querySelectorAll('[data-preflight]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.preflight===id)));}
  document.querySelectorAll('[data-preflight]').forEach(b=>b.addEventListener('click',()=>renderPreflight(b.dataset.preflight)));
  renderPreflight('optional_absent');
  $('history-hash').textContent=data.provenance.historical_accepted_owner_return_sha256;$('failed-hash').textContent=data.provenance.failed_owner_return_sha256;
  render();renderScenario('valid');
  </script>
</body>
</html>

