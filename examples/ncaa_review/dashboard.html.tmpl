 .2s}.progress-track.unknown{border:1px dashed #8ba294;background:transparent}.progress-subline{font-size:12px;color:var(--muted)}.progress-key{display:block;color:var(--muted);font-size:11px;letter-spacing:.04em;text-transform:uppercase;margin-bottom:6px}.progress-eta{font-size:23px;font-weight:650;line-height:1.25;letter-spacing:-.02em}.progress-range{font-size:12px;color:var(--muted);margin-top:7px}.progress-note{font-size:13px;color:var(--muted);margin-top:17px!important}.progress-buttons button{min-height:38px}.coverage-copy{font-size:13px;line-height:1.7;color:var(--muted)}.coverage-copy strong{color:var(--ink)}@media(max-width:900px){.execution-grid{grid-template-columns:1fr}.run-stat{padding:16px}.run-stat strong{font-size:27px}}@media(max-width:570px){.run-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.run-stat strong{font-size:27px}.coverage-grid{grid-template-columns:1fr 1fr}.progress-demo-grid{grid-template-columns:1fr}.time-legend{gap:10px;font-size:11px}.phase-table{font-size:11px}.phase-table th,.phase-table td{padding:9px 6px}}@media(prefers-reduced-motion:reduce){.progress-track>span{transition:none}}
