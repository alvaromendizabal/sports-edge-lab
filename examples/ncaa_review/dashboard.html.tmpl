  $('recent-study-copy').textContent=scientific.release+' completed '+scientific.completed_scientific_stages+' of '+scientific.planned_scientific_stages+' stages and committed '+scientific.new_real_target_fits+' target / '+scientific.new_calibration_fits+' scalar / '+scientific.new_empirical_residual_fits+' empirical fits before its injury-checkpoint failure. Its baseline reports and 339 unchanged B042 issue rows remain dated evidence; B044 receives no credit for them.';
  const handoff=JSON.parse($('handoff-evidence').textContent);
  $('handoff-table').innerHTML=[['Independent component checks',handoff.component_checks_passed+' passed'],['Actual incompatible handoff','Blocked before work'],['Actions before admission',String(handoff.actions_before_admission)],['Reviewed exact registration',handoff.reviewed_exact_registration],['Real model fit credit',String(handoff.new_model_fit_credit)]].map(([label,value])=>'<tr><td>'+safe(label)+'</td><td>'+safe(value)+'</td></tr>').join('');
  $('injury-copy').textContent=injury.coverage;
  $('injury-clocks').textContent=injury.clock_coverage;
  $('injury-policy').textContent=injury.clock_policy+' '+injury.promotion;
  $('frontier-copy').textContent=data.frontier_research.scope;
  $('frontier-limit').textContent=data.frontier_research.evidence_limit;
  $('original-copy').textContent=fmt(result.original_frozen_games,0)+' games / '+fmt(result.prediction_rows.original_frozen,0)+' target rows were reconstructed with unchanged original weights. Their computation times remain visible and receive no earlier issue credit.';
  $('current-model-copy').textContent=fmt(result.prediction_rows.current_monitor,0)+' current-monitor and '+fmt(result.prediction_rows.native_replay,0)+' native-replay target rows span separate frozen and rolling research streams. Training uses labels released before each origin; current outcomes did not select the model. Durable pre-study scorecards are available; the final post-study report remains unfinished.';
  $('durable-report-copy').textContent=fmt(result.pre_study_target_rows,0)+' target rows and '+fmt(result.browser_display_rows,0)+' browser rows were preserved before injury research. Independent arithmetic checked '+fmt(result.independent_metric_panels_checked,0)+' model metric panels with '+result.independent_metric_mismatches+' mismatches. The report includes 339 inherited issues; none has an admitted settled outcome at its cutoff. Recovery creates no fit or issue credit.';
  $('issue-recovery-copy').textContent=fmt(result.authenticated_issue_rows_this_league,0)+' existing B042 issue rows across '+result.authenticated_issue_games_this_league+' games in this track; '+fmt(result.authenticated_issue_rows_both_leagues,0)+' rows across '+result.authenticated_issue_games_both_leagues+' games across both leagues. '+result.qualification;
  const gaps=data.current_coverage_gaps;
  $('official-counts').textContent='Across both leagues: '+fmt(gaps.official_accepted_contests,0)+' accepted official contest records, '+fmt(gaps.official_exact_matches,0)+' exact matches, '+fmt(gaps.unmatched_official_candidates,0)+' unmatched official candidates, '+gaps.official_conflicts+' conflicts and '+gaps.rejected_official_records+' rejected records/date failures. ESPN separately supplies '+fmt(gaps.calendar_source_versions,0)+' game versions and '+gaps.espn_source_finals+' source finals. Completed status alone is insufficient: one official candidate has no numeric final scores. Complete official coverage remains unverified.';
  $('freshness-table').innerHTML=[['Source acquisition completed',pacific(freshness.source_acquisition_completed_at)],['Latest retained observation acquired',pacific(freshness.retained_observation_acquisition_range_utc.maximum_utc)],['Latest retained quote time',pacific(freshness.retained_quote_time_range_utc.maximum_utc)],['Model input / inference as-of',pacific(freshness.model_input_asof)],['Pre-study report as-of',pacific(freshness.pre_study_report_asof)],['Research owner stopped ('+freshness.owner_release+')',pacific(freshness.owner_completed_at)],['Latest owner stopped ('+attempt.release+')',pacific(attempt.completed_at)],['Public review date',data.published_snapshot_date+' UTC']].map(([label,value])=>'<tr><td>'+safe(label)+'</td><td>'+safe(value)+'</td></tr>').join('');
  $('freshness-note').textContent=freshness.clock_note;
  $('attempt-summary').textContent=attempt.synthetic_tests_passed+' passed · '+attempt.synthetic_test_errors+' errors · '+attempt.synthetic_tests_skipped+' skipped · '+attempt.completed_scientific_stages+' of '+attempt.planned_scientific_stages+' workflow stages completed. '+attempt.new_real_target_fits+' new target fits; '+attempt.reused_target_fits+' historical targets reused in this attempt.';
  $('execution-intro').textContent=attempt.release+' returned '+pacific(attempt.completed_at)+'. '+attempt.outcome_summary;
  $('run-metrics').innerHTML=[['Fixture cases',attempt.synthetic_tests_passed+' / '+attempt.synthetic_tests_total,'Passed / inventoried; '+attempt.synthetic_test_errors+' errors and '+attempt.synthetic_tests_skipped+' skipped'],['Admission',duration(attempt.phase_seconds.admission),attempt.admission.workers_planned+' workers planned from measured capacity'],['Workflow stages',attempt.completed_scientific_stages+' / '+attempt.planned_scientific_stages,attempt.stage_progress_note],['New target fits',String(attempt.league_new_real_target_fits),'This track; '+attempt.new_real_target_fits+' across both, plus '+attempt.new_calibration_fits+' scalar / '+attempt.new_empirical_residual_fits+' empirical fits']].map(([name,value,note],i)=>`<article class="run-stat ${i===0?'primary':''}"><span>${name}</span><strong>${value}</strong><small>${note}</small></article>`).join('');
  const phaseColors={admission:'#b78345',fixtures:'#8ca5b7',setup:'#84659c',science:'#136a55',other:'#a6aaa3'},phaseLabels={admission:'Admission',fixtures:'Fixtures',setup:'Predecessor setup',science:'Scientific stages',other:'Other owner overhead'};
  const measuredPhases=Object.entries(attempt.phase_seconds).filter(([,seconds])=>seconds!==null);
  $('time-bar').innerHTML=measuredPhases.map(([key,seconds])=>`<span style="width:${seconds/attempt.total_wall_seconds*100}%;background:${phaseColors[key]}"></span>`).join('');
  $('time-bar').setAttribute('aria-label',measuredPhases.map(([key,seconds])=>phaseLabels[key]+' '+duration(seconds)).join('; '));
  $('time-legend').innerHTML=measuredPhases.map(([key,seconds])=>`<span><i style="background:${phaseColors[key]}"></i>${phaseLabels[key]} ${duration(seconds)}</span>`).join('');
  $('resource-note').textContent='Owner wall before return construction: '+duration(attempt.total_wall_seconds)+'. Owner CPU: '+duration(attempt.cpu_seconds)+'. Owner peak RSS: '+fmt(attempt.owner_peak_rss_bytes/2**30,2)+' GiB; simultaneous process-tree peak was not measured. Admission observed '+attempt.admission.workers_planned+' fit workers and '+attempt.admission.acquisition_workers_planned+' acquisition lanes; later capacity is remeasured. Return delivery was independently verified; finalization time is not separately reported here. '+attempt.phase_scope_note+' No current billing rate was verified.';
  $('stage-caption').textContent=attempt.completed_scientific_stages+' / '+attempt.planned_scientific_stages+' stages completed. '+attempt.remaining_phases;
  const phaseRows=stages=>stages.map(s=>`<tr><td>${safe(s.label)}</td><td><span class="phase-status ${s.status==='COMPLETED'?'done':s.status==='FAILED'?'failed':''}">${s.status==='COMPLETED'?'Completed':s.status==='FAILED'?'Failed':'Not started'}</span></td><td>${duration(s.seconds)}</td></tr>`).join('');
  $('phase-table').innerHTML=phaseRows(attempt.stages);
  $('recent-phase-table').innerHTML=phaseRows(scientific.stages);
  $('history-phase-table').innerHTML=phaseRows(prior.stages);
  $('preserved-study-copy').textContent=prior.new_real_target_fits+' committed target fits across both leagues; '+prior.league_new_real_target_fits+' in this track. Three prior scientific stages completed before a source-selection failure. These valid historical results remain preserved. B036 verified and reused all 108 without claiming new fit credit. Historical scorecards below retain their existing accepted selections.';
  $('inventory-age').textContent='Retained '+data.coverage_evidence_release+' source acquisition completed '+pacific(inventory.snapshot_at);
  $('coverage-counts').innerHTML=[['Candidate game records',fmt(inventory.candidate_games,0)],['Observed finals',fmt(inventory.observed_finals,0)],['Official season coverage','Unverified']].map(([name,value])=>`<div><span>${name}</span><strong>${value}</strong></div>`).join('');
  $('week-counts').textContent='Reporting weeks use '+inventory.reporting_week_timezone+'; tipoffs display Pacific. Last week (Oct 26–Nov 1): '+inventory.last_week.candidate_games+' candidates, '+inventory.last_week.observed_finals+' finals. This week (Nov 2–8): '+inventory.this_week.candidate_games+' candidates, '+inventory.this_week.observed_finals+' finals. Next week (Nov 9–15): '+inventory.next_week.candidate_games+' candidates. '+inventory.unmatched_official_candidates+' unmatched official candidates remain visible. '+inventory.authenticated_current_issues+' authenticated B042 issue rows across '+inventory.authenticated_current_issue_games+' games in this track; recovery created zero new issues.';
  const progressExamples=JSON.parse($('progress-evidence').textContent);
  $('progress-buttons').innerHTML=progressExamples.map(s=>`<button type="button" data-progress="${s.id}" aria-pressed="false">${safe(s.label)}</button>`).join('');
  const etaLabels={WARMUP:'Collecting pace evidence',UNKNOWN_TOTAL:'Unknown — total not established',WORKER_CHANGE_WARMUP:'Unknown — workers changed',STALE_PACE:'Unknown — recent pace stalled',STOPPED_WITH_UNFINISHED_WORK:'Stopped — unfinished work retained',AWAITING_PHASE_FINALIZATION:'Awaiting phase finalization',COMPLETED:'Complete'};
  function renderProgress(id){
    const s=progressExamples.find(x=>x.id===id),p=s.progress;
    $('progress-count').textContent=p.completed+' / '+(p.total===null?'unknown':p.total);
    $('progress-components').textContent=p.newly_committed+' newly committed · '+p.reused+' reused · '+p.failed_attempts+' failed attempts';
    $('progress-track').classList.toggle('unknown',p.fraction===null);$('progress-fill').style.width=p.fraction===null?'0':(p.fraction*100)+'%';
    if(p.fraction===null){$('progress-track').removeAttribute('aria-valuenow');$('progress-track').removeAttribute('aria-valuemax');$('progress-track').removeAttribute('aria-valuemin');$('progress-track').setAttribute('aria-valuetext',p.completed+' completed; total unknown');}
    else{$('progress-track').setAttribute('aria-valuemin','0');$('progress-track').setAttribute('aria-valuemax',String(p.total));$('progress-track').setAttribute('aria-valuenow',String(p.completed));$('progress-track').setAttribute('aria-valuetext',p.completed+' of '+p.total+' completed');}
    $('progress-eta').textContent=p.eta_status==='EMPIRICAL_PHASE_ESTIMATE'?duration(p.eta_seconds):etaLabels[p.eta_status];
    $('progress-range').textContent=p.eta_status==='EMPIRICAL_PHASE_ESTIMATE'?'Observed pace range '+duration(p.observed_pace_low_seconds)+'–'+duration(p.observed_pace_high_seconds)+'; '+p.sample_intervals+' measured intervals.':'No inferred finish time.';
    if(p.eta_status==='COMPLETED')$('progress-range').textContent='All declared units and phase finalization are complete.';
    $('progress-clocks').textContent='Phase elapsed '+duration(p.phase_elapsed_seconds)+' · total elapsed '+duration(p.wall_elapsed_seconds)+' · '+p.workers+' workers';
    $('progress-explanation').textContent=s.explanation;
    document.querySelectorAll('[data-progress]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.progress===id)));
  }
  document.querySelectorAll('[data-progress]').forEach(b=>b.addEventListener('click',()=>renderProgress(b.dataset.progress)));
  renderProgress('measured');
  const preflightExamples=JSON.parse($('preflight-evidence').textContent);
  $('preflight-buttons').innerHTML=preflightExamples.map(s=>`<button type="button" data-preflight="${s.id}" aria-pressed="false">${safe(s.label)}</button>`).join('');
  function renderPreflight(id){const s=preflightExamples.find(x=>x.id===id),r=s.result;
    $('preflight-output').className='demo-output'+(r.gate_passed?'':' blocked');
    $('preflight-output').innerHTML='<strong>'+ (r.gate_passed?'Ready: required validation passed':'Blocked: validation requirements not met')+'</strong>'+r.completed+' / '+r.total+' cases accounted for; '+r.executed+' executed. Terminal state: '+r.status+'.';
    $('preflight-counts').innerHTML=Object.entries(r.counts).map(([key,value])=>`<div><span>${safe(key.toLowerCase())}</span><strong>${value}</strong></div>`).join('');
    $('preflight-explanation').textContent=s.explanation;
    document.querySelectorAll('[data-preflight]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.preflight===id)));}
  document.querySelectorAll('[data-preflight]').forEach(b=>b.addEventListener('click',()=>renderPreflight(b.dataset.preflight)));
  renderPreflight('optional_absent');
  $('history-hash').textContent=data.provenance.historical_accepted_owner_return_sha256;$('failed-hash').textContent=data.provenance.failed_owner_return_sha256;
  render();renderScenario('valid');
  </script>
</body>
