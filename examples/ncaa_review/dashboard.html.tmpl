    for(const v of [0,.5,1])svg+=`<text x="${x(v)}" y="323" text-anchor="middle">${fmt(v,1)}</text>`;
    svg+=`<path class="diagonal" d="M ${x(0)} ${y(0)} L ${x(1)} ${y(1)}"/><polyline class="observed" points="${bins.map(b=>x(b.mean_probability)+','+y(b.observed_rate)).join(' ')}"/>`;
