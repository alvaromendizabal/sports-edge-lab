    $('progress-components').textContent=p.newly_committed+' newly committed · '+p.reused+' reused · '+p.failed_attempts+' failed attempts';
    $('progress-track').classList.toggle('unknown',p.fraction===null);$('progress-fill').style.width=p.fraction===null?'0':(p.fraction*100)+'%';
    if(p.fraction===null){$('progress-track').removeAttribute('aria-valuenow');$('progress-track').removeAttribute('aria-valuemax');$('progress-track').removeAttribute('aria-valuemin');$('progress-track').setAttribute('aria-valuetext',p.completed+' completed; total unknown');}
    else{$('progress-track').setAttribute('aria-valuemin','0');$('progress-track').setAttribute('aria-valuemax',String(p.total));$('progress-track').setAttribute('aria-valuenow',String(p.completed));$('progress-track').setAttribute('aria-valuetext',p.completed+' of '+p.total+' completed');}
    $('progress-eta').textContent=p.eta_status==='EMPIRICAL_PHASE_ESTIMATE'?duration(p.eta_seconds):etaLabels[p.eta_status];
    $('progress-range').textContent=p.eta_status==='EMPIRICAL_PHASE_ESTIMATE'?'Observed pace range '+duration(p.observed_pace_low_seconds)+'–'+duration(p.observed_pace_high_seconds)+'; '+p.sample_intervals+' measured intervals.':'No inferred finish time.';
    if(p.eta_status==='COMPLETED')$('progress-range').textContent='All declared units and phase finalization are complete.';
    $('progress-clocks').textContent='Phase elapsed '+duration(p.phase_elapsed_seconds)+' · total elapsed '+duration(p.wall_elapsed_seconds)+' · '+p.workers+' workers';
    $('progress-explanation').textContent=s.explanation;
    document.querySelectorAll('[data-progress]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.progress===id)));
  }
  document.querySelectorAll('[data-progress]').forEach(b=>b.addEventListener('click',()=>renderProgress(b.dataset.progress)));
  renderProgress('measured');
  const preflightExamples=JSON.parse($('preflight-evidence').textContent);
  $('preflight-buttons').innerHTML=preflightExamples.map(s=>`<button type="button" data-preflight="${s.id}" aria-pressed="false">${safe(s.label)}</button>`).join('');
  function renderPreflight(id){const s=preflightExamples.find(x=>x.id===id),r=s.result;
    $('preflight-output').className='demo-output'+(r.gate_passed?'':' blocked');
    $('preflight-output').innerHTML='<strong>'+ (r.gate_passed?'Ready: required validation passed':'Blocked: validation requirements not met')+'</strong>'+r.completed+' / '+r.total+' cases accounted for; '+r.executed+' executed. Terminal state: '+r.status+'.';
    $('preflight-counts').innerHTML=Object.entries(r.counts).map(([key,value])=>`<div><span>${safe(key.toLowerCase())}</span><strong>${value}</strong></div>`).join('');
    $('preflight-explanation').textContent=s.explanation;
    document.querySelectorAll('[data-preflight]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.preflight===id)));}
  document.querySelectorAll('[data-preflight]').forEach(b=>b.addEventListener('click',()=>renderPreflight(b.dataset.preflight)));
  renderPreflight('optional_absent');
  $('history-hash').textContent=data.provenance.historical_accepted_owner_return_sha256;$('failed-hash').textContent=data.provenance.failed_owner_return_sha256;
  render();renderScenario('valid');
  </script>
</body>
</html>

