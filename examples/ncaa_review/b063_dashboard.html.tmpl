<script id="b063-data" type="application/json">__B063_DATA__</script>
<script>
(function () {
"use strict";
const columns = ["league","event_id","event_time","home_team","away_team","completed","actual_home_points","actual_away_points","source_binding_status","forecast_status","original_replay_prediction_status","selected_original_home_win_probability","selected_original_margin","selected_original_total","selected_issued_home_win_probability","selected_issued_margin","selected_issued_total","time_precision","tipoff_pacific","provider_comparison_status"];
const esc = v => String(v == null ? "" : v).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const leagueName = l => l === "ncaam" ? "Men" : "Women";
const number = (v, digits=4) => v == null || !Number.isFinite(Number(v)) ? "—" : Number(v).toFixed(digits);
const probability = v => v == null ? "—" : (100*Number(v)).toFixed(1)+"%";
const instant = v => v ? Date.parse(v) : NaN;
const when = v => !v || !Number.isFinite(instant(v)) ? "Time unknown" : new Intl.DateTimeFormat("en-US",{timeZone:"America/Los_Angeles",month:"short",day:"numeric",hour:"numeric",minute:"2-digit",timeZoneName:"short"}).format(new Date(v));
const decode = row => Object.fromEntries(columns.map((k,i)=>[k,row[i]]));
function selected(g, mode) { return mode === "issued" ? [g.selected_issued_home_win_probability,g.selected_issued_margin,g.selected_issued_total] : [g.selected_original_home_win_probability,g.selected_original_margin,g.selected_original_total]; }
function filterGames(d, q={}) {
  if (q.season && !["all","2027"].includes(q.season)) return [];
  const needle=String(q.query||"").trim().toLowerCase();
  return d.games.map(decode).filter(g => {
    if(q.league && q.league!=="all" && g.league!==q.league) return false;
    if(needle && ![g.event_id,g.home_team,g.away_team].join(" ").toLowerCase().includes(needle)) return false;
    if(q.status==="completed" && !g.completed) return false;
    if(q.status==="future" && (g.completed || !(instant(g.event_time)>instant(d.census_asof_utc)))) return false;
    if(q.status==="unresolved" && g.source_binding_status==="OBSERVED_SOURCE_GAME_WITHOUT_BOUND_MODEL_ROW") return false;
    if(q.status==="issued" && g.selected_issued_home_win_probability==null) return false;
    if(q.status==="replay" && g.selected_original_home_win_probability==null) return false;
    return true;
  });
}
function exactIssues(d,g) {return d.issued_archive.records.filter(r=>r.league===g.league&&r.event_id===g.event_id&&instant(r.event_time)===instant(g.event_time));}
function csvCell(v) { if(v==null) return ""; let s=String(v); if(typeof v==="string" && /^[=+\-@\t\r]/.test(s)) s="'"+s; return '"'+s.replace(/"/g,'""')+'"'; }
function toCSV(rows) { return [columns.join(","),...rows.map(g=>columns.map(k=>csvCell(g[k])).join(","))].join("\r\n")+"\r\n"; }
function matchedArchiveCounts(d) { let matched=0; for (const row of d.games) matched+=exactIssues(d,decode(row)).length; return {matched,unmatched:d.issued_archive.records.length-matched}; }
globalThis.NCAA_B063 = {columns,decode,selected,filterGames,exactIssues,toCSV,matchedArchiveCounts,esc};
if(typeof document==="undefined") return;
const d=JSON.parse(document.getElementById("b063-data").textContent);
const $=id=>document.getElementById(id);
let page=0;
const pageSize=40;
const settings=()=>({league:$("b063-league").value,season:$("b063-season").value,status:$("b063-status").value,query:$("b063-query").value});
function table(headers,rows) {return '<div class="b063-scroll"><table><thead><tr>'+headers.map(h=>"<th>"+esc(h)+"</th>").join("")+"</tr></thead><tbody>"+(rows.length?rows.map(r=>"<tr>"+r.map(c=>"<td>"+c+"</td>").join("")+"</tr>").join(""):'<tr><td colspan="'+headers.length+'">No eligible saved records in this selection.</td></tr>')+"</tbody></table></div>";}
function showMetrics() {
 const q=settings(), inLeague=x=>q.league==="all"||q.league===x.league;
 const historical=d.historical_leaders.rows.filter(inLeague).filter(r=>q.season==="all"||String(r.season_end_year)===q.season);
 $("b063-historical").innerHTML=table(["League / season","N","Accuracy","Log loss","Brier","Margin MAE","Margin RMSE","Total MAE","Total RMSE"],historical.map(r=>[esc(leagueName(r.league)+" "+(r.season_end_year-1)+"–"+String(r.season_end_year).slice(2)),r.games.toLocaleString(),probability(r.accuracy),number(r.log_loss,6),number(r.brier,6),number(r.margin_mae),number(r.margin_rmse),number(r.total_mae),number(r.total_rmse)]));
 const current=["all","2027"].includes(q.season);
 const summaries=[...d.current_frozen_reference.rows.filter(inLeague).map(r=>({...r,mode:"Frozen original replay"})),...d.preserved_issues.rows.filter(inLeague).map(r=>({...r,mode:"Preserved original issues"}))];
 $("b063-current").innerHTML=table(["League / evidence","N","Accuracy","Log loss","Brier","Margin MAE / RMSE","Total MAE / RMSE"],(current?summaries:[]).map(r=>[esc(leagueName(r.league)+" · "+r.mode),String(r.games),probability(r.accuracy),number(r.log_loss,6),number(r.brier,6),number(r.margin.mae)+" / "+number(r.margin.rmse),number(r.total.mae)+" / "+number(r.total.rmse)]));
 const roleNames={LogLoss:"Probability log loss",MAE:"Mean absolute error"};
 const roles=d.roles.selected_roles.filter(inLeague);
 $("b063-roles").innerHTML=table(["League / target","Saved role alias","Selection metric","Historical N","Historical value","State"],roles.map(r=>[esc(leagueName(r.league)+" / "+r.target),'<code>'+esc(r.model_role_alias)+"</code>",esc(roleNames[r.selection_metric]||r.selection_metric),r.historical_N.toLocaleString(),number(r.historical_metric,6),"Preserved exposed selection; no new promotion"]));
}
function showGames() {
 const q=settings(), rows=filterGames(d,q), mode=$("b063-mode").value;
 page=Math.max(0,Math.min(page,Math.max(0,Math.ceil(rows.length/pageSize)-1)));
 const visible=rows.slice(page*pageSize,(page+1)*pageSize);
 $("b063-game-count").textContent=rows.length.toLocaleString()+" of "+d.games.length.toLocaleString()+" saved source records match · "+(rows.length?String(page*pageSize+1)+"–"+String(Math.min((page+1)*pageSize,rows.length)):"0")+" shown";
 $("b063-game-table").innerHTML=table(["League / saved tip","Game","Observed score","Home win","Home margin","Total","Evidence / clocks"],visible.map((g,index)=>{
   const p=selected(g,mode), has=p.some(v=>v!=null);
   const score=g.actual_home_points==null||g.actual_away_points==null?"—":esc(g.actual_home_points+"–"+g.actual_away_points);
   let label=has?(mode==="issued"?"Preserved original issue":"Exposed retrospective replay"):(g.original_replay_prediction_status==="PRIVATE_UNISSUED_FUTURE_PREVIEW_NOT_PUBLISHED"?"Unissued preview withheld":"No eligible saved output");
   return [esc(leagueName(g.league))+"<br>"+esc(when(g.event_time)),esc(g.away_team||"Unknown away")+" at "+esc(g.home_team||"Unknown home")+'<small>'+esc(g.event_id)+"</small>",score,probability(p[0]),number(p[1],3),number(p[2],3),esc(label)+'<br><button class="b063-link" type="button" data-b063-detail="'+index+'">Inspect record</button>'];
 }));
 $("b063-prev").disabled=page===0; $("b063-next").disabled=(page+1)*pageSize>=rows.length;
 for(const button of $("b063-game-table").querySelectorAll("[data-b063-detail]")) button.addEventListener("click",()=>detail(visible[Number(button.dataset.b063Detail)]));
 $("b063-detail").hidden=true;
}
function detail(g) {
 const issues=exactIssues(d,g);
 $("b063-detail").hidden=false;
 $("b063-detail").innerHTML="<h3>"+esc(g.away_team)+" at "+esc(g.home_team)+"</h3><p>Saved event: "+esc(g.event_time||"unknown")+" · source cutoff: "+esc(d.census_asof_utc)+"</p><p>Identity: <code>"+esc(g.source_binding_status)+"</code><br>Replay: <code>"+esc(g.original_replay_prediction_status)+"</code></p><p>DraftKings, Kalshi and Polymarket: <b>no exact paired quote ledger recovered for this saved record.</b> "+esc(g.provider_comparison_status)+"</p>"+table(["Target / role","Saved prediction","Originally issued","Training cutoff","Features available","Outcome qualification"],issues.map(r=>[esc(r.target)+"<small>"+esc(r.metric_role_alias)+"</small>",esc(r.prediction),esc(r.issued_at),esc(r.training_cutoff),esc(r.feature_available_at),esc(r.outcome_match_status)]))+"<p>Source acquisition and publication do not create an earlier issue time. Empty values remain unavailable. The selected role is not newly qualified as the current champion.</p>";
}
function showArchive() {
 const q=settings(),target=$("b063-archive-target").value;
 const rows=d.issued_archive.records.filter(r=>(q.league==="all"||r.league===q.league)&&(target==="all"||r.target===target));
 $("b063-archive-count").textContent=rows.length+" of 96 preserved target records · 32 original game identities · 30 matched to later observed outcomes";
 $("b063-archive").innerHTML=table(["League / original event","Target / role","Saved prediction","Original issue UTC","Original event UTC","Outcome match"],rows.map(r=>[esc(leagueName(r.league))+"<small>"+esc(r.event_id)+"</small>",esc(r.target)+"<small>"+esc(r.metric_role_alias)+"</small>",esc(r.prediction),esc(r.issued_at),esc(r.event_time),esc(r.outcome_match_status)]));
}
function render(){showMetrics();showGames();showArchive();}
for(const id of ["b063-league","b063-season","b063-status","b063-mode"]) $(id).addEventListener("change",()=>{page=0;render();});
$("b063-query").addEventListener("input",()=>{page=0;showGames();});
$("b063-archive-target").addEventListener("change",showArchive);
$("b063-prev").addEventListener("click",()=>{page--;showGames();});
$("b063-next").addEventListener("click",()=>{page++;showGames();});
$("b063-reset").addEventListener("click",()=>{$("b063-league").value="all";$("b063-season").value="all";$("b063-status").value="all";$("b063-query").value="";page=0;render();});
$("b063-download").addEventListener("click",()=>{const a=document.createElement("a"),u=URL.createObjectURL(new Blob([toCSV(filterGames(d,settings()))],{type:"text/csv;charset=utf-8"}));a.href=u;a.download="ncaa_b063_preserved_source_records.csv";a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);});
$("b063-evidence-time").textContent=d.evidence_asof_utc;
$("b063-census-time").textContent=d.census_asof_utc;
const m=d.market.saved_polymarket;
$("b063-markets").innerHTML=table(["Provider / saved population","N","Model accuracy","Market accuracy","Model log loss","Market log loss","Qualification"],[
["DraftKings","—","—","—","—","—","No complete three-season matched benchmark in these sources."],
["Kalshi","—","—","—","—","—","No qualified new current-season comparison in these sources."],
[esc(m.provider+" · preserved T60 sample"),String(m.games),probability(m.model_accuracy),probability(m.market_accuracy),number(m.model_log_loss,6),number(m.market_log_loss,6),"Earlier preserved comparison; not a new B063 result. No three-season completeness claim."]
]);
render();
})();
</script>
</body></html>
