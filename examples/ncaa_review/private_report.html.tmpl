<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Inspect a private NCAA game report in your browser, with explicit original, rolling and market evidence clocks."><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'"><title>Private NCAA Game Report · Sports Edge Lab</title><style>
:root{--ink:#172723;--muted:#586c61;--green:#136a55;--line:#cad8cc;--paper:#f4f3ed;--white:#fffefb;--amber:#79521c}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.6 system-ui,sans-serif}main{max-width:1240px;margin:auto;padding:30px 28px 50px}header{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-bottom:24px;border-bottom:1px solid var(--line)}a{color:var(--green);text-underline-offset:4px}.brand{font-size:19px;letter-spacing:-.04em;font-weight:750;text-decoration:none;color:var(--ink)}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:700;margin:42px 0 14px}h1{font-size:clamp(35px,5.8vw,66px);letter-spacing:-.055em;line-height:1.09;margin:0 0 23px}h2{font-size:24px;letter-spacing:-.035em;line-height:1.2;margin:0 0 14px}h3{font-size:17px;line-height:1.4;margin:0 0 12px}.intro{max-width:820px;color:var(--muted);font-size:18px}.upload{border:1px solid var(--line);border-radius:16px;padding:25px;background:var(--white);margin:25px 0}.upload label{display:block;font-weight:700;margin-bottom:10px}.upload-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap}input[type=file]{max-width:100%;font:inherit}input[type=file]::file-selector-button,button{background:var(--green);color:white;border:1px solid var(--green);padding:11px 16px;font:650 13px system-ui,sans-serif;border-radius:8px;cursor:pointer}button.secondary{color:var(--green);background:transparent}button:disabled{opacity:.45;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #39729c;outline-offset:3px}.fine{font-size:12px;color:var(--muted)}.status{margin-top:14px;overflow-wrap:anywhere;font-size:13px}.error{color:#a12f2f}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:25px 0}.stat{padding:18px;border:1px solid var(--line);background:var(--white);border-radius:12px}.stat strong{font-size:30px;letter-spacing:-.04em;display:block;font-variant-numeric:tabular-nums}.stat span{font-size:12px;color:var(--muted)}.notice{border-left:4px solid #c49340;background:#fbefd7;padding:16px 19px;font-size:13px;margin:22px 0}.notice p{margin:5px 0}.toolbar{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin:23px 0}.control{min-width:150px;flex:1}.control.search{flex:2;min-width:210px}label{font-size:12px;font-weight:650;display:block;margin-bottom:6px}select,input[type=search]{width:100%;padding:10px 11px;font:inherit;color:var(--ink);background:var(--white);border:1px solid #a9bfae;border-radius:8px;min-height:43px}.tabs{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.tabs button[aria-pressed=false]{background:transparent;color:var(--green)}.pager{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:19px 0}.pager p{margin:0;font-size:13px;color:var(--muted)}.buttons{display:flex;gap:9px}.game{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:22px;margin:16px 0}.game-head{display:flex;justify-content:space-between;gap:18px;align-items:start}.game-head h3{font-size:21px;letter-spacing:-.03em;margin:4px 0}.badge{display:inline-block;font-size:10px;letter-spacing:.045em;text-transform:uppercase;font-weight:750;color:var(--green);background:#e8f0e8;border-radius:5px;padding:4px 7px;margin-right:7px}.badge.warn{color:var(--amber);background:#faefd8}.score{text-align:right;font-size:24px;letter-spacing:-.03em;font-variant-numeric:tabular-nums;min-width:100px}.score span{font-size:11px;display:block;color:var(--muted);letter-spacing:0}.source-note{font-size:12px;color:var(--muted);overflow-wrap:anywhere;margin:10px 0 16px}.data-scroll{overflow:auto;max-width:100%;border:1px solid #e1e6de;border-radius:8px;margin:13px 0}table{border-collapse:collapse;width:100%;font-size:12px}th,td{padding:10px 11px;border-bottom:1px solid #e0e6df;text-align:left;vertical-align:top}th{font-size:10px;text-transform:uppercase;letter-spacing:.035em;background:#f0f3eb;color:#50645a}tbody tr:last-child td{border:0}td{min-width:90px}td:first-child{min-width:165px}td small{display:block;font-size:10px;color:var(--muted);max-width:230px;overflow-wrap:anywhere}.missing{color:#79521c}.note{font-size:12px;color:var(--muted);margin:9px 0}.detail{border-top:1px solid var(--line);margin-top:15px;padding-top:13px}summary{color:var(--green);font-weight:650;font-size:13px;cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.6 ui-monospace,monospace;max-height:480px;overflow:auto;background:#f1f3ec;padding:14px;border-radius:8px}.empty{padding:40px 20px;text-align:center;border:1px dashed var(--line);border-radius:13px;color:var(--muted)}.observation{padding:18px;background:var(--white);border:1px solid var(--line);border-radius:11px;margin:12px 0}.observation h3{overflow-wrap:anywhere}.foot{border-top:1px solid var(--line);font-size:11px;color:var(--muted);margin-top:36px;padding-top:22px}.sr{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:680px){main{padding:23px 17px 35px}.intro{font-size:16px}.summary-grid{grid-template-columns:repeat(2,1fr)}.stat{padding:14px}.stat strong{font-size:26px}.game{padding:16px}.game-head{flex-direction:column;gap:10px}.score{text-align:left}.score span{display:inline;margin-left:9px}.toolbar{gap:10px}.control{min-width:135px}.upload{padding:19px}.eyebrow{margin-top:30px}h1{font-size:40px}.tabs button{flex:1}td:first-child{min-width:140px}}
</style></head><body><main><header><a class="brand" href="../index.html">Sports Edge Lab</a><nav aria-label="Basketball reviews"><a href="https://alvaro-ncaa-research-review.alv-mendizabal.chatgpt.site/tracks/ncaam/index.html">Men's review</a> · <a href="https://alvaro-ncaa-research-review.alv-mendizabal.chatgpt.site/tracks/ncaaw/index.html">Women's review</a></nav></header><p class="eyebrow">NCAA · Personal report viewer</p><h1>Every observed game.<br>Every visible gap.</h1><p class="intro">Open your private report to inspect results, original and rolling model records, and captured market observations. The report stays in this browser tab.</p><section class="upload" aria-label="Open a private report"><label for="report-file">Choose your NCAA dashboard JSON file</label><div class="upload-row"><input id="report-file" type="file" accept=".json,application/json"><button class="secondary" id="clear" type="button" disabled>Clear report</button></div><p class="fine">Files up to 64 MiB. The page does not upload, save, or transmit the imported report. Reloading or clearing removes the in-memory view.</p><p class="status" id="load-status" role="status" aria-live="polite">No report loaded. The public review remains available above.</p></section><section id="report" hidden aria-label="Imported report"><div class="summary-grid" id="summary"></div><div class="notice"><strong id="asof"></strong><p>Counts refer to distinct source records. Unmatched official candidates can duplicate other records; an official season denominator remains a separate requirement.</p><p>Captured pre-tip and latest observed prices are display evidence. They cannot rewrite an earlier model input, issue, selection, or return. An exchange threshold price is not an expected point total.</p><p id="qualifications"></p></div><div class="tabs" role="group" aria-label="Report view"><button id="show-games" aria-pressed="true" type="button">Games and forecasts</button><button id="show-observations" aria-pressed="false" type="button">All market observations</button></div><div class="toolbar"><div class="control"><label for="league">League</label><select id="league"><option value="all">Men and women, separated</option><option value="ncaam">Men</option><option value="ncaaw">Women</option></select></div><div class="control" id="window-control"><label for="window">Report window</label><select id="window"><option value="all_observed">All observed records</option><option value="season_to_date">Season to date</option><option value="this_week">This week</option><option value="last_week">Last week</option></select></div><div class="control" id="model-control"><label for="model">Forecast stream shown</label><select id="model"><option value="all">Every recorded stream</option></select></div><div class="control" id="binding-control" hidden><label for="binding">Market binding</label><select id="binding"><option value="all">Bound and unresolved</option><option value="unresolved">Unresolved identity</option><option value="bound">Bound to a game</option></select></div><div class="control search"><label for="search">Find a team, source record or provider</label><input id="search" type="search" placeholder="Search this report" autocomplete="off"></div><div class="control"><label for="page-size">Rows per page</label><select id="page-size"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div></div><div class="pager"><p id="row-count" role="status" aria-live="polite"></p><div class="buttons"><button id="previous" class="secondary" type="button">Previous</button><button id="next" class="secondary" type="button">Next</button></div></div><div id="results"></div><details class="detail" id="metric-details"><summary>Recorded current and weekly metric populations</summary></details><details class="detail"><summary>Report metadata, limitations and source audit</summary><pre id="metadata"></pre></details></section><footer class="foot">Private report values are supplied by the file you choose, not by the public website. Missing records, missing prices and missing forecast issues remain explicit. No wager or verified profit follows from an imported report.</footer></main><script>
'use strict';
(() => {
  const $=id=>document.getElementById(id), schema='sports-edge-lab.private.game-report.v1';
  let report=null, games=[], observations=[], windowKeys={}, view='games', page=0, loadGeneration=0;
  const number=(v,d=2)=>typeof v==='number'&&Number.isFinite(v)?v.toLocaleString('en-US',{maximumFractionDigits:d,minimumFractionDigits:d}):'Unavailable';
  const present=v=>v!==undefined&&v!==null&&v!=='';
  const text=v=>present(v)?String(v):'Unavailable';
  const label=s=>({native_frozen_recipe_reconstruction:'Frozen-recipe reconstruction',native_rolling_weekly_reconstruction:'Rolling weekly reconstruction',native_rolling_latest_available:'Rolling latest available reconstruction',original_frozen:'Original frozen issue'}[s]||s||'No recorded model');
  const identity=r=>JSON.stringify([r.league||'',r.event_id||'']);
  const node=(tag,value,cls)=>{const n=document.createElement(tag);if(value!==undefined)n.textContent=value;if(cls)n.className=cls;return n;};
  const finite=(v)=>typeof v==='number'&&Number.isFinite(v);
  function appendRow(body,values){const tr=node('tr');values.forEach(v=>{const td=node('td');td.append(v instanceof Node?v:node('span',v));tr.append(td);});body.append(tr);}
  function table(headers){const wrap=node('div',undefined,'data-scroll'),t=node('table'),head=node('thead'),tr=node('tr'),body=node('tbody');headers.forEach(h=>{const th=node('th',h);th.scope='col';tr.append(th);});head.append(tr);t.append(head,body);wrap.append(t);return [wrap,body];}
  function details(title,value){const d=node('details',undefined,'detail');d.append(node('summary',title));d.addEventListener('toggle',()=>{if(d.open&&!d.querySelector('pre'))d.append(node('pre',JSON.stringify(value,null,2)));});return d;}
  function validate(value){if(!value||typeof value!=='object'||Array.isArray(value)||value.schema!==schema)throw Error('This file is not a supported NCAA private game report.');
    for(const key of ['records','market_observations']){if(!Array.isArray(value[key])||value[key].length>200000)throw Error('Invalid or oversized '+key+' inventory.');if(value[key].some(r=>!r||typeof r!=='object'||Array.isArray(r)))throw Error('Invalid '+key+' row.');}
    if(value.records.some(r=>typeof r.event_id!=='string'||!['ncaam','ncaaw'].includes(r.league)))throw Error('Every game record needs its explicit league and source identity.');
    return value;}
  function load(value){report=validate(value);const map=new Map();for(const r of report.records){const key=identity(r);if(!map.has(key))map.set(key,{id:key,base:r,rows:[]});map.get(key).rows.push(r);}games=[...map.values()];observations=report.market_observations;windowKeys={};for(const [name,keys]of Object.entries(report.window_event_keys||{})){if(Array.isArray(keys))windowKeys[name]=new Set(keys.map(k=>JSON.stringify(k)));}
    $('model').replaceChildren(new Option('Every recorded stream','all'));[...new Set(report.records.map(r=>r.track).filter(Boolean))].sort().forEach(s=>$('model').append(new Option(label(s),s)));
    for(const o of $('window').options)o.disabled=o.value!=='all_observed'&&!windowKeys[o.value];$('window').value='all_observed';$('search').value='';$('league').value='all';$('binding').value='all';view='games';page=0;
    const bound=observations.filter(r=>r.canonical_identity_verified===true&&r.event_id).length;const stats=[['Source game records',games.length],['Game / model rows',report.records.length],['Market observations',observations.length],['Unresolved market identities',observations.length-bound]];$('summary').replaceChildren(...stats.map(([s,v])=>{const n=node('div',undefined,'stat');n.append(node('span',s),node('strong',v.toLocaleString('en-US')));return n;}));
    $('asof').textContent=(report.evidence_release||'Evidence')+' · Report observation '+text(report.asof_pacific||report.asof_utc);$('qualifications').textContent='Original frozen issue: '+(report.records.some(r=>r.durable_issued_before_cutoff===true)?'inspect each recorded issue clock.':'not established in this report. Reconstruction rows are not as-issued forecasts.')+' Polymarket international and US remain separate products.';
    const metadata={...report};delete metadata.records;delete metadata.market_observations;delete metadata.window_event_keys;delete metadata.window_event_ids;delete metadata.metrics;delete metadata.weekly_metrics;$('metadata').textContent=JSON.stringify(metadata,null,2);$('metric-details').replaceChildren(node('summary','Recorded current and weekly metric populations'));$('metric-details').append(node('pre',JSON.stringify({metrics:report.metrics||[],weekly_metrics:report.weekly_metrics||[]},null,2)));
    $('report').hidden=false;$('clear').disabled=false;$('load-status').className='status';$('load-status').textContent='Loaded '+games.length.toLocaleString('en-US')+' source game records. Report data stays in this tab.';render();}
  function forecastCell(r){const n=node('span',label(r.track));n.append(node('small',r.forecast_status||'No recorded model issue'));return n;}
  function streamRows(g){return $('model').value==='all'?g.rows:g.rows.filter(r=>r.track===$('model').value);}
  function marketValue(r,p,clock,target){const key=p+'_'+(clock?clock+'_':'')+target;const v=r[key+'_value'];const n=node('span',finite(v)?number(v,target==='win'?4:2):'Unavailable',finite(v)?'':'missing');if(present(v))n.append(node('small',r[key+'_value_kind']||'Value semantics unverified'));n.append(node('small',r[key+'_status']||'No exact-bound observation'));return n;}
  function gameCard(g){const r=g.base,card=node('article',undefined,'game');card.dataset.game=g.id;const head=node('div',undefined,'game-head'),title=node('div');title.append(node('span',r.league==='ncaam'?"Men's basketball":r.league==='ncaaw'?"Women's basketball":'League unverified','badge'));if(r.source_binding_status==='UNMATCHED_OFFICIAL_CANDIDATE_RECORD')title.append(node('span','Unmatched official candidate','badge warn'));title.append(node('h3',text(r.away_team)+' at '+text(r.home_team)));const score=node('div',finite(r.actual_away_points)&&finite(r.actual_home_points)?number(r.actual_away_points,0)+' – '+number(r.actual_home_points,0):r.completed?'Final score unavailable':'Result pending','score');score.append(node('span','Away – home'));head.append(title,score);card.append(head);
    card.append(node('p',text(r.tipoff_pacific||r.source_date)+' · Pacific time · precision: '+text(r.time_precision)+' · phase: '+text(r.phase)+' · '+text(r.event_id),'source-note'));
    for(const annotation of (report.audit_annotations?.[r.event_id]||[]))card.append(node('p','Source precision warning: '+String(annotation),'notice'));
    if(r.completed)card.append(node('p','Actual winner: '+text(r.actual_winner)+' · loser: '+text(r.actual_loser),'note'));
    const selected=streamRows(g);const [forecasts,body]=table(['Forecast record','Home win probability','Winner pick / correct','Home / away score center','Home margin / error','Total / error']);
    const original=g.rows.find(x=>x.durable_issued_before_cutoff===true&&/original|frozen_original/.test(x.track||''));if(!original)appendRow(body,['Original frozen as issued','Not recorded','Not recorded','Not recorded','Not recorded','Not recorded']);
    if(!selected.length)appendRow(body,[label($('model').value),'No record for this game','Unavailable','Unavailable','Unavailable','Unavailable']);
    for(const x of selected){const winner=node('span',text(x.model_winner_pick));winner.append(node('small',typeof x.model_winner_pick_correct==='boolean'?(x.model_winner_pick_correct?'Correct':'Wrong'):'Correct pick unverified'));appendRow(body,[forecastCell(x),finite(x.prediction_win)?number(x.prediction_win*100,1)+'%':'Unavailable',winner,number(x.prediction_home_score_center)+' / '+number(x.prediction_away_score_center),number(x.prediction_margin)+' / '+number(x.margin_error),number(x.prediction_total)+' / '+number(x.total_error)]);}
    card.append(forecasts);card.append(node('p','Point errors are prediction minus actual. Missing values are not zero. Frozen-recipe reconstruction does not replace the original frozen issue.','note'));
    const [prices,priceBody]=table(['Provider / target','Latest captured pre-tip','Latest observed','Strict eligible T−60']);
    for(const [provider,name]of [['kalshi','Kalshi'],['polymarket','Polymarket international'],['draftkings','DraftKings']]){for(const target of ['win','margin','total'])appendRow(priceBody,[name+' · '+target,marketValue(r,provider,'latest_pretip',target),marketValue(r,provider,'latest_observed',target),marketValue(r,provider,'',target)]);}
    card.append(prices);card.append(node('p','Polymarket US: '+text(r.polymarket_us_status||'NOT ACQUIRED / UNVERIFIED'),'note'));
    const choices=node('p',undefined,'note');for(const [p,n]of [['kalshi','Kalshi'],['polymarket','Polymarket'],['draftkings','DraftKings']]){choices.append(node('strong',n+': '+(r[p+'_hypothetical_selection']||'NO BET')+' '),document.createTextNode((r[p+'_no_bet_reason']||'No qualified pair')+'. '));}card.append(choices);
    card.append(details('All source, issue, training and quote clocks; differences and NO BET evidence',g.rows));return card;}
  function observationCard(r){const n=node('article',undefined,'observation'),bound=r.canonical_identity_verified===true&&r.event_id;let product=r.provider_product_label||r.provider_product||r.provider||'Unknown provider';if(product==='Polymarket')product='Polymarket international / product detail below';n.append(node('span',bound?'Bound identity':'Unresolved identity','badge'+(bound?'':' warn')),node('h3',product+' · '+text(r.target||r.native_target)),node('p','League: '+text(r.league)+' · source event: '+text(r.event_id||r.native_event_id)+' · '+text(r.binding_status),'source-note'),node('p','Observed value: '+number(r.prediction??r.value??r.native_yes_probability,4)+' · '+text(r.value_kind||(finite(r.native_yes_probability)?'Native Yes probability; identity unresolved':null)),'note'),node('p','Quote: '+text(r.quote_time)+' · Acquired: '+text(r.acquired_at)+' · Support ends: '+text(r.observation_support_end_upper_bound),'note'));n.append(details('Complete captured observation and unresolved source evidence',r));return n;}
  function filtered(){const league=$('league').value,q=$('search').value.trim().toLowerCase();if(view==='games'){const ids=windowKeys[$('window').value];return games.filter(g=>(league==='all'||g.base.league===league)&&(!ids||ids.has(g.id))&&(!q||g.rows.some(r=>[r.home_team,r.away_team,r.event_id,r.track].some(v=>String(v||'').toLowerCase().includes(q)))));}
    const binding=$('binding').value;return observations.filter(r=>{const bound=r.canonical_identity_verified===true&&r.event_id;return(league==='all'||!r.league||r.league===league)&&(binding==='all'||(binding==='bound'?bound:!bound))&&(!q||[r.provider,r.provider_product,r.event_id,r.native_event_id,r.target,r.native_target,r.binding_status,r.contract_title,r.title].some(v=>String(v||'').toLowerCase().includes(q)));});}
  function render(){if(!report)return;$('show-games').setAttribute('aria-pressed',String(view==='games'));$('show-observations').setAttribute('aria-pressed',String(view==='observations'));$('window-control').hidden=view!=='games';$('model-control').hidden=view!=='games';$('binding-control').hidden=view==='games';const list=filtered(),size=Number($('page-size').value),pages=Math.max(1,Math.ceil(list.length/size));page=Math.min(page,pages-1);const start=page*size,visible=list.slice(start,start+size);$('row-count').textContent=(list.length?(start+1)+'–'+(start+visible.length):'0')+' of '+list.length.toLocaleString('en-US')+' '+(view==='games'?'source game records':'captured observations')+' · page '+(page+1)+' / '+pages;$('previous').disabled=page===0;$('next').disabled=page+1>=pages;$('results').replaceChildren(...(visible.length?visible.map(view==='games'?gameCard:observationCard):[node('div','No records match these filters. Change the window, league or search.','empty')]));}
  $('report-file').addEventListener('change',()=>{const f=$('report-file').files[0],generation=++loadGeneration;if(!f)return;if(f.size>64*1024*1024){$('load-status').className='status error';$('load-status').textContent='File exceeds the 64 MiB limit. Existing report remains unchanged.';return;}$('load-status').textContent='Reading selected report…';const reader=new FileReader();reader.onload=()=>{if(generation!==loadGeneration)return;try{const candidate=JSON.parse(reader.result);validate(candidate);load(candidate);}catch(e){$('load-status').className='status error';$('load-status').textContent='Cannot open report: '+e.message;}};reader.onerror=()=>{if(generation===loadGeneration){$('load-status').className='status error';$('load-status').textContent='The selected file could not be read. Existing report remains unchanged.';}};reader.readAsText(f);});
  $('clear').addEventListener('click',()=>{loadGeneration++;report=null;games=[];observations=[];windowKeys={};$('results').replaceChildren();$('metadata').textContent='';$('metric-details').replaceChildren(node('summary','Recorded current and weekly metric populations'));$('summary').replaceChildren();$('report-file').value='';$('report').hidden=true;$('clear').disabled=true;$('load-status').className='status';$('load-status').textContent='Report cleared from this tab.';});
  for(const id of ['league','window','model','binding','page-size'])$(id).addEventListener('change',()=>{page=0;render();});$('search').addEventListener('input',()=>{page=0;render();});$('show-games').addEventListener('click',()=>{view='games';page=0;render();});$('show-observations').addEventListener('click',()=>{view='observations';page=0;render();});$('previous').addEventListener('click',()=>{page--;render();});$('next').addEventListener('click',()=>{page++;render();});
})();
</script></body></html>
