    for(const x of selected){const winner=node('span',text(x.model_winner_pick));winner.append(node('small',typeof x.model_winner_pick_correct==='boolean'?(x.model_winner_pick_correct?'Correct':'Wrong'):'Correct pick unverified'));appendRow(body,[forecastCell(x),finite(x.prediction_win)?number(x.prediction_win*100,1)+'%':'Unavailable',winner,number(x.prediction_home_score_center)+' / '+number(x.prediction_away_score_center),number(x.prediction_margin)+' / '+number(x.margin_error),number(x.prediction_total)+' / '+number(x.total_error)]);}
    card.append(forecasts);card.append(node('p','Point errors are prediction minus actual. Missing values are not zero. Frozen-recipe reconstruction does not replace the original frozen issue.','note'));
    const clock=$('market-clock').value,[prices,priceBody]=table(['Provider / target',marketClocks[clock].label+' · captured evidence','Recorded strict T−60 model comparison']);
    prices.classList.add('market-table');
    for(const [provider,name]of [['kalshi','Kalshi'],['polymarket','Polymarket international'],['draftkings','DraftKings']]){for(const target of ['win','margin','total'])appendRow(priceBody,[name+' · '+target,capturedValues(g.rows,provider,clock,target),strictValues(selected,provider,target)]);}
    card.append(node('p','The captured price stays visible even when no model comparison qualifies. Strict comparison values belong to the displayed forecast streams; their recorded status governs eligibility. Distinct supplied source versions remain separate.','note'));
    card.append(prices);card.append(injuryCard(g.rows));card.append(node('p','Polymarket US: '+text(r.polymarket_us_status||'NOT ACQUIRED / UNVERIFIED'),'note'));
    for(const selectionRow of (selected.length?selected:[{}])){const choices=node('p',undefined,'note');choices.append(node('small',label(selectionRow.track)+' · recorded selection evidence: '));for(const [p,n]of [['kalshi','Kalshi'],['polymarket','Polymarket international'],['draftkings','DraftKings']]){choices.append(node('strong',n+': '+(selectionRow[p+'_hypothetical_selection']||'NO BET')+' '),document.createTextNode((selectionRow[p+'_no_bet_reason']||'No qualified pair')+'. '));}card.append(choices);}
    card.append(details('All source, issue, training and quote clocks; differences and NO BET evidence',g.rows));return card;}
  function observationCard(r){const n=node('article',undefined,'observation'),bound=r.canonical_identity_verified===true&&r.event_id;let product=r.provider_product_label||r.provider_product||r.provider||'Unknown provider';if(product==='Polymarket')product='Polymarket international / product detail below';n.append(node('span',bound?'Bound identity':'Unresolved identity','badge'+(bound?'':' warn')),node('h3',product+' · '+text(r.target||r.native_target)),node('p','League: '+text(r.league)+' · source event: '+text(r.event_id||r.native_event_id)+' · '+text(r.binding_status),'source-note'),node('p','Observed value: '+number(r.prediction??r.value??r.native_yes_probability,4)+' · '+text(r.value_kind||(finite(r.native_yes_probability)?'Native Yes probability; identity unresolved':null)),'note'),node('p','Quote: '+text(r.quote_time)+' · Acquired: '+text(r.acquired_at)+' · Support ends: '+text(r.observation_support_end_upper_bound),'note'));n.append(details('Complete captured observation and unresolved source evidence',r));return n;}
  function filtered(){const league=$('league').value,q=$('search').value.trim().toLowerCase();if(view==='games'){const ids=windowKeys[$('window').value];return games.filter(g=>(league==='all'||g.base.league===league)&&(!ids||ids.has(g.id))&&(!q||g.rows.some(r=>[r.home_team,r.away_team,r.event_id,r.track,r.recipe].some(v=>String(v||'').toLowerCase().includes(q)))));}
    const binding=$('binding').value;return observations.filter(r=>{const bound=r.canonical_identity_verified===true&&r.event_id;return(league==='all'||!r.league||r.league===league)&&(binding==='all'||(binding==='bound'?bound:!bound))&&(!q||[r.provider,r.provider_product,r.event_id,r.native_event_id,r.target,r.native_target,r.binding_status,r.contract_title,r.title].some(v=>String(v||'').toLowerCase().includes(q)));});}
  function render(){if(!report)return;$('show-games').setAttribute('aria-pressed',String(view==='games'));$('show-observations').setAttribute('aria-pressed',String(view==='observations'));$('window-control').hidden=view!=='games';$('model-control').hidden=view!=='games';$('binding-control').hidden=view==='games';$('market-clock-control').hidden=view!=='games';$('market-clock-note').hidden=view!=='games';const clock=marketClocks[$('market-clock').value];$('market-clock-note').replaceChildren(node('strong',clock.label+'. '),document.createTextNode(clock.note+' Captured observations do not change the strict model comparison.'));const list=filtered(),size=Number($('page-size').value),pages=Math.max(1,Math.ceil(list.length/size));page=Math.min(page,pages-1);const start=page*size,visible=list.slice(start,start+size);$('row-count').textContent=(list.length?(start+1)+'–'+(start+visible.length):'0')+' of '+list.length.toLocaleString('en-US')+' '+(view==='games'?'source game records':'loaded captured observations')+' · page '+(page+1)+' / '+pages;$('previous').disabled=page===0;$('next').disabled=page+1>=pages;$('results').replaceChildren(...(visible.length?visible.map(view==='games'?gameCard:observationCard):[node('div',view==='games'&&!recordRows.length&&declaredRecordTotal(report)>0?'Game/model rows are preserved but unloaded. Choose a report part above to inspect its games and forecasts.':view==='observations'&&!observations.length&&inventoryCount(report)>0?'The report declares preserved observations but has no inline rows in this view. Per-game captured prices remain available; inspect a supplied bounded file above for its recorded observations.':'No records match these filters. Change the window, league or search.','empty')]));}
  $('report-file').addEventListener('change',()=>{const f=$('report-file').files[0],generation=++loadGeneration;if(!f)return;if(f.size>64*1024*1024){$('load-status').className='status error';$('load-status').textContent='File exceeds the 64 MiB limit. Existing report remains unchanged.';return;}$('load-status').textContent='Reading selected report…';const reader=new FileReader();reader.onload=()=>{if(generation!==loadGeneration)return;try{const candidate=JSON.parse(reader.result);validate(candidate);load(candidate);}catch(e){$('load-status').className='status error';$('load-status').textContent='Cannot open report: '+e.message;}};reader.onerror=()=>{if(generation===loadGeneration){$('load-status').className='status error';$('load-status').textContent='The selected file could not be read. Existing report remains unchanged.';}};reader.readAsText(f);});
  $('clear').addEventListener('click',()=>{loadGeneration++;chunkGeneration++;recordGeneration++;loadedRecordPart=null;selectedIndex=null;loadedChunk=null;$('record-scope').textContent='';$('record-part-status').textContent='';$('record-part-file').value='';$('record-part-selection').replaceChildren();$('record-part-file').disabled=true;$('record-part-details').hidden=true;$('clear-record-part').disabled=true;$('unresolved-official-details').ontoggle=null;$('unresolved-official-details').replaceChildren(node('summary','Unresolved official source records'));$('freshness-grid').replaceChildren();$('observation-scope').textContent='';$('chunk-status').textContent='';$('chunk-index-file').value='';$('chunk-data-file').value='';$('chunk-index-file').disabled=true;$('chunk-data-file').disabled=true;$('restore-inline').disabled=true;clearProviderComparisons();report=null;recordRows=[];games=[];observations=[];windowKeys={};$('results').replaceChildren();$('metadata').textContent='';$('unclassified-details').ontoggle=null;$('unclassified-details').replaceChildren(node('summary','Unclassified source observations'));$('horizon-details').replaceChildren(node('summary','Paired metrics by market reference horizon'));$('market-clock-note').textContent='';$('metric-details').replaceChildren(node('summary','Recorded current and weekly metric populations'));$('summary').replaceChildren();$('report-file').value='';$('asof').textContent='';$('qualifications').textContent='';$('row-count').textContent='';$('search').value='';$('model').replaceChildren(new Option('Every recorded stream','all'));$('report').hidden=true;$('clear').disabled=true;$('load-status').className='status';$('load-status').textContent='Report cleared from this tab.';});
  for(const id of ['league','window','model','binding','page-size','market-clock'])$(id).addEventListener('change',()=>{page=0;render();});$('search').addEventListener('input',()=>{page=0;render();});$('show-games').addEventListener('click',()=>{view='games';page=0;render();});$('show-observations').addEventListener('click',()=>{view='observations';page=0;render();});$('previous').addEventListener('click',()=>{page--;render();});$('next').addEventListener('click',()=>{page++;render();});
})();
</script></body></html>
