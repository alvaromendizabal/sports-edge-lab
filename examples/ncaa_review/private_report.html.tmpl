<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Inspect a private NCAA game report in your browser, with explicit original, rolling and market evidence clocks."><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'"><title>Private NCAA Game Report · Sports Edge Lab</title><style>
:root{--ink:#172723;--muted:#586c61;--green:#136a55;--line:#cad8cc;--paper:#f4f3ed;--white:#fffefb;--amber:#79521c}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.6 system-ui,sans-serif}main{max-width:1240px;margin:auto;padding:30px 28px 50px}header{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-bottom:24px;border-bottom:1px solid var(--line)}a{color:var(--green);text-underline-offset:4px}.brand{font-size:19px;letter-spacing:-.04em;font-weight:750;text-decoration:none;color:var(--ink)}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:700;margin:42px 0 14px}h1{font-size:clamp(35px,5.8vw,66px);letter-spacing:-.055em;line-height:1.09;margin:0 0 23px}h2{font-size:24px;letter-spacing:-.035em;line-height:1.2;margin:0 0 14px}h3{font-size:17px;line-height:1.4;margin:0 0 12px}.intro{max-width:820px;color:var(--muted);font-size:18px}.upload{border:1px solid var(--line);border-radius:16px;padding:25px;background:var(--white);margin:25px 0}.upload label{display:block;font-weight:700;margin-bottom:10px}.upload-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap}input[type=file]{max-width:100%;font:inherit}input[type=file]::file-selector-button,button{background:var(--green);color:white;border:1px solid var(--green);padding:11px 16px;font:650 13px system-ui,sans-serif;border-radius:8px;cursor:pointer}button.secondary{color:var(--green);background:transparent}button:disabled{opacity:.45;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #39729c;outline-offset:3px}.fine{font-size:12px;color:var(--muted)}.status{margin-top:14px;overflow-wrap:anywhere;font-size:13px}.error{color:#a12f2f}.freshness-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0}.clock-card{padding:13px;background:#eef2e9;border:1px solid var(--line);border-radius:10px;min-width:0}.clock-card span{font-size:11px;color:var(--muted);display:block}.clock-card strong{display:block;font-size:12px;font-weight:600;overflow-wrap:anywhere}.chunk-controls{display:flex;gap:16px;flex-wrap:wrap;align-items:end}.chunk-controls>div{flex:1;min-width:180px;max-width:100%}.chunk-controls input{width:100%}@media(max-width:680px){.freshness-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:25px 0}.stat{padding:18px;border:1px solid var(--line);background:var(--white);border-radius:12px}.stat strong{font-size:30px;letter-spacing:-.04em;display:block;font-variant-numeric:tabular-nums}.stat span{font-size:12px;color:var(--muted)}.notice{border-left:4px solid #c49340;background:#fbefd7;padding:16px 19px;font-size:13px;margin:22px 0}.notice p{margin:5px 0}.toolbar{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin:23px 0}.control{min-width:150px;flex:1}.control.search{flex:2;min-width:210px}label{font-size:12px;font-weight:650;display:block;margin-bottom:6px}select,input[type=search]{width:100%;padding:10px 11px;font:inherit;color:var(--ink);background:var(--white);border:1px solid #a9bfae;border-radius:8px;min-height:43px}.tabs{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.tabs button[aria-pressed=false]{background:transparent;color:var(--green)}.pager{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:19px 0}.pager p{margin:0;font-size:13px;color:var(--muted)}.buttons{display:flex;gap:9px}.game{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:22px;margin:16px 0}.game-head{display:flex;justify-content:space-between;gap:18px;align-items:start}.game-head>div{min-width:0}.game-head h3{overflow-wrap:anywhere;font-size:21px;letter-spacing:-.03em;margin:4px 0}.badge{display:inline-block;font-size:10px;letter-spacing:.045em;text-transform:uppercase;font-weight:750;color:var(--green);background:#e8f0e8;border-radius:5px;padding:4px 7px;margin-right:7px}.badge.warn{color:var(--amber);background:#faefd8}.score{text-align:right;font-size:24px;letter-spacing:-.03em;font-variant-numeric:tabular-nums;min-width:100px}.score span{font-size:11px;display:block;color:var(--muted);letter-spacing:0}.source-note{font-size:12px;color:var(--muted);overflow-wrap:anywhere;margin:10px 0 16px}.data-scroll{overflow:auto;max-width:100%;border:1px solid #e1e6de;border-radius:8px;margin:13px 0}table{border-collapse:collapse;width:100%;font-size:12px}th,td{padding:10px 11px;border-bottom:1px solid #e0e6df;text-align:left;vertical-align:top}th{font-size:10px;text-transform:uppercase;letter-spacing:.035em;background:#f0f3eb;color:#50645a}tbody tr:last-child td{border:0}td{min-width:90px}td:first-child{min-width:165px}td small{display:block;font-size:10px;color:var(--muted);max-width:230px;overflow-wrap:anywhere}.market-entry+.market-entry{border-top:1px solid var(--line);margin-top:11px;padding-top:11px}.market-entry{display:block}.market-clock-note{border:1px solid var(--line);background:#edf3ec;padding:13px 16px;border-radius:10px;font-size:12px;color:var(--muted)}.market-clock-note strong{color:var(--ink)}.market-metric{display:block;white-space:nowrap}.missing{color:#79521c}.note{font-size:12px;color:var(--muted);margin:9px 0}.detail{border-top:1px solid var(--line);margin-top:15px;padding-top:13px}summary{color:var(--green);font-weight:650;font-size:13px;cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.6 ui-monospace,monospace;max-height:480px;overflow:auto;background:#f1f3ec;padding:14px;border-radius:8px}.empty{padding:40px 20px;text-align:center;border:1px dashed var(--line);border-radius:13px;color:var(--muted)}.observation{padding:18px;background:var(--white);border:1px solid var(--line);border-radius:11px;margin:12px 0}.observation h3{overflow-wrap:anywhere}.provider-review{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px 0;margin:25px 0}.provider-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.provider-card{border:1px solid var(--line);border-radius:12px;background:var(--white);padding:17px;min-width:0}.provider-card h3{margin:0 0 9px}.provider-availability{color:var(--green);font-size:13px}.comparison-population{border:1px solid var(--line);border-radius:12px;padding:17px;margin:14px 0;background:var(--white)}.comparison-population h3{overflow-wrap:anywhere}.provider-review .source-note{overflow-wrap:anywhere}@media(max-width:680px){.provider-grid{grid-template-columns:1fr}.provider-card{padding:14px}.comparison-population{padding:13px}}.foot{border-top:1px solid var(--line);font-size:11px;color:var(--muted);margin-top:36px;padding-top:22px}.sr{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:680px){main{padding:23px 17px 35px}.intro{font-size:16px}.summary-grid{grid-template-columns:repeat(2,1fr)}.stat{padding:14px}.stat strong{font-size:26px}.game{padding:16px}.game-head{flex-direction:column;gap:10px}.score{text-align:left}.score span{display:inline;margin-left:9px}.toolbar{gap:10px}.control{min-width:135px}.upload{padding:19px}.eyebrow{margin-top:30px}h1{font-size:40px}.tabs button{flex:1}td:first-child{min-width:140px}}
</style></head><body><main><header><a class="brand" href="../index.html">Sports Edge Lab</a><nav aria-label="Basketball reviews"><a href="https://alvaro-ncaa-research-review.alv-mendizabal.chatgpt.site/tracks/ncaam/index.html">Men's review</a> · <a href="https://alvaro-ncaa-research-review.alv-mendizabal.chatgpt.site/tracks/ncaaw/index.html">Women's review</a></nav></header><p class="eyebrow">NCAA · Personal report viewer</p><h1>Every observed game.<br>Every visible gap.</h1><p class="intro">Open your private report to inspect results, original and rolling model records, and captured market observations. The report stays in this browser tab.</p><section class="upload" aria-label="Open a private report"><label for="report-file">Choose your NCAA dashboard JSON file</label><div class="upload-row"><input id="report-file" type="file" accept=".json,application/json"><button class="secondary" id="clear" type="button" disabled>Clear report</button></div><p class="fine">Files up to 64 MiB. The page does not upload, save, or transmit the imported report. Reloading or clearing removes the in-memory view.</p><p class="status" id="load-status" role="status" aria-live="polite">No report loaded. The public review remains available above.</p></section><section id="report" hidden aria-label="Imported report"><div class="summary-grid" id="summary"></div><section aria-label="Separate report and source clocks"><h2>Season and update clocks</h2><div class="freshness-grid" id="freshness-grid"></div><p class="note">The season end year is a label. Missing acquisition, issue or refresh times remain unavailable; report generation does not replace those clocks.</p></section><div class="notice"><strong id="asof"></strong><p>Counts refer to distinct source records. Unmatched official candidates can duplicate other records; an official season denominator remains a separate requirement.</p><p>Prices supported at T−120, T−60, pre-tip and latest observed prices are display evidence. Source time and actual capture time are distinct. The recorded model/provider pair has its own eligibility status. Changing the displayed price cannot rewrite an earlier model input, issue, selection, or return. An exchange threshold price is not an expected point total.</p><p id="qualifications"></p></div><section class="provider-review" id="provider-review" aria-labelledby="provider-review-title"><h2 id="provider-review-title">Our models and all three providers</h2><p class="note">Inspect each provider's eligible games and the exact common-game populations separately. These are authored report values: forecast streams, leagues, seasons, horizons and evidence modes remain distinct.</p><div class="toolbar"><div class="control"><label for="provider-period">Metric period</label><select id="provider-period"><option value="season">Season</option><option value="week">Week</option></select></div><div class="control"><label for="provider-cohort">Comparison population</label><select id="provider-cohort"><option value="provider">Each provider's eligible games</option><option value="common">Common games across all three</option></select></div><div class="control"><label for="provider-league">Comparison league</label><select id="provider-league"><option value="all">Men and women, separated</option><option value="ncaam">Men</option><option value="ncaaw">Women</option></select></div><div class="control"><label for="provider-target">Comparison objective</label><select id="provider-target"><option value="win">Winner probability</option><option value="margin">Point margin</option><option value="total">Point total</option><option value="all">All objectives, separated</option></select></div><div class="control"><label for="provider-stream">Comparison model stream</label><select id="provider-stream"><option value="all">Every recorded stream</option></select></div><div class="control" id="provider-week-control" hidden><label for="provider-week">Supplied week</label><select id="provider-week"><option value="all">Every supplied week</option></select></div></div><p class="market-clock-note" id="provider-comparison-status" role="status" aria-live="polite"></p><div class="provider-grid" id="provider-cards"></div><p class="note">A binary spread/total threshold probability is not an expected point margin or total. Unsupported point comparisons, uncertainty intervals and execution-qualified ROI remain unavailable; no missing value becomes zero.</p><div class="pager"><p id="provider-count" role="status" aria-live="polite"></p><div class="buttons"><button id="provider-previous" class="secondary" type="button">Previous populations</button><button id="provider-next" class="secondary" type="button">Next populations</button></div></div><div id="provider-populations"></div><p class="source-note" id="provider-source-status"></p><h3>Correct and wrong disagreements</h3><p class="note">Counts within each population show how often the model was right when each provider was wrong, and the reverse. Exact supplied records follow below; one game can have several model records. This source inventory has its own scope: choosing common metrics does not infer common membership for these records. These records do not establish hypothetical profit.</p><div class="pager"><p id="provider-disagreement-count" role="status" aria-live="polite"></p><div class="buttons"><button id="provider-disagreement-previous" class="secondary" type="button">Previous disagreements</button><button id="provider-disagreement-next" class="secondary" type="button">Next disagreements</button></div></div><div id="provider-disagreements"></div><div id="provider-source-audit"></div></section><p class="market-clock-note" id="record-scope" role="status" aria-live="polite"></p><details class="detail" id="record-part-details" hidden><summary>Inspect a preserved game/model report part locally</summary><p class="note">The report index preserves the total inventory. Choose one supplied part to inspect its exact row range; other parts remain unloaded. One game can have forecast versions in several parts. Files stay in this tab and no cloud object is retrieved.</p><div class="chunk-controls"><div><label for="record-part-selection">Preserved row range</label><select id="record-part-selection"></select></div><div><label for="record-part-file">Matching private JSON part · up to 64 MiB</label><input id="record-part-file" type="file" accept=".json,application/json" disabled></div></div><p class="status" id="record-part-status" role="status" aria-live="polite"></p><button id="clear-record-part" class="secondary" type="button" disabled>Clear loaded game/model part</button></details><details class="detail" id="unresolved-official-details"><summary>Unresolved official source records</summary></details><p class="market-clock-note" id="observation-scope" role="status" aria-live="polite"></p><details class="detail" id="chunk-details"><summary>Inspect bounded observation files locally</summary><p class="note">Choose an index part and one data chunk supplied with your private archive. Byte counts and SHA-256 are checked against the imported report. This page reads local files only and keeps one chunk in view; it does not retrieve cloud objects or verify the full archive from one part.</p><div class="chunk-controls"><div><label for="chunk-kind">Observation inventory</label><select id="chunk-kind"><option value="market">Captured markets</option><option value="unclassified">Unclassified native source points</option></select></div><div><label for="chunk-index-file">Index part · up to 16 MiB</label><input id="chunk-index-file" type="file" accept=".jsonl,.ndjson,application/x-ndjson" disabled></div><div><label for="chunk-data-file">Data chunk · up to 32 MiB</label><input id="chunk-data-file" type="file" accept=".jsonl,.ndjson,application/x-ndjson" disabled></div></div><p class="status" id="chunk-status" role="status" aria-live="polite"></p><button id="restore-inline" class="secondary" type="button" disabled>Show report observations</button></details><details class="detail" id="unclassified-details"><summary>Unclassified source observations</summary></details><div class="tabs" role="group" aria-label="Report view"><button id="show-games" aria-pressed="true" type="button">Games and forecasts</button><button id="show-observations" aria-pressed="false" type="button">Market observation inventory</button></div><div class="toolbar"><div class="control"><label for="league">League</label><select id="league"><option value="all">Men and women, separated</option><option value="ncaam">Men</option><option value="ncaaw">Women</option></select></div><div class="control" id="window-control"><label for="window">Report window</label><select id="window"><option value="all_observed">All observed records</option><option value="season_to_date">Season to date</option><option value="this_week">This week</option><option value="last_week">Last week</option><option value="next_week">Next week, when supplied</option></select></div><div class="control" id="model-control"><label for="model">Forecast stream shown</label><select id="model"><option value="all">Every recorded stream</option></select></div><div class="control" id="market-clock-control"><label for="market-clock">Captured price reference</label><select id="market-clock"><option value="captured_t120">Price supported by T−120</option><option value="captured_t60">Price supported by T−60</option><option value="latest_pretip" selected>Latest supported pre-tip</option><option value="captured_before_tip">Latest actually captured before tip</option><option value="latest_observed">Latest observed</option></select></div><div class="control" id="binding-control" hidden><label for="binding">Market binding</label><select id="binding"><option value="all">Bound and unresolved</option><option value="unresolved">Unresolved identity</option><option value="bound">Bound to a game</option></select></div><div class="control search"><label for="search">Find a team, source record or provider</label><input id="search" type="search" placeholder="Search this report" autocomplete="off"></div><div class="control"><label for="page-size">Rows per page</label><select id="page-size"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div></div><p class="market-clock-note" id="market-clock-note" role="status" aria-live="polite"></p><div class="pager"><p id="row-count" role="status" aria-live="polite"></p><div class="buttons"><button id="previous" class="secondary" type="button">Previous</button><button id="next" class="secondary" type="button">Next</button></div></div><div id="results"></div><details class="detail" id="metric-details"><summary>Recorded current and weekly metric populations</summary></details><details class="detail" id="horizon-details"><summary>Paired metrics by market reference horizon</summary></details><details class="detail"><summary>Report metadata, limitations and source audit</summary><pre id="metadata"></pre></details></section><footer class="foot">Private report values are supplied by the file you choose, not by the public website. Missing records, missing prices and missing forecast issues remain explicit. No wager or verified profit follows from an imported report.</footer></main><script>
'use strict';
(() => {
  const $=id=>document.getElementById(id), schema='sports-edge-lab.private.game-report.v1';
  let report=null, recordRows=[], games=[], observations=[], windowKeys={}, view='games', page=0, loadGeneration=0;
  let loadedRecordPart=null, recordGeneration=0;
  const normalizedSchema='sports-edge-lab.private.game-report.normalized.v1', indexSchema='sports-edge-lab.private.game-report.index.v1';
  const adaptedDocuments=new WeakMap();
  const number=(v,d=2)=>typeof v==='number'&&Number.isFinite(v)?v.toLocaleString('en-US',{maximumFractionDigits:d,minimumFractionDigits:d}):'Unavailable';
  const present=v=>v!==undefined&&v!==null&&v!=='';
  const text=v=>present(v)?String(v):'Unavailable';
  const label=s=>({native_frozen_recipe_reconstruction:'Frozen-recipe reconstruction',native_rolling_weekly_reconstruction:'Rolling weekly reconstruction',native_rolling_latest_available:'Rolling latest available reconstruction',original_frozen:'Original frozen issue'}[s]||s||'No recorded model');
  const identity=r=>JSON.stringify([r.league||'',r.event_id||'']);
  const node=(tag,value,cls)=>{const n=document.createElement(tag);if(value!==undefined)n.textContent=value;if(cls)n.className=cls;return n;};
  const finite=(v)=>typeof v==='number'&&Number.isFinite(v);
  const marketClocks={
    captured_t120:{label:'Price supported by T−120',note:'The supplied source observation for the two-hour reference may have been acquired later. Inspect both clocks and its supported time interval.'},
    captured_t60:{label:'Price supported by T−60',note:'The supplied source observation for the one-hour reference is separate from an eligible model/provider pair. A recovered observation keeps its actual acquisition clock.'},
    latest_pretip:{label:'Latest supported pre-tip',note:'This is the latest supplied observation whose supported source time precedes tip. It may have been recovered later. Inspect its actual capture clock; this is not a universal closing price or evidence of executable liquidity.'},
    captured_before_tip:{label:'Latest actually captured before tip',note:'This distinct view requires the source observation support and actual acquisition to precede the exact tipoff. Missing capture evidence stays unavailable; a later historical recovery is not substituted.'},
    latest_observed:{label:'Latest observed',note:'This observation may be after tip or after settlement. Its source and acquisition clocks remain visible; it cannot become an earlier forecast input.'}
  };
  const captureFields=['value','status','value_kind','quote_time','acquired_at','clock_tier','observation_support_end_upper_bound','history_resolution_seconds','provider_source_update_at','source_snapshot_time','binding_status','native_market_id','provider_product','provider_product_label','provider_product_identity_basis','semantic_status','settlement_semantics_verified','coarse_history_disclosed'];
  function appendRow(body,values){const tr=node('tr');values.forEach(v=>{const td=node('td');td.append(v instanceof Node?v:node('span',v));tr.append(td);});body.append(tr);}
  function table(headers){const wrap=node('div',undefined,'data-scroll'),t=node('table'),head=node('thead'),tr=node('tr'),body=node('tbody');headers.forEach(h=>{const th=node('th',h);th.scope='col';tr.append(th);});head.append(tr);t.append(head,body);wrap.append(t);return [wrap,body];}
  function details(title,value){const d=node('details',undefined,'detail');d.append(node('summary',title));d.addEventListener('toggle',()=>{if(d.open&&!d.querySelector('pre'))d.append(node('pre',JSON.stringify(value,null,2)));});return d;}
  const comparisonProviders=['Kalshi','Polymarket','DraftKings'];
  const comparisonSchema='sel.ncaa.b038.three_provider_report.v1';
  let providerReport=null,providerPage=0,disagreementPage=0;
  function sourceTable(name){const t=providerReport?.tables?.[name];return t&&Array.isArray(t.rows)?t:{availability:'NOT_SUPPLIED',source:t?.source||null,rows:[]};}
  function providerTableName(){return $('provider-period').value+'_'+$('provider-cohort').value;}
  function availabilityText(table){return ({NOT_SUPPLIED:'Not supplied',SUPPLIED_EMPTY:'Supplied empty',SUPPLIED:'Supplied'}[table.availability]||'Unverified source inventory');}
  function compareCount(v){return finite(v)&&Number.isInteger(v)&&v>=0?number(v,0):'Unavailable';}
  function comparisonFilters(r){const league=$('provider-league').value,target=$('provider-target').value,stream=$('provider-stream').value,week=$('provider-week').value;
    return comparisonProviders.includes(r.provider)&&(league==='all'||r.league===league)&&(target==='all'||r.target===target)&&(stream==='all'||r.track===stream)&&($('provider-period').value!=='week'||week==='all'||(week==='unknown'?!present(r.week_start_local):String(r.week_start_local)===week));}
  function comparisonRows(table){return table.rows.filter(comparisonFilters);}
  function initProviderComparisons(value){providerReport=value?.schema===comparisonSchema?value:null;providerPage=0;disagreementPage=0;
    $('provider-period').value='season';$('provider-cohort').value='provider';$('provider-league').value='all';$('provider-target').value='win';
    $('provider-stream').replaceChildren(new Option('Every recorded stream','all'));$('provider-week').replaceChildren(new Option('Every supplied week','all'));
    const rows=Object.values(providerReport?.tables||{}).flatMap(t=>Array.isArray(t.rows)?t.rows:[]);
    [...new Set(rows.map(r=>r.track).filter(present))].sort().forEach(s=>$('provider-stream').append(new Option(label(s),s)));
    [...new Set(rows.map(r=>r.week_start_local).filter(present))].sort().forEach(s=>$('provider-week').append(new Option(String(s),String(s))));
    if(rows.some(r=>!present(r.week_start_local)))$('provider-week').append(new Option('Week unavailable','unknown'));
    const audit=providerReport?{schema:value.schema,providers:value.providers,comparison_metadata:value.comparison_metadata,comparison_metadata_source:value.comparison_metadata_source,common_provider_set_verified:value.common_provider_set_verified,common_population_status:value.common_population_status,source_declared_requested_providers:value.source_declared_requested_providers,week_definition:value.week_definition,metric_definition_version:value.metric_definition_version,polymarket_us:value.polymarket_us,polymarket_product_policy:value.polymarket_product_policy,source_exports:value.source_exports,tables:Object.fromEntries(Object.entries(value.tables||{}).map(([k,t])=>[k,{availability:t.availability,source:t.source,cohort_scope:t.cohort_scope,common_provider_set_verified:t.common_provider_set_verified}])),excluded_lineage:value.excluded_lineage}:(value?{status:'UNSUPPORTED_OPTIONAL_COMPARISON_SCHEMA',source:value}:null);
    $('provider-source-audit').replaceChildren(details('Comparison source pins, definitions and preserved lineage',audit||{status:'NOT_SUPPLIED'}));renderProviderComparisons();
  }
  function comparisonMetricValues(r,prefix){const values=node('span'),fields=r.target==='win'?[['log_loss','Log loss'],['brier','Brier'],['accuracy','Accuracy'],['calibration_bias','Calibration bias'],['ece_10_fixed_bins','ECE10'],['auc','AUC']]:[['mae','MAE'],['rmse','RMSE'],['bias_prediction_minus_actual','Bias']];
    for(const [key,title]of fields){const line=node('span',title+': '+number(r[prefix+'_'+key],4),'market-metric');line.dataset.comparisonMetric=prefix+'_'+key;values.append(line);}return values;
