<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Inspect a private NCAA game report in your browser, with explicit original, rolling and market evidence clocks."><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'"><title>Private NCAA Game Report · Sports Edge Lab</title><style>
:root{--ink:#172723;--muted:#586c61;--green:#136a55;--line:#cad8cc;--paper:#f4f3ed;--white:#fffefb;--amber:#79521c}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.6 system-ui,sans-serif}main{max-width:1240px;margin:auto;padding:30px 28px 50px}header{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-bottom:24px;border-bottom:1px solid var(--line)}a{color:var(--green);text-underline-offset:4px}.brand{font-size:19px;letter-spacing:-.04em;font-weight:750;text-decoration:none;color:var(--ink)}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);font-weight:700;margin:42px 0 14px}h1{font-size:clamp(35px,5.8vw,66px);letter-spacing:-.055em;line-height:1.09;margin:0 0 23px}h2{font-size:24px;letter-spacing:-.035em;line-height:1.2;margin:0 0 14px}h3{font-size:17px;line-height:1.4;margin:0 0 12px}.intro{max-width:820px;color:var(--muted);font-size:18px}.upload{border:1px solid var(--line);border-radius:16px;padding:25px;background:var(--white);margin:25px 0}.upload label{display:block;font-weight:700;margin-bottom:10px}.upload-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap}input[type=file]{max-width:100%;font:inherit}input[type=file]::file-selector-button,button{background:var(--green);color:white;border:1px solid var(--green);padding:11px 16px;font:650 13px system-ui,sans-serif;border-radius:8px;cursor:pointer}button.secondary{color:var(--green);background:transparent}button:disabled{opacity:.45;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #39729c;outline-offset:3px}.fine{font-size:12px;color:var(--muted)}.status{margin-top:14px;overflow-wrap:anywhere;font-size:13px}.error{color:#a12f2f}.freshness-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0}.clock-card{padding:13px;background:#eef2e9;border:1px solid var(--line);border-radius:10px;min-width:0}.clock-card span{font-size:11px;color:var(--muted);display:block}.clock-card strong{display:block;font-size:12px;font-weight:600;overflow-wrap:anywhere}.chunk-controls{display:flex;gap:16px;flex-wrap:wrap;align-items:end}.chunk-controls>div{flex:1;min-width:180px;max-width:100%}.chunk-controls input{width:100%}@media(max-width:680px){.freshness-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:25px 0}.stat{padding:18px;border:1px solid var(--line);background:var(--white);border-radius:12px}.stat strong{font-size:30px;letter-spacing:-.04em;display:block;font-variant-numeric:tabular-nums}.stat span{font-size:12px;color:var(--muted)}.notice{border-left:4px solid #c49340;background:#fbefd7;padding:16px 19px;font-size:13px;margin:22px 0}.notice p{margin:5px 0}.toolbar{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin:23px 0}.control{min-width:150px;flex:1}.control.search{flex:2;min-width:210px}label{font-size:12px;font-weight:650;display:block;margin-bottom:6px}select,input[type=search]{width:100%;padding:10px 11px;font:inherit;color:var(--ink);background:var(--white);border:1px solid #a9bfae;border-radius:8px;min-height:43px}.tabs{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.tabs button[aria-pressed=false]{background:transparent;color:var(--green)}.pager{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:19px 0}.pager p{margin:0;font-size:13px;color:var(--muted)}.buttons{display:flex;gap:9px}.game{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:22px;margin:16px 0}.game-head{display:flex;justify-content:space-between;gap:18px;align-items:start}.game-head>div{min-width:0}.game-head h3{overflow-wrap:anywhere;font-size:21px;letter-spacing:-.03em;margin:4px 0}.badge{display:inline-block;font-size:10px;letter-spacing:.045em;text-transform:uppercase;font-weight:750;color:var(--green);background:#e8f0e8;border-radius:5px;padding:4px 7px;margin-right:7px}.badge.warn{color:var(--amber);background:#faefd8}.score{text-align:right;font-size:24px;letter-spacing:-.03em;font-variant-numeric:tabular-nums;min-width:100px}.score span{font-size:11px;display:block;color:var(--muted);letter-spacing:0}.source-note{font-size:12px;color:var(--muted);overflow-wrap:anywhere;margin:10px 0 16px}.data-scroll{overflow:auto;max-width:100%;border:1px solid #e1e6de;border-radius:8px;margin:13px 0}table{border-collapse:collapse;width:100%;font-size:12px}th,td{padding:10px 11px;border-bottom:1px solid #e0e6df;text-align:left;vertical-align:top}th{font-size:10px;text-transform:uppercase;letter-spacing:.035em;background:#f0f3eb;color:#50645a}tbody tr:last-child td{border:0}td{min-width:90px}td:first-child{min-width:165px}td small{display:block;font-size:10px;color:var(--muted);max-width:230px;overflow-wrap:anywhere}.market-entry+.market-entry{border-top:1px solid var(--line);margin-top:11px;padding-top:11px}.market-entry{display:block}.market-clock-note{border:1px solid var(--line);background:#edf3ec;padding:13px 16px;border-radius:10px;font-size:12px;color:var(--muted)}.market-clock-note strong{color:var(--ink)}.market-metric{display:block;white-space:nowrap}.missing{color:#79521c}.note{font-size:12px;color:var(--muted);margin:9px 0}.detail{border-top:1px solid var(--line);margin-top:15px;padding-top:13px}summary{color:var(--green);font-weight:650;font-size:13px;cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.6 ui-monospace,monospace;max-height:480px;overflow:auto;background:#f1f3ec;padding:14px;border-radius:8px}.empty{padding:40px 20px;text-align:center;border:1px dashed var(--line);border-radius:13px;color:var(--muted)}.observation{padding:18px;background:var(--white);border:1px solid var(--line);border-radius:11px;margin:12px 0}.observation h3{overflow-wrap:anywhere}.provider-review{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px 0;margin:25px 0}.provider-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.provider-card{border:1px solid var(--line);border-radius:12px;background:var(--white);padding:17px;min-width:0}.provider-card h3{margin:0 0 9px}.provider-availability{color:var(--green);font-size:13px}.comparison-population{border:1px solid var(--line);border-radius:12px;padding:17px;margin:14px 0;background:var(--white)}.comparison-population h3{overflow-wrap:anywhere}.provider-review .source-note{overflow-wrap:anywhere}@media(max-width:680px){.provider-grid{grid-template-columns:1fr}.provider-card{padding:14px}.comparison-population{padding:13px}}.foot{border-top:1px solid var(--line);font-size:11px;color:var(--muted);margin-top:36px;padding-top:22px}.sr{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:680px){main{padding:23px 17px 35px}.intro{font-size:16px}.summary-grid{grid-template-columns:repeat(2,1fr)}.stat{padding:14px}.stat strong{font-size:26px}.game{padding:16px}.game-head{flex-direction:column;gap:10px}.score{text-align:left}.score span{display:inline;margin-left:9px}.toolbar{gap:10px}.control{min-width:135px}.upload{padding:19px}.eyebrow{margin-top:30px}h1{font-size:40px}.tabs button{flex:1}td:first-child{min-width:140px}}
.workspace-nav{display:flex;gap:14px;flex-wrap:wrap;margin:20px 0;padding:12px 0;border-bottom:1px solid var(--line);font-size:12px;font-weight:650}.coverage-workspace{padding-top:24px;margin-top:22px;border-top:1px solid var(--line)}.coverage-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.coverage-kpis strong{font-size:21px}.coverage-shortcut{font-size:11px;padding:6px 9px;margin-top:8px}.comparison-forecast{min-width:220px;max-width:300px}.comparison-forecast p{margin:6px 0}.comparison-forecast .missing{font-weight:650}.comparison-forecast strong{font-size:13px}.comparison-table td{min-width:230px}.comparison-table th{position:sticky;top:0}.comparison-table .detail-button{font-size:11px;padding:7px 9px;margin-top:8px}.season-table th{position:sticky;top:0;z-index:1}.season-table td{max-width:250px;min-width:130px}.season-table td:first-child{min-width:220px}.season-table td:last-child{min-width:240px;line-height:1.5}.season-table strong{display:block}.season-table{max-height:720px}#model-scorecards{scroll-margin-top:20px}#model-metrics td:first-child{max-width:250px;overflow-wrap:anywhere}@media(max-width:680px){.coverage-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.workspace-nav{gap:10px}.coverage-workspace h2{font-size:22px}}code{overflow-wrap:anywhere}.eligibility-card{overflow-wrap:anywhere}#v4-review{overflow-wrap:anywhere}
</style></head><body><main><header><a class="brand" href="../index.html">Sports Edge Lab</a><nav aria-label="Basketball reviews"><a href="https://alvaro-ncaa-research-review.alv-mendizabal.chatgpt.site/tracks/ncaam/index.html">Men's review</a> · <a href="https://alvaro-ncaa-research-review.alv-mendizabal.chatgpt.site/tracks/ncaaw/index.html">Women's review</a></nav></header><p class="eyebrow">NCAA · Personal report viewer</p><h1>Every supplied game.<br>Every forecast visible.</h1><p class="intro">Open your NCAA report for the season inventory, an original-versus-rolling comparison, three-provider evidence, and a specific recovery action for each missing capability. Every supplied game remains inspectable. Your data stays in this browser tab.</p>__V4_REVIEW_PANEL__<section class="upload" aria-label="Open a private report"><label for="report-file">Choose your NCAA dashboard JSON file</label><div class="upload-row"><input id="report-file" type="file" accept=".json,application/json"><button class="secondary" id="clear" type="button" disabled>Clear report</button></div><p class="fine" id="source-report-choice">For the current actual owner checkpoint, choose <strong>B053_CURRENT_DASHBOARD_DATA.json</strong>. Its supplied model and source records remain a pre-study partial report; it is not the completed V4 rolling ledger. The separately loaded schedule and eligibility panels retain their own dates. For the dated actual B052 source-only snapshot, choose <strong>B052_SOURCE_SNAPSHOT_DASHBOARD_DATA.json</strong>: 2,446 source game rows, zero supplied model predictions, 1,113 numeric-final source rows and 58 missing event clocks. Its exact physical pin is 10,923,449 bytes / SHA-256 <code>48ee10338c5259bcac077683be4f42fab897c6a913b8010bc2e4d0ead154d821</code>. This is the unchanged owner member <code>reports/initial_current_coverage/B037_DASHBOARD_DATA.json</code> under a delivery filename. Selecting it replaces the report currently shown; it does not join the old model denominator. For the older scientific baseline, choose B046_PRIVATE_DASHBOARD_DATA.json from the supplied downloads. Then open B047R1_PRIVATE_IDENTITY_OVERLAY.json in the identity-overlay section below. These are the retained baseline and matching overlay; their original source dates remain in force. Do not choose the executable PYZ or return ZIP. Files up to 64 MiB. The page does not upload, save, or transmit the imported report. Reloading or clearing removes the in-memory view.</p><p class="status" id="load-status" role="status" aria-live="polite">No report loaded. The public review remains available above.</p></section><section id="schedule-review" class="provider-review" aria-labelledby="schedule-title"><h2 id="schedule-title">Full-season schedule observations</h2><p class="note" id="schedule-owner-status"><strong>Actual B052 return:</strong> five stages completed before a run-level coverage-summary bound failure; no new forecast or model improvement is credited. The owner-produced <strong>B052_FULL_SEASON_SCHEDULE_COMPACT.json</strong> contains all 23,603 retained provider-native IDs in <strong>4,744,902 bytes</strong>, SHA-256 <code>48a0504151d2993195f2ced268f256895ad1d5cc5affda27587c84f28ff5f766</code>. The B051 source-index owner, source version and original clocks remain intact. The earlier 4,744,935-byte assistant projection stays separate. <strong>2,520 exact tip times remain null</strong>, with 39 ambiguous date responses and 110 rejected source records. Loading every retained source ID does not certify a complete physical season or supply a missing model forecast. Inspect the separate <a href="#eligibility-review">per-game input eligibility ledger</a> for the exact current rejection reasons.</p><p class="note">Open the separate schedule export to inspect games beyond the retained forecast window. These are provider-native records: two providers may describe the same physical game. This panel does not join them, add predictions, or change the baseline report and its metrics.</p><div class="upload-row"><div><label for="schedule-file">Optional schedule JSON or compact projection · up to 25 MiB</label><input id="schedule-file" type="file" accept=".json,application/json"></div><button id="clear-schedule" class="secondary" type="button" disabled>Clear schedule</button></div><p id="schedule-load-status" class="status" role="status" aria-live="polite">No full-season schedule export loaded. Its absence does not establish that no games are scheduled.</p><div id="schedule-content" hidden><div id="schedule-summary"></div><div id="schedule-provider-counts"></div><div class="toolbar"><div class="control"><label for="schedule-provider">Schedule provider</label><select id="schedule-provider"><option value="all">Both providers, kept separate</option><option value="espn">ESPN</option><option value="ncaa_official">NCAA official</option></select></div><div class="control"><label for="schedule-league">Schedule gender</label><select id="schedule-league"><option value="all">Men and women, kept separate</option><option value="ncaam">Men</option><option value="ncaaw">Women</option></select></div><div class="control"><label for="schedule-date">Event date · UTC</label><select id="schedule-date"><option value="all">All dates, including missing times</option><option value="missing">Missing exact tip time</option></select></div><div class="control search"><label for="schedule-search">Find a team, source ID or missing-data reason</label><input id="schedule-search" type="search" placeholder="Search schedule records"></div><button id="reset-schedule-filters" class="secondary" type="button">Show all schedule records</button></div><p class="note">Date filters use an exact reported event time. A source query date does not substitute for a missing tipoff. All forecast fields in this separate inventory are null; schedule capture does not establish prediction eligibility or a complete official season.</p><div class="pager"><p id="schedule-count" role="status" aria-live="polite"></p><div class="buttons"><button id="schedule-previous" class="secondary" type="button" disabled>Previous schedule records</button><button id="schedule-next" class="secondary" type="button" disabled>Next schedule records</button></div></div><div id="schedule-records"></div><div id="schedule-source-proof"></div></div></section><section id="eligibility-review" class="provider-review" aria-labelledby="eligibility-title">
<h2 id="eligibility-title">Why a source game has no current forecast</h2>
<p class="note">Open the separately supplied <strong>B047R1_current_eligibility_ledger.json</strong> from the actual B052 return. Its 1,793 exact source identities account for 1,322 input-gate passes, 445 rejected feature rows and 26 games without a feature row. Every supplied reason stays visible. A passed input gate does not establish a forecast, admitted model issue or provider comparison. The older 447 rejection reasons were not retained per game and are not reconstructed here.</p>
<div class="upload"><label for="eligibility-file">Private per-game input eligibility ledger · up to 8 MiB</label><input id="eligibility-file" type="file" accept=".json,application/json"><button id="clear-eligibility" class="secondary" type="button" disabled>Clear eligibility ledger</button></div>
<p id="eligibility-load-status" class="status" role="status" aria-live="polite">No eligibility ledger selected. This independent view does not change the schedule or baseline.</p>
<div id="eligibility-content" hidden><div id="eligibility-summary"></div><div id="eligibility-reasons"></div>
<div class="toolbar"><div class="control"><label for="eligibility-league">Eligibility gender</label><select id="eligibility-league"><option value="all">Both genders</option><option value="ncaam">Men</option><option value="ncaaw">Women</option></select></div>
<div class="control"><label for="eligibility-status">Input gate state</label><select id="eligibility-status"><option value="all">All supplied states</option><option value="CURRENT_MODEL_GATE_PASSED">Input gate passed</option><option value="CURRENT_MODEL_GATE_REJECTED">Feature row rejected</option><option value="NO_CURRENT_FEATURE_ROW">No current feature row</option></select></div>
<div class="control"><label for="eligibility-reason">Recorded failure reason</label><select id="eligibility-reason"><option value="all">Every recorded reason</option></select></div><div class="control search"><label for="eligibility-search">Find an exact source ID or reason</label><input id="eligibility-search" type="search" placeholder="Source identity or recorded reason" autocomplete="off"></div></div>
<button id="reset-eligibility-filters" class="secondary" type="button">Show every loaded eligibility row</button>
<div class="pager"><p id="eligibility-count" role="status" aria-live="polite"></p><div class="buttons"><button id="eligibility-previous" class="secondary" type="button" disabled>Previous eligibility rows</button><button id="eligibility-next" class="secondary" type="button" disabled>Next eligibility rows</button></div></div><div id="eligibility-records"></div><div id="eligibility-source-proof"></div></div></section><section id="report" hidden aria-label="Imported report"><nav class="workspace-nav" aria-label="Research workspace"><a href="#show-season">Season inventory</a><a href="#model-scorecards">Model scorecards</a><a href="#provider-review">Provider comparisons</a><a href="#coverage-workspace">Recovery queue</a><a href="#identity-overlay-section">Source identity links</a><a href="#injury-source-section">Player availability</a></nav><div class="summary-grid" id="summary"></div><section aria-label="Separate report and source clocks"><h2>Season and update clocks</h2><div class="freshness-grid" id="freshness-grid"></div><p class="note">The season end year is a label. Missing acquisition, issue or refresh times remain unavailable; report generation does not replace those clocks.</p></section><div class="notice"><strong id="asof"></strong><p>Counts refer to distinct source records. Unmatched official candidates can duplicate other records; an official season denominator remains a separate requirement.</p><p>Prices supported at T−120, T−60, pre-tip and latest observed prices are display evidence. Source time and actual capture time are distinct. The recorded model/provider pair has its own eligibility status. Changing the displayed price cannot rewrite an earlier model input, issue, selection, or return. An exchange threshold price is not an expected point total.</p><p id="qualifications"></p></div><section id="identity-overlay-section" class="provider-review" aria-labelledby="identity-overlay-title"><h2 id="identity-overlay-title">Source identity links</h2><p class="note">Open the separately supplied identity overlay for this exact baseline report. Compare original source IDs with source-audited game groups without deleting versions or creating forecast values.</p><div class="upload-row"><div><label for="identity-overlay-file">Optional private identity overlay JSON · up to 48 MiB</label><input id="identity-overlay-file" type="file" accept=".json,application/json"></div><button class="secondary" id="clear-identity-overlay" type="button" disabled>Clear identity overlay</button></div><p id="identity-overlay-status" class="status" role="status" aria-live="polite">No overlay loaded. Open the exact baseline report, then its separately supplied identity overlay.</p><div class="pager"><p id="identity-overlay-count" role="status" aria-live="polite">No identity links loaded. Source-game counts retain their original meaning.</p><div class="buttons"><button id="identity-overlay-previous" class="secondary" type="button" disabled>Previous identity links</button><button id="identity-overlay-next" class="secondary" type="button" disabled>Next identity links</button></div></div><div id="identity-overlay-results"></div></section><p class="market-clock-note" id="record-scope" role="status" aria-live="polite"></p><details class="detail" id="record-part-details" hidden><summary>Inspect a preserved game/model report part locally</summary><p class="note">The report index preserves the total inventory. Choose one supplied part to inspect its exact row range; other parts remain unloaded. One game can have forecast versions in several parts. Files stay in this tab and no cloud object is retrieved.</p><div class="chunk-controls"><div><label for="record-part-selection">Preserved row range</label><select id="record-part-selection"></select></div><div><label for="record-part-file">Matching private JSON part · up to 64 MiB</label><input id="record-part-file" type="file" accept=".json,application/json" disabled></div></div><p class="status" id="record-part-status" role="status" aria-live="polite"></p><button id="clear-record-part" class="secondary" type="button" disabled>Clear loaded game/model part</button></details><details class="detail" id="unresolved-official-details"><summary>Unresolved official source records</summary></details><p class="market-clock-note" id="observation-scope" role="status" aria-live="polite"></p><details class="detail" id="chunk-details"><summary>Inspect bounded observation files locally</summary><p class="note">Choose an index part and one data chunk supplied with your private archive. Byte counts and SHA-256 are checked against the imported report. This page reads local files only and keeps one chunk in view; it does not retrieve cloud objects or verify the full archive from one part.</p><div class="chunk-controls"><div><label for="chunk-kind">Observation inventory</label><select id="chunk-kind"><option value="market">Captured markets</option><option value="unclassified">Unclassified native source points</option></select></div><div><label for="chunk-index-file">Index part · up to 16 MiB</label><input id="chunk-index-file" type="file" accept=".jsonl,.ndjson,application/x-ndjson" disabled></div><div><label for="chunk-data-file">Data chunk · up to 32 MiB</label><input id="chunk-data-file" type="file" accept=".jsonl,.ndjson,application/x-ndjson" disabled></div></div><p class="status" id="chunk-status" role="status" aria-live="polite"></p><button id="restore-inline" class="secondary" type="button" disabled>Show report observations</button></details><details class="detail" id="unclassified-details"><summary>Unclassified source observations</summary></details><div class="tabs" role="group" aria-label="Report view"><button id="show-season" aria-pressed="true" type="button">Season table</button><button id="show-comparison" aria-pressed="false" type="button">Original vs per-game rolling</button><button id="show-games" aria-pressed="false" type="button">Detailed games</button><button id="show-observations" aria-pressed="false" type="button">Market observation inventory</button></div><p class="note" id="filter-scope" role="status" aria-live="polite"></p><button id="reset-game-filters" class="secondary" type="button">Show all loaded games</button> <button id="export-game-inventory" class="secondary" type="button">Export filtered game inventory</button><p class="note" id="inventory-export-status" role="status" aria-live="polite"></p><div class="toolbar"><div class="control"><label for="league">League</label><select id="league"><option value="all">Men and women, separated</option><option value="ncaam">Men</option><option value="ncaaw">Women</option></select></div><div class="control" id="window-control"><label for="window">Report window</label><select id="window"><option value="all_observed">All observed records</option><option value="season_to_date">Season to date</option><option value="this_week">This week</option><option value="last_week">Last week</option><option value="next_week">Next week, when supplied</option></select></div><div class="control" id="model-control"><label for="model">Forecast stream shown</label><select id="model"><option value="all">Every recorded stream</option></select></div><div class="control" id="market-clock-control"><label for="market-clock">Captured price reference</label><select id="market-clock"><option value="captured_t120">Price supported by T−120</option><option value="captured_t60">Price supported by T−60</option><option value="latest_pretip" selected>Latest supported pre-tip</option><option value="captured_before_tip">Latest actually captured before tip</option><option value="latest_observed">Latest observed</option></select></div><div class="control" id="binding-control" hidden><label for="binding">Market binding</label><select id="binding"><option value="all">Bound and unresolved</option><option value="unresolved">Unresolved identity</option><option value="bound">Bound to a game</option></select></div><div class="control" id="se