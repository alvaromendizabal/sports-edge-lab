rows('terminal-market-match',Object.entries(S.b003_matched_polymarket_comparison.metrics).map(([k,v])=>'<tr>'+td(metric(k))+td(numMetric(k,v.candidate))+td(numMetric(k,v.reference))+td(f(v.candidate_minus_reference))+'</tr>'));
