(()=>{'use strict';const D=JSON.parse(document.getElementById('terminal-data').textContent),S=D.science,$=id=>document.getElementById(id);const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const f=(v,n=4)=>typeof v==='number'&&Number.isFinite(v)?v.toFixed(n):'—';const league=x=>x==='ncaam'?'Men':'Women';const season=y=>`${y-1}–${String(y).slice(-2)}`;const metric=x=>String(x).replaceAll('_',' ');const numMetric=(k,v)=>k==='accuracy'&&typeof v==='number'?(v*100).toFixed(2)+'%':f(v);const rows=(id,values)=>{$(id).querySelector('tbody').innerHTML=values.join('')};const td=(s,small='')=>`<td>${esc(s)}${small?`<small>${esc(small)}</small>`:''}</td>`;const targetName=t=>t==='win'?'Win probability':t==='margin'?'Home margin':'Total points';
function renderRoles(){const list=S[$('terminal-role-kind').value].filter(r=>$('terminal-role-league').value==='all'||r.league===$('terminal-role-league').value);rows('terminal-role-table',list.map(r=>'<tr>'+td(league(r.league))+td(targetName(r.target),metric(r.metric))+td(r.public_model_id,r.model_family)+td(numMetric(r.metric,r.value))+td(r.games.toLocaleString(),r.games_by_season?Object.entries(r.games_by_season).map(([s,n])=>season(+s)+': '+n).join(' / '):'Frozen 2024–25 + 2025–26')+td('Research selection; no promotion',r.development_exposed?'Development exposed · independent confirmation absent':'Exposed historical role')+'</tr>'))}
function metricCells(m){return['accuracy','log_loss','brier','mae','rmse'].map(k=>td(numMetric(k,m[k]))).join('')}
function renderSeason(){const filtered=S.per_season_selected_model_metrics.filter(r=>($('terminal-season-filter').value==='all'||String(r.season_end_year)===$('terminal-season-filter').value)&&($('terminal-season-league').value==='all'||r.league===$('terminal-season-league').value)&&($('terminal-season-target').value==='all'||r.target===$('terminal-season-target').value));rows('terminal-season-table',filtered.map(r=>'<tr>'+td(season(r.season_end_year)+' / '+league(r.league))+td(r.public_model_id,targetName(r.target))+td(r.games)+metricCells(r.metrics)+td(r.evaluation_mode||r.status,'No automatic promotion')+'</tr>'))}
rows('terminal-b003-table',S.current_original_b003_metrics.map(r=>'<tr>'+td(league(r.league)+' / '+targetName(r.target))+td(r.games)+metricCells(r.metrics)+td(r.target==='win'?'ECE '+f(r.metrics.ece_10_fixed_bins)+' / bias '+f(r.metrics.calibration_bias):'—')+'</tr>'));
rows('terminal-current-table',S.current_descriptive_metric_leaders.map(r=>'<tr>'+td(league(r.league))+td(targetName(r.target),metric(r.metric))+td(r.public_model_ids.join(' · '),'Descriptive leader; no selection authority')+td(numMetric(r.metric,r.value))+td(r.games)+td(r.evaluation_mode)+'</tr>'));
rows('terminal-overlap-table',D.inspected_comparison.combined_retained_vs_core_roles.map(r=>'<tr>'+td(league(r.league)+' / '+targetName(r.target),metric(r.metric))+td(numMetric(r.metric,r.retained_value),r.retained_public_model_id)+td(numMetric(r.metric,r.core_value),r.core_public_model_id)+td(r.numerically_better_reported_role,'No paired cross-study uncertainty')+td(r.games)+'</tr>'));
