function showDetails(k){const g=G.get(k),rr=selected(g);$('terminal-game-detail').textContent=JSON.stringify({game_identity:g,view:$('terminal-game-mode').selectedOptions[0].text,original_or_replay_rows:rr,qualification:rr.length?'Original issue clocks and reconstruction clocks remain separate. Displayed values do not recompute headline scores.':'No verified selected output in this view; prediction values remain unavailable.'},null,2);$('terminal-game-detail-box').open=true}
function renderGames(reset=false){if(reset)page=0;current=games.filter(matches);page=Math.max(0,Math.min(page,Math.max(0,Math.ceil(current.length/perpage)-1)));const shown=current.slice(page*perpage,(page+1)*perpage);rows('terminal-game-table',shown.length?shown.map(g=>{const rr=selected(g);return'<tr>'+td(league(g.league)+' · '+g.away_team+' at '+g.home_team,g.event_id)+td(g.event_time||'TBD',g.time_precision||'Unknown precision')+td(forecast(rr,'win'))+td(forecast(rr,'margin'))+td(forecast(rr,'total'))+td(rr.length?rr.length+' selected target rows':'No verified output',g.source_binding_status)+`<td><button data-terminal-detail="${esc(key(g))}">Inspect</button></td></tr>`}):['<tr><td colspan="7" class="empty">No saved records match these filters.</td></tr>']);$('terminal-game-count').textContent=current.length.toLocaleString()+' of '+games.length.toLocaleString()+' observed source records · '+$('terminal-game-mode').selectedOptions[0].text;$('terminal-game-page').textContent='Page '+(page+1)+' of '+Math.max(1,Math.ceil(current.length/perpage));$('terminal-game-prev').disabled=page===0;$('terminal-game-next').disabled=(page+1)*perpage>=current.length;document.querySelectorAll('[data-terminal-detail]').forEach(b=>b.onclick=()=>showDetails(b.dataset.terminalDetail))}
for(const id of ['terminal-role-kind','terminal-role-league'])$(id).onchange=renderRoles;for(const id of ['terminal-season-filter','terminal-season-league','terminal-season-target'])$(id).onchange=renderSeason;for(const id of ['terminal-game-mode','terminal-game-league','terminal-game-state'])$(id).onchange=()=>renderGames(true);$('terminal-game-search').oninput=()=>renderGames(true);$('terminal-game-prev').onclick=()=>{page--;renderGames()};$('terminal-game-next').onclick=()=>{page++;renderGames()};$('terminal-game-reset').onclick=()=>{$('terminal-game-mode').value='recovered_native_original';$('terminal-game-league').value='all';$('terminal-game-state').value='with';$('terminal-game-search').value='';renderGames(true)};document.querySelectorAll('[data-terminal-issue]').forEach(b=>b.onclick=()=>{$('terminal-game-mode').value='recovered_native_original';$('terminal-game-state').value='with';$('terminal-game-league').value='all';$('terminal-game-search').value='';renderGames(true);showDetails(b.dataset.terminalIssue);$('terminal-game-detail-box').scrollIntoView({block:'center',behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'})});
const csvCell=v=>{let s=String(v??'');if(/^[=+@\-\t\r]/.test(s))s="'"+s;return'"'+s.replaceAll('"','""')+'"'};$('terminal-game-download').onclick=()=>{const cols=['league','event_id','event_time','away_team','home_team','view','home_win','home_margin','total','source_state'];const body=[cols,...current.map(g=>[g.league,g.event_id,g.event_time,g.away_team,g.home_team,$('terminal-game-mode').value,forecast(selected(g),'win'),forecast(selected(g),'margin'),forecast(selected(g),'total'),g.source_binding_status])].map(r=>r.map(csvCell).join(',')).join('\r\n');const url=URL.createObjectURL(new Blob([body],{type:'text/csv;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='ncaa_b063_terminal_selected_outputs.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
$('terminal-provenance').textContent=JSON.stringify({evidence_asof:S.evidence_asof,display_asof:D.display_asof_utc,terminal_return_sha256:D.terminal_return_sha256,prior_publication_commit:D.prior_publication_commit,source_reports:D.source_reports,execution:D.execution,native_issue_summary:D.native_issue_summary,scope_notes:D.scope_notes,limitations:S.limitations},null,2);renderRoles();renderSeason();renderGames();
})();
</script>
