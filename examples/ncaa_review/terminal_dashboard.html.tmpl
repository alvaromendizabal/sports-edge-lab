const games=D.games.map(r=>Object.fromEntries(D.game_columns.map((k,i)=>[k,r[i]]))),replay=D.replay.map(r=>Object.fromEntries(D.replay_columns.map((k,i)=>[k,r[i]])));const time=x=>Number.isFinite(Date.parse(x))?Date.parse(x):String(x||'');const key=r=>[r.league,r.event_id,time(r.event_time)].join('|');const G=new Map(games.map(g=>[key(g),g]));const group=new Map();D.issues.filter(r=>r.display_evidence_mode==='recovered_native_original').forEach(r=>{if(!group.has(key(r)))group.set(key(r),[]);group.get(key(r)).push(r)});
