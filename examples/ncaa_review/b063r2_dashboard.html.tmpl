 const hs=S.historical_per_season_leaders.filter(r=>matches(r,true,true));table('season-leaders',['League','Season','Target','Metric','Value','Games','Leader(s)','Candidates','Cohort hash'],leaderRows(hs,true),'Historical season-specific metric leaders');byId('season-leader-count').textContent=hs.length+' of '+S.historical_per_season_leaders.length+' season-leader rows shown.';
