 const current=S.current_observed_replay_leaders.filter(r=>matches(r,false,true));table('current-leaders',['League','Season','Target','Metric','Value','Games','Descriptive leader(s)','Tracks','Cohort hash'],leaderRows(current,false),'Current observed replay metric leaders');byId('current-count').textContent=current.length+' of '+S.current_observed_replay_leaders.length+' current replay leader rows shown. These are separate from original-issued monitoring.';
