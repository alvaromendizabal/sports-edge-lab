function matches(r,withSeason=false,withMetric=false){const l=byId('league').value,y=byId('season').value,o=byId('objective').value,q=byId('query').value.trim().toLowerCase();if(l!=='all'&&r.league!==l)return false;if(withSeason&&y!=='all'&&String(r.season_end_year)!==y)return false;if(o!=='all'){const[t,m]=o.split(':');if(r.target!==t)return false;if(withMetric&&r.metric!==m)return false;}if(q&&!JSON.stringify(r).toLowerCase().includes(q))return false;return true;}
