<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="NCAA basketball execution evidence: preserved work, repeat costs, recovery gaps and measured worker throughput.">
<title>NCAA execution and recovery · Sports Edge Lab</title>
<style>
:root{color-scheme:light;--ink:#142c27;--muted:#52675e;--green:#11694f;--paper:#f4f5ef;--line:#c8d6cc;--amber:#8b4b13}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 system-ui,sans-serif}main{max-width:1180px;margin:auto;padding:28px 30px 60px}a{color:var(--green);text-underline-offset:3px}a:focus-visible,button:focus-visible,select:focus-visible{outline:3px solid #236f9a;outline-offset:4px}header{display:flex;gap:20px;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:20px}.brand{font-weight:750;color:var(--ink);text-decoration:none;letter-spacing:-.025em}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:750;color:var(--green);margin:38px 0 10px}h1{font-size:clamp(36px,5vw,61px);letter-spacing:-.055em;line-height:1.08;margin:0 0 22px;max-width:950px}h2{font-size:26px;letter-spacing:-.03em;line-height:1.25;margin:0 0 15px}h3{font-size:17px;margin:0 0 10px}.lede{max-width:880px;font-size:19px;color:var(--muted)}.fine{font-size:13px;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin:30px 0}.card{padding:22px;background:#fffefb;border:1px solid var(--line);border-radius:14px}.card .label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:700}.card .value{font-size:34px;line-height:1.15;letter-spacing:-.04em;font-weight:720;margin:12px 0}.card p{font-size:13px;margin:12px 0 0}.alert{padding:22px 24px;border:1px solid #ddc49b;background:#fff2db;border-radius:13px;margin:25px 0}.alert strong{color:var(--amber)}section.panel{margin-top:28px;padding:26px;background:#fffefb;border:1px solid var(--line);border-radius:15px}.split{display:grid;grid-template-columns:1fr 1fr;gap:22px}.controls{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:20px 0}.controls label{font-size:13px;font-weight:650}select,button,.button{font:inherit;border:1px solid #95afa0;border-radius:7px;background:#fffefb;color:var(--ink);padding:8px 12px}.button{text-decoration:none;font-size:13px;display:inline-block}button{cursor:pointer}.table-scroll{overflow:auto;max-width:100%;border:1px solid var(--line);border-radius:8px}table{border-collapse:collapse;min-width:900px;width:100%;font-size:13px}caption{text-align:left;padding:12px;font-weight:600}th{text-align:left;background:#edf2eb;font-size:11px;letter-spacing:.02em}th,td{padding:12px;vertical-align:top;border-bottom:1px solid #d9e2da}tr:last-child td{border:0}td.numeric,th.numeric{text-align:right;font-variant-numeric:tabular-nums}td.scope{min-width:235px;max-width:310px}.badge{display:inline-block;font-size:11px;font-weight:650;padding:2px 7px;background:#f9ead6;border-radius:4px;color:#7b461c}.legend{font-size:12px;color:var(--muted)}.facts{display:grid;grid-template-columns:1fr auto;gap:9px 18px;margin:16px 0}.facts dt{color:var(--muted);font-size:13px}.facts dd{margin:0;text-align:right;font-weight:650;font-variant-numeric:tabular-nums}.facts .wide{text-align:left;font-weight:400}.meter{height:14px;border-radius:8px;background:#e7ede6;position:relative;margin:22px 0 8px;overflow:visible}.meter-fill{height:100%;background:#9a541a;border-radius:8px;width:0}.meter-target{position:absolute;height:25px;border-left:2px solid var(--green);left:75%;top:-6px}.metric{font-size:36px;letter-spacing:-.05em;font-weight:730;color:var(--amber)}.metric small{font-size:16px;letter-spacing:0}.steps{padding-left:23px}.steps li{margin:12px 0}details{margin:16px 0}summary{cursor:pointer;font-size:14px;font-weight:650}code{font-size:12px;overflow-wrap:anywhere}.hashes{font-size:12px;display:grid;gap:14px}.hashes p{margin:0}.pill{display:inline-block;font-size:12px;background:#e6f0e8;padding:4px 8px;border-radius:5px}footer{font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:20px;margin-top:32px}.empty{padding:15px;color:var(--muted)}[hidden]{display:none!important}@media(max-width:760px){main{padding:20px 16px 36px}header{align-items:flex-start;font-size:12px}.cards,.split{grid-template-columns:1fr}.cards{gap:10px}.card{padding:19px}.card .value{font-size:30px}.lede{font-size:17px}section.panel{padding:19px}.controls{align-items:flex-start;flex-direction:column}select{width:100%}h1{font-size:40px}.alert{padding:18px}.facts{grid-template-columns:1fr 1fr}h2{font-size:23px}}
</style>
</head>
<body><main>
<header><a class="brand" href="index.html">Sports Edge Lab · NCAA basketball</a><a href="three_seasons.html">Preserved model comparison ↗</a></header>
<p class="eyebrow">Execution and recovery evidence</p>
<h1>See what ran.<br>Keep what finished.</h1>
<p class="lede">A failed stage does not mean every earlier task was repeated. This review shows the observed execution, the last verified return, and the work that remains recoverable as separate facts.</p>
<p id="snapshot-time" class="fine"></p>
<div id="data-error" class="alert" hidden><strong>Execution evidence could not be validated.</strong><p>No older or differently scoped counts were substituted.</p></div>
<div id="report">
<div class="cards">
<article class="card"><div class="label">Newest observed attempt</div><div class="value" id="observed-release"></div><span class="badge" id="observed-status"></span><p id="observed-copy"></p></article>
<article class="card"><div class="label">Last fully verified return</div><div class="value" id="verified-release"></div><span class="pill">Integrity verified · science incomplete</span><p id="verified-copy"></p></article>
<article class="card"><div class="label">New fits preserved in audited attempts</div><div class="value" id="preserved-fits"></div><span class="pill">Physical target-estimator commits</span><p id="preserved-copy"></p></article>
</div>
<div class="alert"><strong id="resume-headline"></strong><p id="resume-explanation"></p></div>
<section class="panel" aria-labelledby="attempt-title"><h2 id="attempt-title">Work by execution attempt</h2>
<p>New fits, restored checkpoints and engineering tests use different counters. A checkpoint reuse is an access to saved work; it is not another optimization. A blank observation stays unknown.</p>
<div class="controls"><label for="attempt-filter">Show attempts</label><select id="attempt-filter"><option value="all">All audited attempts</option><option value="RESEARCH">Reached model fitting</option><option value="BEFORE_FIT">Stopped before model fitting</option><option value="unpublished">Unpublished recovery evidence</option></select><button id="download-report" type="button">Download exact public report</button></div>
<p id="attempt-count" class="fine" aria-live="polite"></p>
<div class="table-scroll" tabindex="0" aria-label="Scrollable execution attempt table"><table><thead><tr><th scope="col">Attempt</th><th scope="col">Outcome and stopping point</th><th scope="col" class="numeric">New target fits</th><th scope="col" class="numeric">Historical checkpoint reuses</th><th scope="col" class="numeric">Fresh / reused startup tests</th><th scope="col" class="numeric">Elapsed</th><th scope="col">Preserved work and limits</th></tr></thead><tbody id="attempt-rows"></tbody></table></div>
<p class="legend">This is a scoped audit of the listed attempts, not a project-lifetime total. Reuse counts can refer to the same historical artifacts across executions and must not be summed into unique models. Elapsed time includes non-fitting work.</p></section>
<section class="panel" aria-labelledby="repeat-title"><h2 id="repeat-title">Why the same stage name can appear again</h2><div class="split"><article><h3>Known repetition and its cost</h3><p id="repeat-copy"></p><dl id="retry-facts" class="facts"></dl><p class="fine">CPU seconds, wall seconds and billed dollars measure different things. Shared-instance cost estimates are not invoices or costs attributable only to estimator fitting.</p></article><article><h3>What recovery must preserve</h3><ol id="resume-steps" class="steps"></ol><p class="fine">These are the required continuation rules. They do not assert that every remaining dependency is cached or that the next execution has completed.</p></article></div></section>
<section class="panel" aria-labelledby="throughput-title"><h2 id="throughput-title">Worker settings are not measured throughput</h2><div class="split"><article><div id="occupancy" class="metric"></div><div class="meter" role="img" id="occupancy-meter"><div id="occupancy-fill" class="meter-fill"></div><div class="meter-target"></div></div><p id="occupancy-caption" class="fine"></p><p id="throughput-copy"></p></article><article><h3>Next-run acceptance remains open</h3><p id="throughput-next"></p><dl id="throughput-facts" class="facts"></dl><p class="fine">Synthetic queue tests, package checks and authentication CPU do not establish sustained scientific utilization. A short completed workload cannot establish a three-minute occupancy gate.</p></article></div></section>
<section class="panel" aria-labelledby="science-title"><h2 id="science-title">Scientific results retain their original limits</h2><div class="split"><article><h3>Separate men’s and women’s evaluations</h3><p id="science-copy"></p><p><a class="button" href="three_seasons.html">Open preserved comparisons →</a></p><p class="fine">The linked comparison is dated evidence. This execution report does not replace missing forecasts, certify complete official game denominators, or issue a new champion.</p></article><article><h3>Source progress is also resumable</h3><p id="source-copy"></p><p id="source-limits" class="fine"></p></article></div></section>
<section class="panel" aria-labelledby="evidence-title"><h2 id="evidence-title">Evidence and publication state</h2><p id="publication-copy"></p><div id="evidence-hashes" class="hashes"></div><details><summary>What this public report leaves private</summary><p>Owner execution packages, complete recovery manifests, model bodies, active feature transforms, source payloads and private storage locations remain outside this public projection. A digest identifies the audited evidence without distributing it.</p></details></section>
</div><footer>Static NCAA basketball evidence. No live provider requests, background research, wagers or automatic deployment. Publishing this page creates zero model fits, source retrievals or forecasts.</footer>
<script id="execution-data" type="application/json">__EXECUTION_DATA__</script>
<script>
(() => {'use strict';
const $=id=>document.getElementById(id), fmt=n=>n===null?'Unobserved':Number(n).toLocaleString('en-US'), sec=n=>n===null?'Unobserved':Number(n).toLocaleString('en-US',{maximumFractionDigits:2})+' s';
function text(id,value){$(id).textContent=value;}function element(tag,value){const e=document.createElement(tag);e.textContent=value;return e;}
function facts(id,rows){$(id).replaceChildren();for(const [label,value] of rows){$(id).appendChild(element('dt',label));$(id).appendChild(element('dd',value));}}
let d;
try{d=JSON.parse($('execution-data').textContent);if(d.schema!=='sel.ncaa.public.execution_status.v1'||d.owner!=='NCAA basketball'||d.latest_verified_return.integrity!=='FULL_ARCHIVE_VERIFIED'||d.publication.new_fits!==0||d.publication.deployment_verified!==false||d.science_contract.test_selection_weight!==0||d.throughput.newer_12_to_24_core_science_proven!==false)throw Error('evidence contract');
const observed=d.latest_observed_attempt, verified=d.latest_verified_return, p=d.preserved_work,t=d.throughput,s=d.science_contract;
text('snapshot-time','Evidence checked '+new Intl.DateTimeFormat('en-US',{dateStyle:'long',timeStyle:'short',timeZone:'America/Los_Angeles'}).format(new Date(d.observed_at))+' Pacific. This is a dated snapshot, not a live status feed.');
text('observed-release',observed.release);text('observed-status',observed.status_label);text('observed-copy',observed.note);text('verified-release',verified.release);text('verified-copy',verified.note);text('preserved-fits',fmt(p.new_target_fits_in_audited_attempts));text('preserved-copy',p.note);text('resume-headline',d.resume_contract.headline);text('resume-explanation',d.resume_contract.explanation);text('repeat-copy',p.repeat_work_note);
facts('retry-facts',[['Earlier R24 startup checks','867 fresh tests'],['R24 retry startup checks','867 reused · 0 fresh'],['Cold validation wall time',sec(263.173591086)],['Warm validation wall time',sec(0.064340413)],['R24 first / retry owner wall',sec(315.364679428)+' / '+sec(74.202625541)],['R24 first / retry parent CPU',sec(291.360186)+' / '+sec(66.252765)]]);
for(const step of d.resume_contract.steps)$('resume-steps').appendChild(element('li',step));
text('occupancy',t.reported_capacity_percent.toFixed(2)+'%');$('occupancy-fill').style.width=t.reported_capacity_percent+'%';$('occupancy-meter').setAttribute('aria-label','Reported occupancy '+t.reported_capacity_percent+' percent; required '+t.required_percent+' percent');text('occupancy-caption',t.release+' measured interval: '+sec(t.measurement_seconds)+'. The green marker is the '+t.required_percent+'% acceptance threshold.');text('throughput-copy',t.note);text('throughput-next',t.next_run_rule);facts('throughput-facts',[['Requested workers in measured attempt',fmt(t.requested_workers)],['Peak simultaneous workers',fmt(t.peak_workers)],['Peak ready depth',fmt(t.peak_ready_depth)],['New committed fits in that attempt',fmt(t.committed_fits)],['12–24-core science proven','No']]);
text('science-copy',s.note);text('source-copy',d.source_coverage.note);text('source-limits',d.source_coverage.limits);text('publication-copy',d.publication.note);
for(const record of d.evidence){const line=element('p',record.label+' · '+record.scope+'\n');line.appendChild(element('code',record.sha256));$('evidence-hashes').appendChild(line);}
function render(){const filter=$('attempt-filter').value, rows=d.attempts.filter(r=>filter==='all'||(filter==='unpublished'?!r.return_published:r.phase===filter));$('attempt-rows').replaceChildren();for(const r of rows){const tr=document.createElement('tr');const values=[r.label,r.failure_label,fmt(r.new_target_fits),fmt(r.historical_checkpoint_reuses),fmt(r.fresh_startup_tests)+' / '+fmt(r.reused_startup_tests),sec(r.elapsed_seconds),r.note];values.forEach((value,i)=>{const td=element('td',value);if(i>=2&&i<=5)td.className='numeric';if(i===6)td.className='scope';tr.appendChild(td);});$('attempt-rows').appendChild(tr);}text('attempt-count',rows.length+' of '+d.attempts.length+' audited attempts shown.');}
$('attempt-filter').addEventListener('change',render);render();
$('download-report').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(d,null,2)+'\n'],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='ncaa-execution-status.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
}catch(error){$('report').hidden=true;$('data-error').hidden=false;}
})();
</script></main></body></html>
