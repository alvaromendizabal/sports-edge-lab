<script>
'use strict';
const DATA=JSON.parse(document.getElementById('dashboard-data').textContent);
const esc=x=>String(x??'Unavailable').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num=(x,d=6)=>x==null?'Unavailable':Number(x).toFixed(d);
function selectedRows(data,filter){return data.rows.filter(r=>r.release===filter.release&&r.league===filter.league&&r.season===Number(filter.season)&&r.policy===filter.policy);}
function resultView(data,filter){
 const rows=selectedRows(data,filter),monitor=Number(filter.season)===2026;
 const boundary=monitor&&filter.release==='V132'?'MONITORING ONLY · Reconstructed post-freeze V132 evaluation; not independently archived pregame performance. No ranking or selection.':monitor?'MONITORING ONLY · Retained V129 snapshot; not fresh V131 or V132 output. No current-season ranking or selection.':'HISTORICAL RESEARCH · Repeatedly exposed saved probabilities. Numerical comparisons do not replace complete qualification.';
 let out='<div class="banner '+(monitor?'monitor':'')+'">'+esc(boundary)+'</div>';
 if(!rows.length)return out+'<div class="empty"><h3>No saved panel for this selection</h3><p>'+esc(filter.release==='V132'?'V132 monitoring is annual-origin only; fixed-origin current panels are not published.':filter.release==='V131'?(monitor?'V131 reached no new 2026 monitoring or serving stage.':'The failed V131 run retained FBS panels only; no NFL heldout panel is available.'):'This compact V129 export provides annual historical and retained monitoring aggregates only.')+'</p><p class="fine">Missing evidence is not a zero score. Change the filters to inspect an available panel.</p></div>';
 const m=filter.metric,market=rows.find(r=>r.model.startsWith('MARKET reference')),reference=market[m],best=Math.min(...rows.map(r=>r[m]));
 const maxDelta=Math.max(0.000001,...rows.map(r=>Math.abs(r[m]-reference)));
 out+='<div class="comparison"><div><div class="eyebrow">Matched MARKET reference</div><div class="score">'+num(reference)+'</div><p class="fine">'+esc(m==='win_logloss'?'Log loss':'Brier score')+' · '+rows[0].games+' games · '+esc(filter.league)+'</p><p class="fine muted">'+esc(rows[0].origin.replaceAll('_',' '))+'<br>'+esc(monitor?'Retained forward evaluation; no promotion.':filter.release==='V131'?'Full study qualification: INCOMPLETE.':'Completed study: all four qualification gates FAILED.')+'</p></div><div class="chart">';
 if(monitor){out+='<div class="banner monitor">Operational serving remains MARKET. Research monitoring scores never choose the policy. No outcome-based highlight, rank or winner is assigned.</div>';}else{
  out+='<div class="eyebrow">Difference from MARKET · '+esc(m==='win_logloss'?'log loss':'Brier')+'</div>';
  for(const r of rows){const delta=r[m]-reference,w=Math.abs(delta)/maxDelta*47;out+='<div class="chartrow"><span>'+esc(r.model)+'</span><span class="track"><i class="zero"></i><i class="bar '+(delta<0?'better':'')+'" style="left:'+(delta<0?50-w:50)+'%;width:'+w+'%"></i></span><span>'+ (delta>0?'+':'')+num(delta)+'</span></div>';}
  out+='<div class="axis"><span>← lower / better</span><span>higher / worse →</span></div>';
 }
 out+='</div></div><div class="scroll"><table><caption class="sr-only">Exact selected aggregate panel; unavailable metrics are explicit</caption><thead><tr><th>Model / reference</th><th class="num">Games</th><th class="num">'+esc(m==='win_logloss'?'Log loss':'Brier')+'</th><th class="num">ECE10</th><th class="num">Correct / incorrect</th><th>Paired Δ log loss 95% interval</th></tr></thead><tbody>';
 for(const r of rows){out+='<tr><td>'+esc(r.model)+'</td><td class="num">'+r.games+'</td><td class="num '+(!monitor&&r[m]===best?'best':'')+'">'+num(r[m])+'</td><td class="num">'+num(r.ece10)+'</td><td class="num">'+(r.correct==null?'Unavailable':r.correct+' / '+r.incorrect)+'</td><td>'+(r.delta_ci95?'['+num(r.delta_ci95[0])+', '+num(r.delta_ci95[1])+']':'Not in this export')+'</td></tr>';}
 out+='</tbody></table></div><p class="fine muted">'+(monitor?'No rankings on the current-season monitoring view.':'Emphasis marks the numerical minimum only within this exact panel. Intervals are descriptive saved native-week comparisons. Complete historical qualification remains a separate decision.')+'</p>';
 return out;
}
function demoView(data,name){const x=data.scenarios[name];let out='<div class="lanes">';for(const [label,state] of [['1 · New research',x.research],['2 · Frozen reference serving',x.serving],['3 · Paper readiness',x.execution]])out+='<div class="lane"><h3>'+label+'</h3><span class="badge '+(state.status==='FAILED'?'bad':state.status==='SERVED'||state.status==='COMPLETED'?'good':'neutral')+'">'+esc(state.status)+'</span><p class="fine">'+esc(state.status==='FAILED'?'Ordinary research exception captured.':state.status==='COMPLETED'?'Research completed; frozen policy unchanged.':state.status==='SERVED'?'Two invented reference forecasts produced.':state.status==='BLOCKED'?'Reference validation failed independently.':'No qualified edge or executable venue evidence.')+'</p></div>';out+='</div><div class="trace">'+esc('01 research → '+x.research.status+'\n02 reference validation → '+x.serving.status+'\n03 forecasts in invented output → '+x.serving.forecasts.length+'\n04 paper stake → $0; actual orders → 0; profit → unavailable\nFrozen policy identity → '+(x.serving.policy_sha256||'not served'))+'</div>';
 if(x.serving.forecasts.length){out+='<div class="scroll"><table><caption class="sr-only">Invented example output, not football forecasts</caption><thead><tr><th>Invented fixture</th><th class="num">Reference probability</th><th>Classification</th><th>Learned edge</th></tr></thead><tbody>';for(const r of x.serving.forecasts)out+='<tr><td>'+esc(r.game)+'</td><td class="num">'+num(r.probability,2)+'</td><td>Invented MARKET reference</td><td>Unavailable</td></tr>';out+='</tbody></table></div>';}
 return out;
}
function update(){const filter={};for(const id of ['release','league','season','policy','metric'])filter[id]=document.getElementById(id).value;document.getElementById('results').innerHTML=resultView(DATA,filter);}
for(const id of ['release','league','season','policy','metric'])document.getElementById(id).addEventListener('change',update);
for(const b of document.querySelectorAll('[data-scenario]'))b.addEventListener('click',()=>{for(const other of document.querySelectorAll('[data-scenario]'))other.setAttribute('aria-pressed',String(other===b));document.getElementById('demo-output').innerHTML=demoView(DATA,b.dataset.scenario);});
update();document.getElementById('demo-output').innerHTML=demoView(DATA,'research_failure');
function recoveryView(data,name){const r=data.recovery[name];let out='<div class="comparison"><div><div class="eyebrow">New stage attempts</div><div class="score">'+r.new_attempts+'</div></div><div><div class="eyebrow">Accepted stages reused</div><div class="score">'+r.reused_stages+'</div></div></div><div class="scroll"><table><thead><tr><th>Stage</th><th>Outcome</th><th>New work</th><th>Output identity prefix</th></tr></thead><tbody>';for(const x of r.stages)out+='<tr><td>'+esc(x.stage.replaceAll('_',' '))+'</td><td><span class="badge '+(x.status==='FAILED'?'bad':x.status==='BLOCKED'?'neutral':'good')+'">'+esc(x.status)+'</span></td><td>'+String(x.executed)+'</td><td><code>'+esc(x.output_sha256?x.output_sha256.slice(0,16):'No accepted output')+'</code></td></tr>';return out+'</tbody></table></div>';}
for(const b of document.querySelectorAll('[data-recovery]'))b.addEventListener('click',()=>{for(const other of document.querySelectorAll('[data-recovery]'))other.setAttribute('aria-pressed',String(other===b));document.getElementById('recovery-output').innerHTML=recoveryView(DATA,b.dataset.recovery);});
document.getElementById('recovery-output').innerHTML=recoveryView(DATA,'first');
function portableView(data,name){const r=data.portability[name];let out='<div class="banner '+(r.all_selected_stages_ready?'':'monitor')+'">'+(r.all_selected_stages_ready?'Complete selected closure verified after export.':'Sparse copy: financial context missing; independent research remains ready.')+'</div><div class="scroll"><table><caption class="sr-only">Invented portable dependency inspection</caption><thead><tr><th>Stage</th><th>Readiness</th><th class="num">Required files</th><th class="num">Verified files</th><th>Missing dependencies</th></tr></thead><tbody>';for(const s of r.stages)out+='<tr><td>'+esc(s.stage.replaceAll('_',' '))+'</td><td><span class="badge '+(s.status==='READY'?'good':'bad')+'">'+esc(s.status)+'</span></td><td class="num">'+s.required+'</td><td class="num">'+s.verified+'</td><td>'+esc(s.missing.length?s.missing.join(', '):'None')+'</td></tr>';return out+'</tbody></table></div>';}
for(const b of document.querySelectorAll('[data-portable]'))b.addEventListener('click',()=>{for(const other of document.querySelectorAll('[data-portable]'))other.setAttribute('aria-pressed',String(other===b));document.getElementById('portable-output').innerHTML=portableView(DATA,b.dataset.portable);});
document.getElementById('portable-output').innerHTML=portableView(DATA,'sparse');
globalThis.Dashboard={selectedRows,resultView,demoView,recoveryView,portableView,DATA};
</script></body></html>
