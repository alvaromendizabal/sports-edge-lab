:root{--paper:#f5f2ea;--card:#fffefa;--ink:#18333d;--muted:#617982;--line:#d9dfd9;--teal:#0d726d;--tealwash:#e4efea;--ochre:#9c5e19;--warn:#fbefdc;--red:#a03f32;--shadow:0 1px 0 #ffffff inset}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--teal);text-underline-offset:3px}button,select{font:inherit}button,select,summary,a{outline-offset:5px}button{padding:10px 15px;border:1px solid var(--teal);border-radius:7px;background:var(--teal);color:white;cursor:pointer}select{max-width:100%;padding:9px 36px 9px 12px;background:white;border:1px solid var(--line);border-radius:7px;color:var(--ink)}main,header,footer{max-width:1160px;margin:auto;padding-left:28px;padding-right:28px}header{padding-top:24px;padding-bottom:15px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:center}header a{font-size:12px;font-weight:800;letter-spacing:.12em;text-decoration:none}header span{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}nav{display:flex;flex-wrap:wrap;gap:8px 24px;margin:18px 0 38px;font-size:13px}nav a{text-decoration:none}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(38px,5.1vw,62px);line-height:1.06;letter-spacing:-.045em;margin-bottom:22px;max-width:760px}h2{font-size:28px;line-height:1.18;letter-spacing:-.025em;margin-bottom:16px}h3{font-size:19px;line-height:1.3;margin-bottom:16px}.eyebrow{color:var(--teal);font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px}.hero{display:grid;grid-template-columns:1.65fr 1fr;gap:42px;align-items:start}.lead{font-size:18px;color:var(--muted);max-width:740px}.status{padding:26px;border-radius:14px;background:var(--ink);color:#fff}.status .eyebrow{color:#9adbd2}.status p:last-child{margin:0;color:#c7d8db;font-size:14px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:32px 0}.metric,.card{background:var(--card);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);padding:23px}.metric span{display:block;text-transform:uppercase;letter-spacing:.09em;font-size:10px;font-weight:800;color:var(--muted)}.metric strong{font-size:36px;line-height:1.3;letter-spacing:-.03em;display:block;margin:6px 0}.metric p{font-size:12px;color:var(--muted);margin:0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.stack{display:grid;gap:18px}section{padding-top:32px;margin-top:38px;border-top:1px solid var(--line)}.notice{padding:17px 20px;border-left:3px solid var(--teal);background:var(--tealwash);border-radius:0 6px 6px 0;font-size:14px;margin:22px 0}.notice.warn{border-color:var(--ochre);background:var(--warn)}.fine{font-size:12px;color:var(--muted)}.muted{color:var(--muted)}.facts{margin:0}.facts div{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:9px 0;border-bottom:1px solid #e7ebe5;font-size:13px}.facts div:last-child{border:0}.facts dt{color:var(--muted)}.facts dd{margin:0;text-align:right;font-weight:650;font-variant-numeric:tabular-nums}.controls{display:flex;flex-wrap:wrap;align-items:end;gap:14px 22px;margin:22px 0}.controls label{display:grid;gap:5px;font-size:12px;color:var(--muted)}.controls button{margin-left:auto}.table-wrap{max-width:100%;overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}th{text-align:left;font-size:11px;color:var(--muted);font-weight:700;padding:12px 8px;border-bottom:2px solid var(--line)}td{padding:14px 8px;border-bottom:1px solid var(--line);vertical-align:top}tbody tr:last-child td{border-bottom:0}td.num,th.num{text-align:right}.policy-name{font-weight:700}.policy-detail{font-size:11px;color:var(--muted);display:block}.pill{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:3px 9px;font-size:11px;margin:2px;background:white}.pill.ok{background:var(--tealwash);color:var(--teal)}.pill.warn{background:var(--warn);color:var(--ochre)}.phase{margin:18px 0}.phase-head{display:flex;justify-content:space-between;gap:15px;font-size:13px;margin-bottom:6px}.bar-track{height:17px;border-radius:4px;background:#e4e8e1;overflow:hidden;display:flex}.bar{height:100%;background:var(--teal)}.bar.prepare{background:#6daca1}.bar.other{background:#9fb6b4}.bar.serial{background:#c3914f}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin:8px 0}.legend span:before{content:"";display:inline-block;width:9px;height:9px;background:var(--teal);margin-right:5px}.legend .prep:before{background:#6daca1}.legend .other:before{background:#9fb6b4}.legend .serial:before{background:#c3914f}.branch{padding:15px 0;border-bottom:1px solid var(--line)}.branch:last-child{border:0}.branch-head{display:flex;gap:12px;justify-content:space-between;align-items:baseline}.branch p{margin:7px 0 0;font-size:13px;color:var(--muted)}.branch strong{font-size:14px}.pin{display:grid;gap:5px;padding:13px 0;border-bottom:1px solid var(--line);font-size:12px}.pin code,.digest{font:11px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere;word-break:break-all;color:var(--muted)}details{border:1px solid var(--line);border-radius:9px;padding:18px;background:var(--card)}summary{cursor:pointer;font-size:14px;font-weight:700}footer{display:flex;justify-content:space-between;gap:24px;margin-top:44px;padding-top:22px;padding-bottom:36px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}footer p{max-width:800px}.error{margin:32px auto;max-width:1104px;padding:25px;background:#fff0ed;color:var(--red);border:1px solid #d9a69f;border-radius:9px}[hidden]{display:none!important}ul{padding-left:22px}li{margin:8px 0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:760px){main,header,footer{padding-left:19px;padding-right:19px}header{align-items:start}header span{max-width:130px;text-align:right}.hero,.grid{grid-template-columns:1fr;gap:18px}.hero{gap:20px}.status{padding:23px}.metrics{grid-template-columns:1fr 1fr;gap:10px}.metric{padding:17px}.metric strong{font-size:30px}.card{padding:19px}h1{font-size:40px}h2{font-size:25px}.lead{font-size:16px}.controls button{margin-left:0}.leader-table thead{display:none}.leader-table,.leader-table tbody,.leader-table tr,.leader-table td{display:block}.leader-table tr{padding:14px 0;border-bottom:1px solid var(--line)}.leader-table td{border:0;padding:5px 0;display:flex;justify-content:space-between;text-align:right;gap:15px}.leader-table td:before{content:attr(data-label);font-size:11px;font-weight:700;text-align:left;color:var(--muted);flex:0 0 96px}.leader-table td:first-child{display:block;text-align:left;font-size:15px;font-weight:750;padding-bottom:7px}.leader-table td:first-child:before{display:none}.policy-detail{display:block}.source-table{font-size:11px}.source-table td,.source-table th{padding:10px 4px}.source-table td:first-child{max-width:110px;overflow-wrap:anywhere}.facts div{font-size:12px}.facts dt{max-width:65%}nav{gap:9px 18px;font-size:12px;margin-bottom:28px}footer{display:block}.branch-head{align-items:start}.branch .pill{white-space:nowrap;font-size:9px}.notice{padding:15px}section{margin-top:30px;padding-top:28px}}
