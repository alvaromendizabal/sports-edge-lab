<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'">
<title>FBS — V098 verified progress and V099 preparation</title>
<style>
:root{color-scheme:dark;--bg:#09121b;--panel:#12202d;--line:#294052;--text:#edf4f7;--muted:#a6bac9;--mint:#77e3bb;--amber:#f3cf80;--red:#ff9b94;--blue:#a0c9ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--blue)}button,select{font:inherit;color:var(--text);background:#1d3447;border:1px solid #48677f;border-radius:7px;padding:.55rem .8rem;cursor:pointer}button:hover,select:hover{border-color:var(--mint)}:focus-visible{outline:3px solid var(--amber);outline-offset:3px}.wrap{max-width:1240px;margin:auto;padding:0 24px}header{border-bottom:1px solid var(--line);background:linear-gradient(145deg,#142b36,#09121b 70%);padding:32px 0 38px}.brand{font-size:.8rem;text-transform:uppercase;letter-spacing:.17em;color:var(--mint);font-weight:800}.meta{color:var(--muted);font-size:.85rem}.eyebrow{font-size:.78rem;color:var(--mint);letter-spacing:.1em;text-transform:uppercase;font-weight:750;margin-bottom:8px}h1{font-size:clamp(2.2rem,4.4vw,3.9rem);line-height:1.08;max-width:920px;letter-spacing:-.04em;margin:18px 0}h2{font-size:1.8rem;line-height:1.2;margin:0 0 18px}h3{margin:0 0 10px;font-size:1.1rem}p{margin:10px 0 16px}.lead{max-width:900px;color:#c8d9e3;font-size:1.13rem}.pills{display:flex;gap:9px;flex-wrap:wrap;margin:24px 0}.pill{border:1px solid var(--line);border-radius:99px;padding:5px 12px;font-size:.8rem;background:#10222d}.good{color:var(--mint)}.caution{color:var(--amber)}nav{display:flex;gap:19px;flex-wrap:wrap;margin-top:18px;font-size:.9rem}nav a{text-decoration:none}main section{padding:38px 0;border-bottom:1px solid var(--line)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:24px 0}.card,.kpi{border:1px solid var(--line);border-radius:13px;background:var(--panel);padding:22px;min-width:0}.kpi .value{font-size:2.15rem;line-height:1.2;font-weight:780;letter-spacing:-.04em}.kpi .label{color:var(--muted);font-size:.85rem;margin-top:6px}.note{border-left:3px solid var(--amber);padding:11px 16px;background:#262820;color:#f3dfba}.fine{font-size:.85rem;color:var(--muted)}.controls{display:flex;gap:16px;align-items:end;flex-wrap:wrap;margin:20px 0}.controls label{font-size:.82rem;color:var(--muted);display:grid;gap:5px}.scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px}table{border-collapse:collapse;width:100%;font-size:.88rem}th,td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:top}th{background:#192c3a;color:#b9cedd;font-size:.78rem;text-transform:uppercase;letter-spacing:.035em;white-space:nowrap}td.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}tr:last-child td{border-bottom:0}.muted{color:var(--muted)}.facts{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 18px;margin:0}.facts dt{color:var(--muted)}.facts dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.digest{font:12px/1.5 ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere;color:var(--muted)}.providers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}.providers .card{padding:16px}.bar{height:9px;background:#223c4e;border-radius:20px;overflow:hidden;margin:8px 0 12px}.bar span{display:block;height:100%;background:var(--mint)}.work{display:grid;gap:10px}.work .item{padding:13px 0;border-bottom:1px solid var(--line)}.work .item:last-child{border:0}.tag{font-size:.68rem;letter-spacing:.05em;text-transform:uppercase;color:var(--amber);margin-left:9px}.footer{padding:28px 0 45px;color:var(--muted);font-size:.85rem}.error{padding:24px;background:#411e24;border:1px solid var(--red);color:var(--red);margin:30px 0}details{border:1px solid var(--line);border-radius:10px;padding:15px 18px}summary{cursor:pointer;color:var(--blue)}.actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.hidden,[hidden]{display:none!important}@media(max-width:800px){.kpis,.providers{grid-template-columns:repeat(2,minmax(0,1fr))}.grid{grid-template-columns:1fr}.wrap{padding:0 16px}h1{font-size:2.5rem}table{font-size:.82rem}th,td{padding:10px}.card{padding:18px}}@media(max-width:430px){.kpis{gap:8px}.kpi{padding:14px}.kpi .value{font-size:1.75rem}.providers{grid-template-columns:1fr}.facts{font-size:.88rem;gap:9px}.wrap{padding:0 12px}nav{gap:12px}h1{font-size:2.15rem}}
</style></head><body>
<header><div class="wrap"><div class="brand">Sports Edge Lab / NCAA FBS</div><p class="meta">Verified owner evidence · November 18, 2026 · Source review only</p><h1>1,125 jobs completed.<br>Build on the verified work.</h1><p class="lead">V098 finished successfully and published a verified, resumable return. The next finite study reuses those fitted components. The broader scientific program remains unfinished.</p><div class="pills"><span class="pill good">Operationally finished · exit 0</span><span class="pill caution">Science partial / resumable</span><span class="pill">T60 reconstruction</span><span class="pill">2026 held apart from selection</span></div><nav aria-label="Report sections"><a href="#results">Results</a><a href="#sources">Sources &amp; populations</a><a href="#runtime">Measured CPU</a><a href="#continuation">Next execution</a><a href="#custody">Custody &amp; evidence</a></nav></div></header>
<main class="wrap"><div id="error" class="error" role="alert" hidden></div><div id="report" hidden>
<section id="actual"><p class="eyebrow">01 / Actual V098 execution</p><h2>A completed finite campaign</h2><div class="kpis" id="kpis"></div><div class="grid"><article class="card"><h3>Seven model families</h3><p id="families"></p><p class="fine">New fitted models, calibrators, exact fitted-state reuse and scoring rows are counted separately. The 1,309 earlier T120 policies remain intact at their original horizon.</p><dl class="facts" id="actual-facts"></dl></article><article class="card"><h3>Completed registered branches</h3><div id="branches"></div><p class="fine">These are completed registered comparisons. They do not imply an exhaustive feature or hyperparameter search.</p></article></div></section>
<section id="results"><p class="eyebrow">02 / Validation-selected diagnostic leaders</p><h2>Every objective, the same observed cohort</h2><p class="note">2024 and 2025 select the leader. The 2026 column is separately reported test performance. These are previously exposed reconstructions, with no original-issue or production-promotion claim.</p><div class="controls"><label for="profile">Annual validation score weights<select id="profile"><option>50/50</option><option>40/60</option><option>30/70</option><option>20/80</option><option>10/90</option></select></label><p class="fine">Changing weights re-scores saved annual metrics.<br>No estimator, calibrator, training row or prediction changes.</p></div><p id="profile-note" class="fine" aria-live="polite"></p><div class="scroll"><table id="leader-table"><thead><tr><th>Objective</th><th>Public role / family</th><th>2024 · n=919</th><th>2025 · n=934</th><th>2026 · n=755</th><th>Validation score</th><th>Primary role rank</th></tr></thead><tbody></tbody></table></div><p class="fine">The public aliases preserve role identity across all five profiles. Full-precision metrics are retained in the evidence download; rounded display values never drive selection. Full official census and historical possession remain unproved.</p></section>
<section id="sources"><p class="eyebrow">03 / Source and population evidence</p><h2>Prediction coverage is not odds coverage</h2><div class="grid"><article class="card"><h3>Observed game populations</h3><div class="scroll"><table id="population-table"><thead><tr><th>Season</th><th>Completed</th><th>Pending</th><th>Observed</th></tr></thead><tbody></tbody></table></div><p class="fine">All 834 T60 policies cover every observed completed game. The full official census and postseason classification remain unverified. Ten upcoming kickoff clocks are unresolved.</p></article><article class="card"><h3>Authenticated source grid</h3><dl class="facts" id="source-facts"></dl><p class="fine">The three grid categories reconcile. Missing-reason labels may overlap. Source cells are not unique games, executable quotes, scored provider benchmarks or proof of original possession.</p></article></div><div class="providers" id="provider-cards"></div><div class="controls"><label for="source-target">Target<select id="source-target"><option value="all">All targets</option><option value="winner">Winner</option><option value="margin">Margin</option><option value="total">Total</option></select></label><label for="source-season">Season<select id="source-season"><option value="all">All seasons</option><option>2024</option><option>2025</option><option>2026</option></select></label></div><div class="scroll"><table id="source-table"><thead><tr><th>Target</th><th>Season</th><th>Any qualified T60 source</th><th>All sources absent</th><th>Observed rows</th></tr></thead><tbody></tbody></table></div><p class="fine">These source-coverage denominators include completed and pending observed games. They remain separate from the completed-game scientific denominators. Missing source inputs retain explicit fallback controls.</p></section>
<section id="runtime"><p class="eyebrow">04 / Measured work, not configured counts</p><h2>V098 passed its real 180-second gate</h2><div class="grid" id="cpu-windows"></div><p class="fine" id="cpu-note"></p><p class="note">This is V098 evidence. V099 has not executed the new study and inherits no throughput pass. Its own applicable real-scoring windows must meet the same 180-second / 75% condition; short finite queues remain explicitly qualified.</p></section>
<section id="continuation"><p class="eyebrow">05 / V099 continuation</p><h2 id="next-title">Next release in preparation</h2><div class="grid"><article class="card"><h3>New work on preserved results</h3><dl class="facts" id="next-facts"></dl><p class="fine">The finite extension evaluates predeclared forecast distributions and paired uncertainty on fixed populations. It does not repeat the 1,125 fitting jobs. Planned outputs are not completed scientific work.</p><p id="release-proof" class="digest"></p></article><article class="card"><h3>Owner-controlled execution</h3><p>Target 12 workers, with an explicit ceiling up to 36 when safely available. Every explicit worker setting is a hard ceiling. Work and progress must be measured from live tasks and completions.</p><p>Resolve the newest verified checkpoint at launch. Keep completed receipts, warm caches, source clocks and partial status. The owner launches the research manually.</p><p class="note">No research launch, provider retrieval, predecessor stop, website deployment or production promotion is performed by this source review.</p></article></div><article class="card" style="margin-top:18px"><h3>What remains unfinished</h3><div class="work" id="remaining-work"></div></article></section>
<section id="custody"><p class="eyebrow">06 / Recovery, storage and publication</p><h2>Compact return, durable scientific custody</h2><div class="grid"><article class="card"><h3>Measured V098 storage and finalization</h3><dl class="facts" id="storage-facts"></dl><p class="fine">The 512 MiB bound applies to each transport part. It is not an aggregate science cap. The compact ZIP is a review and resumption index, not the total size of all scientific storage.</p><p class="digest" id="return-digest"></p></article><article class="card"><h3>Cost and publication status</h3><dl class="facts" id="cost-facts"></dl><p class="fine">Compute is estimated through the authenticated pointer measurement, with later completion excluded. It is not an invoice. An unlimited wall-clock setting does not waive the USD 200 compute guard.</p><p>This is an unmerged source review. Hosted website publication, refreshed research and production model promotion remain separate actions.</p><a href="../v098/index.html">Read the preserved V098 preparation history</a></article></div><details style="margin-top:18px"><summary>Source evidence digests and scope</summary><div id="evidence-pins"></div><p class="fine">These digests identify inspected evidence. They do not expose private payloads, grant provider redistribution rights or enable full private retraining.</p></details><div class="actions" style="margin-top:22px"><button id="download" type="button">Download bounded evidence JSON</button><span class="fine">Exact data used by this report · no source feed arrays or private recipes</span></div></section>
</div></main><footer class="wrap footer">FBS only · Retrospective research evidence · No wagering interface · No automatic promotion</footer>
<script id="report-data" type="application/json">__DATA__</script>
<script>
'use strict';
(async()=>{try{
const raw=document.getElementById('report-data').textContent,expected='__DATA_SHA256__';
const actual=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(raw))),x=>x.toString(16).padStart(2,'0')).join('');
if(actual!==expected)throw Error('Evidence digest changed. The report is not displayed.');
const d=JSON.parse(raw);
if(d.schema!=='fbs.public.actual-and-continuation.v099'||d.owner!=='FBS'||d.execution.scientific_complete!==false||d.selection.test_used_for_selection!==false||d.publication.website_deployed!==false)throw Error('Evidence scope changed.');
const q=s=>document.querySelector(s),num=x=>Number(x).toLocaleString('en-US'),fmt=(x,m)=>m==='accuracy'?(x*100).toFixed(2)+'%':x.toFixed(4);
const el=(tag,text,cls)=>{const x=document.createElement(tag);if(text!==undefined)x.textContent=text;if(cls)x.className=cls;return x;};
const append=(host,...nodes)=>nodes.forEach(n=>host.append(n));
const facts=(id,rows)=>rows.forEach(([a,b])=>append(q(id),el('dt',a),el('dd',String(b))));
const row=(host,values)=>{const tr=el('tr');values.forEach((v,i)=>tr.append(el('td',v,i>1?'num':'')));host.append(tr);};
[['Completed jobs',d.execution.completed_jobs],['New fitted models',d.execution.new_model_fits],['Exact fits reused',d.execution.reused_fit_states],['New T60 policies',d.execution.new_policy_count]].forEach(([label,value])=>{const k=el('div',undefined,'kpi');append(k,el('div',num(value),'value'),el('div',label,'label'));q('#kpis').append(k);});
q('#families').textContent=d.execution.families.join(' · ');
facts('#actual-facts',[['Validation / frozen-test jobs','750 / 375'],['New calibrators',num(d.execution.new_calibrator_fits)],['Fitting failures','0'],['Completed-game score rows',num(d.execution.new_scored_prediction_rows)],['All forecast rows',num(d.execution.new_prediction_rows)]]);
d.execution.branches.forEach(b=>{const dl=el('dl',undefined,'facts');append(dl,el('dt',b.name),el('dd',num(b.jobs)));q('#branches').append(dl);});
function leaders(){const profile=q('#profile').value;const host=q('#leader-table tbody');host.replaceChildren();const rows=d.selection.leaders.filter(x=>x.profile===profile).sort((a,b)=>(a.target+'/'+a.metric).localeCompare(b.target+'/'+b.metric));rows.forEach(r=>row(host,[r.target+' / '+r.metric.replace('_',' '),r.policy_alias+' · '+r.family,...r.annual_values.map(x=>fmt(x,r.metric)),fmt(r.selection_score,r.metric),String(r.primary_policy_rank)]));q('#profile-note').textContent=(profile==='50/50'?'Declared primary default.':'Sensitivity only.')+' '+rows.filter(r=>!r.same_policy_as_primary).length+' objective leaders differ from the primary profile.';}
q('#profile').addEventListener('change',leaders);leaders();
[2024,2025,2026].forEach((s,i)=>row(q('#population-table tbody'),[String(s),num(d.population.annual_completed[i]),num(d.population.annual_pending[i]),num(d.population.annual_observed[i])]));
facts('#source-facts',[['Qualified source cells',num(d.sources.qualified_grid_cells)],['Explicit missing cells',num(d.sources.explicit_missing_grid_cells)],['Outside feature history',num(d.sources.outside_feature_history_cells)],['Total registered cells',num(d.sources.total_grid_cells)],['Admitted bookmaker slots',String(d.sources.admitted_bookmaker_slots)]]);
d.sources.providers.forEach(p=>{const c=el('article',undefined,'card');append(c,el('h3',p.name),el('p',p.name==='DraftKings'?num(p.qualified_grid_cells)+' qualified cells; '+num(p.qualified_pretest_grid_cells)+' pre-test.':'Native contract adapter blocked.',p.name==='DraftKings'?'fine':'fine caution'));q('#provider-cards').append(c);});
function sources(){const target=q('#source-target').value,season=q('#source-season').value,host=q('#source-table tbody');host.replaceChildren();d.sources.coverage.filter(x=>(target==='all'||x.target===target)&&(season==='all'||String(x.season)===season)).forEach(r=>row(host,[r.target,String(r.season),num(r.rows_with_any_qualified_t60_source),num(r.all_sources_absent_rows),num(r.rows)]));}
q('#source-target').addEventListener('change',sources);q('#source-season').addEventListener('change',sources);sources();
d.cpu.windows.forEach(w=>{const c=el('article',undefined,'card');append(c,el('h3',w.phase+' · Extra Trees'),el('div',(w.useful_worker_cpu_occupancy*100).toFixed(2)+'% useful CPU occupancy','good'));const bar=el('div',undefined,'bar'),fill=el('span');fill.style.width=(w.useful_worker_cpu_occupancy*100)+'%';bar.append(fill);c.append(bar);append(c,el('p',w.representative_seconds.toFixed(2)+' seconds · '+w.selected_worker_capacity+' admitted cores · '+w.real_fits_completed_in_window+' real fits completed.'),el('p','Fit-only occupancy '+(w.fit_only_cpu_occupancy*100).toFixed(2)+'%. Preparation and optimizer measurement remain separate.','fine'));q('#cpu-windows').append(c);});
q('#cpu-note').textContent='Across family waves, the descriptive mean useful occupancy was '+(d.cpu.descriptive_mean_occupancy*100).toFixed(2)+'%. That aggregate is not substituted for either authenticated sustained window.';
q('#next-title').textContent=d.next_preparation.status==='PREPARED_NOT_EXECUTED'?'V099 prepared; owner execution pending':'V099 in preparation; owner execution pending';
facts('#next-facts',[['Planned forecast policies','100'],['Validation / test scoring tasks','200 / 100'],['Paired uncertainty tasks','300'],['Objective comparisons','900'],['Repeated base / calibrator fits','0 / 0'],['Owner research executions','0']]);
q('#release-proof').textContent=d.next_preparation.native_verified?'Native verified release: '+num(d.next_preparation.canonical_bytes)+' bytes · SHA-256 '+d.next_preparation.canonical_sha256:'A sealed native release has not been claimed in this dated source snapshot.';
d.remaining_work.forEach(w=>{const item=el('div',undefined,'item'),head=el('strong',w.name);head.append(el('span',w.status.replaceAll('_',' '),'tag'));append(item,head,el('p',w.detail,'fine'));q('#remaining-work').append(item);});
facts('#storage-facts',[['Verified control ZIP',(d.storage.control_zip_bytes/1048576).toFixed(2)+' MiB'],['New payload bytes',(d.storage.new_uploaded_payload_bytes/1e9).toFixed(3)+' GB'],['Inherited bytes not recopied',(d.storage.inherited_payload_bytes_not_recopied/1e9).toFixed(3)+' GB'],['Checkpoint receipts',num(d.storage.checkpoint_receipts)],['Collection custody',d.storage.checkpoint_collection_seconds.toFixed(2)+' s'],['Final identity verification',d.storage.final_identity_verification_seconds.toFixed(2)+' s'],['Physical dependency pins',num(d.storage.physical_dependency_pins)]]);
q('#return-digest').textContent='Verified return SHA-256: '+d.storage.return_sha256;
facts('#cost-facts',[['Observed estimate','$'+d.cost.estimated_compute_usd.toFixed(4)],['Measured elapsed',(d.cost.elapsed_seconds_through_measurement/60).toFixed(2)+' min'],['Compute guard','$200'],['Website deployed','No'],['Production promoted','No']]);
d.evidence.forEach(e=>{const item=el('div');append(item,el('p',e.label+' · '+num(e.bytes)+' bytes'),el('p',e.sha256,'digest'));q('#evidence-pins').append(item);});
q('#download').addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(d,null,2)+'\n'],{type:'application/json'})),a=el('a');a.href=url;a.download='FBS_V099_PUBLIC_EVIDENCE.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);});
q('#report').hidden=false;document.documentElement.dataset.reportReady='true';
}catch(error){document.getElementById('error').hidden=false;document.getElementById('error').textContent=String(error.message||error);document.documentElement.dataset.reportReady='error';}})();
</script></body></html>
