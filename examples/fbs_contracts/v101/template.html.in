<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="FBS V100 recovery failure, preserved completed research, and V101 owner preparation evidence.">
<title>FBS · Recovery and next execution</title>
<style>
:root{color-scheme:light;--ink:#182a40;--muted:#58687b;--line:#d6e0e9;--paper:#f3f6f9;--navy:#11304f;--blue:#1557a0;--red:#9b3039;--amber:#936118}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--blue)}button,select{font:inherit}button{cursor:pointer}header{background:var(--navy);color:white;padding:48px max(22px,calc((100vw - 1160px)/2));border-bottom:6px solid #75b5db}.eyebrow{font-size:12px;font-weight:750;letter-spacing:.13em;text-transform:uppercase;opacity:.8}h1{font-size:clamp(30px,4.5vw,52px);line-height:1.12;letter-spacing:-.035em;margin:14px 0 20px;max-width:850px}header p{max-width:790px;color:#dbe6ef;margin:10px 0}nav{display:flex;gap:18px;flex-wrap:wrap;margin-top:25px}nav a{color:#d6edff;text-underline-offset:5px}main{max-width:1200px;margin:auto;padding:32px 20px 60px}section{margin:0 0 32px;background:white;border:1px solid var(--line);border-radius:14px;padding:28px;min-width:0}h2{margin:6px 0 16px;letter-spacing:-.025em;font-size:27px;line-height:1.25}h3{font-size:18px;margin:0 0 12px}p{margin:10px 0 18px}.note{border-left:3px solid #b8d3e7;background:#f0f6fb;padding:13px 17px}.failure{border-left-color:#be5260;background:#fff3f4}.fine{font-size:13px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.card{padding:20px;border:1px solid var(--line);border-radius:9px;min-width:0}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:32px}.kpi{background:white;border:1px solid var(--line);padding:19px;border-radius:10px}.kpi strong{display:block;font-size:30px;line-height:1.2;margin:4px 0 6px}.kpi span{display:block;font-size:13px;color:var(--muted)}.badge{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.025em;padding:5px 10px;border-radius:5px;background:#e9eff6;color:#214666}.badge.fail{background:#f8e1e4;color:var(--red)}.badge.wait{background:#fff0d8;color:var(--amber)}.scroll{overflow-x:auto;max-width:100%;border:1px solid var(--line);border-radius:8px}table{border-collapse:collapse;width:100%;text-align:left;font-size:14px}th,td{padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:top}th{background:#eff4f8;color:#31475f;font-size:12px;letter-spacing:.025em}tbody tr:last-child td{border-bottom:0}tbody tr:nth-child(even){background:#fafcfe}td.number,th.number{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.facts{margin:0;display:grid;grid-template-columns:minmax(110px,.8fr) minmax(0,1.2fr);gap:11px 16px;font-size:14px}.facts dt{color:var(--muted)}.facts dd{margin:0;font-weight:600;overflow-wrap:anywhere}.hash{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;overflow-wrap:anywhere}.controls{display:flex;gap:15px;align-items:end;flex-wrap:wrap;margin:18px 0}.controls label{display:grid;gap:5px;font-size:13px;color:var(--muted)}select,button{background:white;border:1px solid #8ca2b6;border-radius:6px;padding:9px 12px;color:var(--ink)}button{background:var(--navy);color:white;border-color:var(--navy)}a:focus-visible,button:focus-visible,select:focus-visible,.scroll:focus-visible{outline:3px solid #1b78c6;outline-offset:3px}.status-failed{color:var(--red);font-weight:700}.status-pending,.status-blocked,.status-deferred{color:var(--amber)}.status-authenticated-completed,.status-reused{color:#23654e}.scope{font-size:14px;color:var(--muted)}details{margin-top:18px}summary{cursor:pointer;font-weight:650}#error{max-width:900px;margin:30px auto;padding:25px;border:2px solid #b5434b;background:#fff0f0}[hidden]{display:none!important}footer{font-size:13px;color:var(--muted);padding:8px 2px}ul{padding-left:22px}li{margin:8px 0}@media(max-width:720px){header{padding:32px 20px}section{padding:21px 17px;border-radius:10px}main{padding:20px 13px 35px}.grid{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.kpi{padding:14px}.kpi strong{font-size:25px}h2{font-size:24px}th,td{padding:10px}.facts{grid-template-columns:minmax(95px,.8fr) minmax(0,1.2fr)}}
</style>
</head>
<body>
<div id="error" hidden role="alert"><h1>Evidence could not be verified</h1><p>The report is hidden because its content or scientific scope did not pass the embedded checks.</p></div>
<div id="report" hidden>
<header><div class="eyebrow">Sports Edge Lab / FBS / November 19, 2026</div><h1>Recovery evidence.<br>Completed science preserved.</h1><p>V100 failed during checkpoint recovery. Its return is verified and resumable. The completed V098 and V099 research remains the foundation for the next owner execution.</p><nav aria-label="Report sections"><a href="#attempt">Latest attempt</a><a href="#science">Preserved science</a><a href="#runtime">Performance</a><a href="#next">Next execution</a><a href="#stages">Stages</a></nav></header>
<main>
<div class="kpis" id="kpis" aria-label="Actual run and preserved work"><article class="kpi"><span>Latest owner exit</span><strong>2</strong><span>V100 operational failure</span></article><article class="kpi"><span>V100 new scientific fits</span><strong>0</strong><span>Dispatch was not reached</span></article><article class="kpi"><span>Completed V098 fit jobs</span><strong>1,125</strong><span>Prior successful campaign</span></article><article class="kpi"><span>Completed V099 tasks</span><strong>600</strong><span>Prior successful scoring</span></article></div>
<section id="attempt"><div class="eyebrow">01 / Actual owner execution</div><h2>Recovery stopped before scientific dispatch</h2><p class="note failure" id="failure-summary"></p><div class="grid"><article class="card"><h3>Observed execution</h3><dl class="facts" id="attempt-facts"></dl></article><article class="card"><h3>Verified resumable return</h3><dl class="facts" id="return-facts"></dl><p class="fine">The latest verified pointer identifies content integrity and recoverability. The recorded owner exit and scientific status still describe a failed attempt.</p></article></div><p class="scope">No new estimator fits, calibrator fits or scoring tasks were completed by this attempt. The recovery gate prevented a restart of completed scientific work.</p></section>
<section id="science"><div class="eyebrow">02 / Scientific continuity</div><h2>V098 and V099 retain their successful results</h2><div class="scroll" tabindex="0" aria-label="Preserved scientific results"><table id="preserved"><thead><tr><th>Completed campaign</th><th>Operational result</th><th class="number">New fits</th><th class="number">Reused fits</th><th class="number">New standalone scoring tasks</th><th>Scientific status</th></tr></thead><tbody></tbody></table></div><p class="fine">V098 fitting jobs include their prediction and evaluation outputs. Standalone scoring tasks are the separate forecast and uncertainty ledger used by V099.</p><p class="note" id="cohort-note"></p><div class="grid"><article class="card"><h3>Latest census observation</h3><dl class="facts" id="census-facts"></dl><p class="fine">The postseason response was empty. This observation does not certify full population or postseason coverage.</p></article><article class="card"><h3>Evaluation policy retained</h3><p>2024 and 2025 select research leaders. The separately locked 2026 season remains exposed test reporting.</p><p>50/50 is the primary validation profile; 40/60, 30/70, 20/80 and 10/90 change evaluation weights only. They do not change training-row weights or trigger estimator refits.</p><a href="../v099/completed/index.html">Read the completed V099 scientific comparison</a></article></div></section>
<section id="runtime"><div class="eyebrow">03 / Measured operations</div><h2>Recovery and custody are distinct bottlenecks</h2><p class="scope">These are measurements of the failed V100 invocation. They measure dependency recovery and checkpoint custody; scientific computation was not reached.</p><div class="scroll" tabindex="0" aria-label="Measured operational performance"><table id="performance"><thead><tr><th>Operation</th><th class="number">Wall seconds</th><th class="number">CPU seconds</th><th class="number">CPU-core equivalents</th><th class="number">Physical read</th><th class="number">Physical write</th></tr></thead><tbody></tbody></table></div><p id="custody-note"></p><p class="note" id="cpu-note"></p></section>
<section id="next"><div class="eyebrow">04 / Next owner execution</div><h2>V101 preparation</h2><p><span id="preparation-status" class="badge wait"></span></p><p id="preparation-summary"></p><div class="grid"><article class="card"><h3>Finite continuation</h3><dl class="facts" id="plan-facts"></dl></article><article class="card"><h3>Recovery and execution requirements</h3><ul><li>Resolve the newest durable checkpoint again at owner launch.</li><li>Reuse all authenticated completed fits and scoring tasks.</li><li>Accept 12, 24 or 36 as explicit worker ceilings; bound native threads.</li><li>Measure real scientific PIDs, CPU, progress and queue availability.</li><li>Keep the three-minute / 75% scientific occupancy gate conditional on eligible work.</li><li>Preserve compact verified returns and publication ordering.</li></ul></article></div><div id="canonical" hidden><h3>Prepared release identity</h3><dl class="facts" id="canonical-facts"></dl><p class="fine">The owner execution command and private handoff are delivered separately. This public source contains no owner executable, private recipe or licensed input.</p></div><details><summary>Preparation validation evidence</summary><div class="scroll"><table id="validation"><thead><tr><th>Check</th><th>Scope</th><th>Status</th><th class="number">Checks</th></tr></thead><tbody></tbody></table></div><p id="validation-empty" class="fine"></p></details></section>
<section id="stages"><div class="eyebrow">05 / Durable progress</div><h2>V100 numbered stage snapshot</h2><p class="scope">This is the archived child snapshot before supervisor closure. Its failed recovery and pending science remain visible. The later independently verified return and observed exit are reported above.</p><div class="controls"><label for="stage-filter">Stage state<select id="stage-filter"><option value="all">All stages</option><option value="Failed">Failed</option><option value="Pending">Pending</option><option value="Authenticated completed">Authenticated completed</option><option value="Running">Running at snapshot</option></select></label><span id="stage-count" class="fine" aria-live="polite"></span></div><div class="scroll" tabindex="0" aria-label="Numbered archived stage snapshot"><table id="stage-table"><thead><tr><th>Stage</th><th>Operation</th><th>Status</th><th class="number">Completed / total</th><th>Unit</th></tr></thead><tbody></tbody></table></div></section>
<section id="remaining"><div class="eyebrow">06 / Unfinished V13 work</div><h2>What remains open</h2><div class="scroll" tabindex="0" aria-label="Outstanding scientific work"><table id="remaining-work"><thead><tr><th>Branch</th><th>Status</th><th>Evidence needed</th></tr></thead><tbody></tbody></table></div><details><summary>Interpretation and publication limits</summary><ul id="limits"></ul></details></section>
<section><h2>Inspect the bounded evidence</h2><p>The downloadable JSON contains the same authenticated public projection displayed here. It includes no private execution paths, model bodies, licensed feed arrays or unissued forecast grids.</p><button type="button" id="download">Download review JSON</button><p class="fine" id="evidence-time"></p><p class="fine">Source publication does not deploy a website, launch owner research, issue a forecast or promote a production model.</p></section>
<footer>Sports Edge Lab · FBS only · <a href="../README.md">FBS evidence history</a></footer>
</main></div>
<script id="report-data" type="application/json">@@PAYLOAD@@</script>
<script>
'use strict';
const raw=document.getElementById('report-data').textContent,expected='@@SHA256@@';
const id=x=>document.getElementById(x),text=(el,value)=>{el.textContent=String(value)},fmt=x=>x==null?'Unobserved':Number(x).toLocaleString('en-US'),dec=x=>Number(x).toFixed(3),bytes=x=>(x/1048576).toFixed(2)+' MiB';
function assert(ok,message){if(!ok)throw Error(message)}
function row(table,values){const tr=document.createElement('tr');values.forEach((v,i)=>{const td=document.createElement('td');td.textContent=String(v);tr.append(td)});table.querySelector('tbody').append(tr);return tr}
function facts(el,pairs){el.replaceChildren();pairs.forEach(([k,v])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');text(dt,k);text(dd,v);el.append(dt,dd)})}
function guard(d){const a=d.latest_attempt,n=d.next_release,m=d.model_evaluation,p=d.performance;assert(d.owner==='FBS','scope');assert(a.child_exit_code===2&&a.supervisor_exit_code===2&&a.operational_status==='FAILED_BEFORE_SCIENTIFIC_DISPATCH','failure state');assert(a.return.integrity_verified&&a.return.durable_available&&!a.return.owner_execution_successful,'return versus owner outcome');assert(a.new_model_fits===0&&a.new_calibrator_fits===0&&a.new_scoring_tasks===0,'unreached science');assert(!d.publication.owner_executions_started_by_publication&&!d.publication.website_deployment_claimed&&!d.publication.production_promoted,'publication');assert(d.preserved_science.every(x=>x.operational_status==='SUCCESS'),'preserved successes');assert(JSON.stringify(m.completed_cohorts)==='[919,934,755]'&&m.new_2026_census_completed===757&&m.new_census_games_scored_by_v100===0,'population');assert(!m.test_used_for_selection&&!m.training_season_reweighting&&!m.originally_issued&&m.test_previously_exposed,'selection');assert(!p.sustained_scientific_capacity_pass&&!n.sustained_scientific_capacity_pass&&!n.owner_execution_started&&!n.new_science_claimed,'actual compute');assert(n.expected_reusable_fit_jobs===1125&&n.expected_reusable_scoring_tasks===600,'reuse');assert(d.attempt_stages.length===21&&d.attempt_stages[1].status==='Failed','stage manifest');assert(n.prepared_complete?n.status==='PREPARED_NOT_EXECUTED'&&/^[a-f0-9]{64}$/.test(n.canonical_sha256)&&n.canonical_bytes>0&&n.validation_evidence.length>0&&n.validation_evidence.every(x=>x.status==='PASS'):n.status==='PREPARED_NOT_EXECUTED'&&n.canonical_sha256===null&&n.canonical_bytes===null,'prepared identity')}
async function start(){const buffer=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(raw)),sha=Array.from(new Uint8Array(buffer),x=>x.toString(16).padStart(2,'0')).join('');assert(sha===expected,'content digest');const d=JSON.parse(raw);guard(d);const a=d.latest_attempt,p=d.performance,n=d.next_release;
text(id('failure-summary'),'Stage 2 of 21 failed at '+fmt(a.recovery_completed_units)+' / '+fmt(a.recovery_total_units)+' recovery units. The committed-checkpoint guard refused to restart completed work.');
facts(id('attempt-facts'),[['Version / status','V100 · failed'],['Child / supervisor exit','2 / 2'],['New fits / scoring','0 / 0'],['Observed at',a.observed_at_utc],['Scientific state','Safe partial failure; resumable']]);
facts(id('return-facts'),[['Integrity','Verified'],['Return bytes',fmt(a.return.bytes)],['ZIP parts',a.return.parts+' · maximum 512 MiB each'],['SHA-256',a.return.sha256]]);id('return-facts').lastElementChild.className='hash';
d.preserved_science.forEach(s=>row(id('preserved'),[s.version,'Successful',fmt(s.new_fits),fmt(s.reused_fits),fmt(s.new_scoring_tasks),'Partial / resumable V13']));
text(id('cohort-note'),'The latest completed model comparison remains V099 on 919 / 934 / 755 completed games. The V100 census now observes 757 completed 2026 games. The completed count is two higher; exact game IDs and any label revisions still require reconciliation. V100 performed no scoring, and earlier metrics retain their original 755-game denominator.');
const c=a.source_refresh;facts(id('census-facts'),[['Observed 2026 games',fmt(c.observed_games)],['Completed / net count increase',fmt(c.completed_games)+' / '+fmt(c.net_completed_count_increase)],['Source calls / paid market calls',c.provider_calls+' / '+c.new_paid_market_calls],['Observed at',c.source_observed_at_utc],['Full census certified','No']]);
row(id('performance'),['Launch recovery',dec(p.recovery_seconds),dec(p.recovery_process_cpu_seconds),dec(p.recovery_cpu_cores),bytes(p.recovery_read_bytes),bytes(p.recovery_write_bytes)]);row(id('performance'),['Final checkpoint custody',dec(p.custody_seconds),dec(p.custody_process_cpu_seconds),dec(p.custody_cpu_cores),bytes(p.custody_read_bytes),bytes(p.custody_write_bytes)]);
text(id('custody-note'),fmt(p.custody_receipts)+' checkpoint receipts; '+fmt(p.custody_descriptors)+' descriptors; '+fmt(p.custody_physical_pins)+' physical dependencies. '+fmt(p.custody_records_reused)+' collection records were reused. The working final parallel verifier was preserved.');
text(id('cpu-note'),'36 configured workers is a ceiling. Scientific dispatch was not reached, so this run supplies no scientific occupancy acceptance. Recovery averaged '+dec(p.recovery_cpu_cores)+' CPU-core equivalents; custody averaged '+dec(p.custody_cpu_cores)+'.');
text(id('preparation-status'),n.prepared_complete?'Prepared · awaiting owner execution':'Preparation in progress');text(id('preparation-summary'),n.prepared_complete?'The replacement has a pinned, verified preparation record. The owner will launch it manually; this report claims no V101 research result.':'Preparation is being verified. No owner execution or completed V101 science is claimed.');
facts(id('plan-facts'),[['Existing fit identities to reuse',fmt(n.expected_reusable_fit_jobs)],['Existing scoring tasks to reuse',fmt(n.expected_reusable_scoring_tasks)],['Prepared new fitting jobs',fmt(n.prepared_fit_jobs)],['Validation / frozen-test jobs',fmt(n.prepared_validation_fit_jobs)+' / '+fmt(n.prepared_frozen_test_fit_jobs)],['Scoring / stress partitions',fmt(n.prepared_scoring_partitions)+' / '+fmt(n.prepared_stress_partitions)],['Logical census streams',fmt(n.prepared_census_streams)],['Additional residual policies',fmt(n.prepared_residual_policies)],['Residual forecast / uncertainty tasks',fmt(n.prepared_residual_forecast_tasks)+' / '+fmt(n.prepared_residual_uncertainty_tasks)],['Planned paired metric comparisons',fmt(n.prepared_residual_metric_comparisons)],['Maximum residual-parameter fits',fmt(n.prepared_maximum_residual_parameter_fits)],['Maximum combined T60 policies',fmt(n.prepared_maximum_total_t60_policies)],['Worker ceilings',n.worker_ceiling_choices.join(' / ')],['Native threads per worker',n.native_threads_per_worker]]);
if(n.prepared_complete){id('canonical').hidden=false;facts(id('canonical-facts'),[['Bytes',fmt(n.canonical_bytes)],['SHA-256',n.canonical_sha256]]);id('canonical-facts').lastElementChild.className='hash'}
n.validation_evidence.forEach(e=>row(id('validation'),[e.name,e.scope,e.status,fmt(e.checks)]));text(id('validation-empty'),n.validation_evidence.length?'Preparation checks establish the stated engineering scope. They do not establish future scientific throughput.':'Final verification receipts are pending.');
function stages(){const f=id('stage-filter').value,items=d.attempt_stages.filter(s=>f==='all'||s.status===f);id('stage-table').querySelector('tbody').replaceChildren();items.forEach(s=>{const tr=row(id('stage-table'),[s.number+' of 21',s.stage_name,s.status,fmt(s.completed)+' / '+(s.total==null?'Unobserved':fmt(s.total)),s.unit]);tr.children[2].className='status-'+s.status.toLowerCase().replaceAll(' ','-')});text(id('stage-count'),items.length+' of 21 stages displayed')};id('stage-filter').addEventListener('change',stages);stages();
d.remaining_work.forEach(r=>row(id('remaining-work'),[r.branch,r.status,r.reason]));d.limits.forEach(v=>{const li=document.createElement('li');text(li,v);id('limits').append(li)});text(id('evidence-time'),'Evidence observed at '+d.evidence_as_of_utc+'. Download preserves the embedded source bytes without reserializing numbers.');
id('download').addEventListener('click',()=>{const u=URL.createObjectURL(new Blob([raw],{type:'application/json'})),a=document.createElement('a');a.href=u;a.download='fbs-v101-public-recovery-review.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)});id('report').hidden=false;document.documentElement.dataset.reportReady='true'}
start().catch(()=>{id('report').hidden=true;id('error').hidden=false;document.documentElement.dataset.reportReady='error'});
</script></body></html>
